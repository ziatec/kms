diff --git a/shared/components/PersianCalendar.tsx b/shared/components/PersianCalendar.tsx
new file mode 100644
index 0000000..0999010
--- /dev/null
+++ b/shared/components/PersianCalendar.tsx
@@ -0,0 +1,240 @@
+import { differenceInCalendarDays, isSameDay } from "date-fns";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import {
+  fromPersianDate,
+  getDateTimeFormat,
+  isPersianLanguage,
+  toPersianDate,
+  toPersianDigits,
+} from "../utils/calendar";
+import { isRTLLanguage } from "../utils/rtl";
+
+export type PersianCalendarProps = {
+  /** The selected day, if any. */
+  selected?: Date;
+  /** The day whose month is shown first, defaults to the selected day. */
+  defaultMonth?: Date;
+  /** Called with the day the user picked. */
+  onSelect?: (date: Date) => void;
+  /** Days that cannot be picked: `{ before }`, `{ after }`, a Date or a list. */
+  disabled?: unknown;
+  /** A date-fns locale, used for its language code. */
+  locale?: { code?: string };
+};
+
+type View = { year: number; month: number };
+
+/**
+ * Returns true if a day matches a disabled matcher.
+ *
+ * @param date the day.
+ * @param matcher `{ before }`, `{ after }`, a Date, or a list of those.
+ * @returns true if the day is disabled.
+ */
+function isDisabled(date: Date, matcher: unknown): boolean {
+  if (Array.isArray(matcher)) {
+    return matcher.some((item) => isDisabled(date, item));
+  }
+  if (matcher instanceof Date) {
+    return isSameDay(date, matcher);
+  }
+  if (matcher && typeof matcher === "object") {
+    const { before, after } = matcher as { before?: Date; after?: Date };
+    if (before instanceof Date && differenceInCalendarDays(date, before) < 0) {
+      return true;
+    }
+    if (after instanceof Date && differenceInCalendarDays(date, after) > 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Moves a Persian month forwards or backwards.
+ *
+ * @param view the current year and month.
+ * @param delta the number of months to move, negative for earlier.
+ * @returns the new year and month.
+ */
+function shiftMonth(view: View, delta: number): View {
+  const index = view.year * 12 + (view.month - 1) + delta;
+  return { year: Math.floor(index / 12), month: (index % 12) + 1 };
+}
+
+/**
+ * A month calendar for the Persian (Solar Hijri) calendar, with the week
+ * starting on Saturday. It uses the same markup and class names as
+ * react-day-picker, so it is styled by `Calendar`, which renders it instead
+ * of the Gregorian picker when the user's calendar is Persian.
+ *
+ * @returns the rendered calendar.
+ */
+export function PersianCalendar({
+  selected,
+  defaultMonth,
+  onSelect,
+  disabled,
+  locale,
+}: PersianCalendarProps) {
+  const { t } = useTranslation();
+  const code = locale?.code ?? "en-US";
+  const isPersian = isPersianLanguage(code);
+  const rtl = isRTLLanguage(code);
+  const intlLocale = `${code}-u-ca-persian`;
+
+  const [view, setView] = React.useState<View>(() => {
+    const { year, month } = toPersianDate(
+      defaultMonth ?? selected ?? new Date()
+    );
+    return { year, month };
+  });
+
+  const first = fromPersianDate(view.year, view.month, 1);
+  // The caption is built from parts, month first, rather than with Intl's
+  // month and year pattern, which can put the year first.
+  const digits = (value: number) =>
+    isPersian ? toPersianDigits(String(value)) : String(value);
+  const monthFormat = getDateTimeFormat(intlLocale, { month: "long" });
+  const caption = `${monthFormat.format(first)} ${digits(view.year)}`;
+
+  const weekdayFormat = getDateTimeFormat(code, {
+    weekday: isPersian ? "narrow" : "short",
+  });
+  // 6 January 2024 was a Saturday, and the Persian week starts on Saturday.
+  const weekdays = Array.from({ length: 7 }, (_, i) =>
+    weekdayFormat.format(new Date(2024, 0, 6 + i, 12))
+  );
+
+  const weekdayLongFormat = getDateTimeFormat(code, {
+    weekday: "long",
+  });
+  const offset = (first.getDay() + 1) % 7;
+  const today = new Date();
+  const days = Array.from(
+    { length: 42 },
+    (_, i) =>
+      new Date(
+        first.getFullYear(),
+        first.getMonth(),
+        first.getDate() - offset + i,
+        12
+      )
+  );
+  const weeks = Array.from({ length: 6 }, (_, i) =>
+    days.slice(i * 7, i * 7 + 7)
+  );
+
+  const go = (delta: number) =>
+    setView((current) => shiftMonth(current, delta));
+
+  return (
+    <div className="rdp">
+      <div className="rdp-month">
+        {/* The month is centered between the buttons, laid out right to left
+            as the Persian calendar is: previous on the right, next on the
+            left, each pointing outwards. */}
+        <div className="rdp-caption rdp-caption_centered" dir="rtl">
+          <button
+            type="button"
+            className="rdp-nav_button"
+            aria-label={t("Previous")}
+            onClick={() => go(-1)}
+          >
+            <Chevron flip />
+          </button>
+          <div
+            className="rdp-caption_label"
+            dir={rtl ? "rtl" : "ltr"}
+            aria-live="polite"
+          >
+            {caption}
+          </div>
+          <button
+            type="button"
+            className="rdp-nav_button"
+            aria-label={t("Next")}
+            onClick={() => go(1)}
+          >
+            <Chevron flip={false} />
+          </button>
+        </div>
+        <table className="rdp-table" role="grid" aria-label={caption}>
+          <thead className="rdp-head">
+            <tr className="rdp-head_row">
+              {weekdays.map((label, i) => (
+                <th key={i} className="rdp-head_cell" scope="col">
+                  {label}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody className="rdp-tbody">
+            {weeks.map((week) => (
+              <tr key={week[0].getTime()} className="rdp-row">
+                {week.map((day) => {
+                  const parts = toPersianDate(day);
+                  const outside = parts.month !== view.month;
+                  const isSelected = !!selected && isSameDay(day, selected);
+                  const classNames = ["rdp-day"];
+                  if (isSelected) {
+                    classNames.push("rdp-day_selected");
+                  }
+                  if (isSameDay(day, today)) {
+                    classNames.push("rdp-day_today");
+                  }
+                  if (outside) {
+                    classNames.push("rdp-day_outside");
+                  }
+                  return (
+                    <td
+                      key={day.getTime()}
+                      className="rdp-cell"
+                      role="gridcell"
+                    >
+                      <button
+                        type="button"
+                        className={classNames.join(" ")}
+                        aria-label={`${weekdayLongFormat.format(day)} ${digits(parts.day)} ${monthFormat.format(day)} ${digits(parts.year)}`}
+                        aria-pressed={isSelected}
+                        disabled={isDisabled(day, disabled)}
+                        onClick={() => {
+                          if (outside) {
+                            setView({ year: parts.year, month: parts.month });
+                          }
+                          onSelect?.(day);
+                        }}
+                      >
+                        {digits(parts.day)}
+                      </button>
+                    </td>
+                  );
+                })}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
+
+/** A chevron pointing left, or right when flipped. */
+export function Chevron({ flip }: { flip: boolean }) {
+  return (
+    <svg
+      className="rdp-nav_icon"
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden="true"
+      style={flip ? { transform: "scaleX(-1)" } : undefined}
+    >
+      <path d="M15 18l-6-6 6-6" />
+    </svg>
+  );
+}
