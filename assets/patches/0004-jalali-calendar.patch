+++ b/app/hooks/useUserCalendar.ts
@@ -0,0 +1,17 @@
+import { UserPreference } from "@shared/types";
+import { resolveCalendar } from "@shared/utils/calendar";
+import useCurrentUser from "./useCurrentUser";
+
+/**
+ * Returns the calendar used to display dates for the current user: their
+ * preference, or the Persian calendar when the interface language is Persian.
+ *
+ * @returns the calendar.
+ */
+export default function useUserCalendar() {
+  const user = useCurrentUser({ rejectOnEmpty: false });
+  return resolveCalendar(
+    user?.preferences?.[UserPreference.Calendar],
+    user?.language
+  );
+}
