diff --git a/shared/utils/calendar.test.ts b/shared/utils/calendar.test.ts
new file mode 100644
index 0000000..f01078e
--- /dev/null
+++ b/shared/utils/calendar.test.ts
@@ -0,0 +1,133 @@
+import { CalendarType, DateFormatType } from "../types";
+import {
+  fromPersianDate,
+  isSameCalendarYear,
+  resolveCalendar,
+  resolveDateFormat,
+  toPersianDate,
+  toPersianDigits,
+  toPersianPattern,
+} from "./calendar";
+
+// 1 October 2026 is 9 Mehr 1405.
+const date = new Date(2026, 9, 1, 15, 30);
+
+describe("toPersianDate", () => {
+  it("converts Gregorian dates", () => {
+    expect(toPersianDate(date)).toEqual({ year: 1405, month: 7, day: 9 });
+    // Nowruz 1405 is 21 March 2026.
+    expect(toPersianDate(new Date(2026, 2, 21))).toEqual({
+      year: 1405,
+      month: 1,
+      day: 1,
+    });
+  });
+});
+
+describe("toPersianPattern", () => {
+  it("replaces year, month and day tokens", () => {
+    expect(toPersianPattern(date, "yyyy-MM-dd")).toBe("1405-07-09");
+    expect(toPersianPattern(date, "MMMM do, yyyy", "en-US")).toBe(
+      "'Mehr' '9th', 1405"
+    );
+    expect(toPersianPattern(date, "d MMMM yyyy", "fa-IR")).toBe("9 مهر 1405");
+  });
+
+  it("keeps quoted literals and time tokens", () => {
+    expect(toPersianPattern(date, "d MMMM yyyy 'um' H:mm")).toBe(
+      "9 'Mehr' 1405 'um' H:mm"
+    );
+    expect(toPersianPattern(date, "'Le 'd MMMM")).toBe("'Le '9 'Mehr'");
+    expect(toPersianPattern(date, "iiii p")).toBe("iiii p");
+    // A literal after a quoted section is merged, not doubled.
+    expect(toPersianPattern(date, "'at 'MMM")).toBe("'at Mehr'");
+  });
+});
+
+describe("isSameCalendarYear", () => {
+  it("compares years in the given calendar", () => {
+    // Both 2026, but 1404 and 1405 in the Persian calendar.
+    const a = new Date(2026, 0, 10);
+    const b = new Date(2026, 5, 10);
+    expect(isSameCalendarYear(a, b, CalendarType.Gregorian)).toBe(true);
+    expect(isSameCalendarYear(a, b, CalendarType.Persian)).toBe(false);
+  });
+});
+
+describe("resolveCalendar", () => {
+  it("uses the preference, else Persian for the Persian language", () => {
+    expect(resolveCalendar("gregorian", "fa_IR")).toBe(CalendarType.Gregorian);
+    expect(resolveCalendar(undefined, "fa_IR")).toBe(CalendarType.Persian);
+    expect(resolveCalendar(false, "en_US")).toBe(CalendarType.Gregorian);
+  });
+});
+
+describe("toPersianDigits", () => {
+  it("converts digits", () => {
+    expect(toPersianDigits("1405/07/09")).toBe("۱۴۰۵/۰۷/۰۹");
+  });
+});
+
+describe("fromPersianDate", () => {
+  it("converts Persian dates to Gregorian dates at noon", () => {
+    // 1 Mehr 1405 is 23 September 2026.
+    const result = fromPersianDate(1405, 7, 1);
+    expect([result.getFullYear(), result.getMonth(), result.getDate()]).toEqual(
+      [2026, 8, 23]
+    );
+    expect(result.getHours()).toBe(12);
+  });
+
+  it("is the inverse of toPersianDate", () => {
+    for (let i = 0; i < 800; i++) {
+      const day = new Date(2024, 0, 1 + i, 12);
+      const { year, month, day: dayOfMonth } = toPersianDate(day);
+      const result = fromPersianDate(year, month, dayOfMonth);
+      expect(result.toDateString()).toBe(day.toDateString());
+    }
+  });
+});
+
+describe("date formats", () => {
+  it("puts the day before the month in Persian", () => {
+    expect(
+      toPersianPattern(date, "MMMM do, yyyy", "fa-IR", DateFormatType.Text)
+    ).toBe("9 مهر 1405");
+    expect(
+      toPersianPattern(date, "MMMM do", "fa-IR", DateFormatType.Text)
+    ).toBe("9 مهر");
+    expect(
+      toPersianPattern(
+        date,
+        "MMMM do, yyyy h:mm a",
+        "fa-IR",
+        DateFormatType.Text
+      )
+    ).toBe("9 مهر 1405 h:mm a");
+  });
+
+  it("writes numeric dates in any language", () => {
+    expect(
+      toPersianPattern(date, "MMMM do, yyyy", "fa-IR", DateFormatType.Numeric)
+    ).toBe("1405/07/09");
+    expect(
+      toPersianPattern(date, "MMM dd, yyyy", "en-US", DateFormatType.Numeric)
+    ).toBe("1405/07/09");
+    expect(
+      toPersianPattern(date, "MMMM do", "fa-IR", DateFormatType.Numeric)
+    ).toBe("1405/07/09");
+  });
+
+  it("keeps the English order for other languages", () => {
+    expect(
+      toPersianPattern(date, "MMMM do, yyyy", "en-US", DateFormatType.Text)
+    ).toBe("'Mehr' '9th', 1405");
+  });
+
+  it("resolves the preference", () => {
+    expect(resolveDateFormat(DateFormatType.Numeric)).toBe(
+      DateFormatType.Numeric
+    );
+    expect(resolveDateFormat(undefined)).toBe(DateFormatType.Text);
+  });
+});
diff --git a/shared/utils/calendar.ts b/shared/utils/calendar.ts
new file mode 100644
index 0000000..b914158
--- /dev/null
+++ b/shared/utils/calendar.ts
@@ -0,0 +1,412 @@
+import { CalendarType, DateFormatType } from "../types";
+
+/**
+ * Support for displaying dates in a calendar other than the Gregorian one,
+ * currently the Solar Hijri (Jalali, "persian") calendar. Conversion relies on
+ * the Intl API, so no additional dependency is needed.
+ */
+
+const formatters = new Map<string, Intl.DateTimeFormat>();
+let currentCalendar: CalendarType = CalendarType.Gregorian;
+let currentDateFormat: DateFormatType = DateFormatType.Text;
+
+/**
+ * Sets how dates are written in the Persian calendar in this client.
+ *
+ * @param dateFormat the date format.
+ */
+export function setDateFormat(dateFormat: DateFormatType): void {
+  currentDateFormat = dateFormat;
+}
+
+/**
+ * Returns how dates are written in the Persian calendar in this client.
+ *
+ * @returns the date format.
+ */
+export function getDateFormat(): DateFormatType {
+  return currentDateFormat;
+}
+
+/**
+ * Returns the date format to use for a user: their preference, or month names
+ * by default.
+ *
+ * @param preference the stored preference, if any.
+ * @returns the date format.
+ */
+export function resolveDateFormat(preference: unknown): DateFormatType {
+  return preference === DateFormatType.Numeric
+    ? DateFormatType.Numeric
+    : DateFormatType.Text;
+}
+
+/**
+ * Sets the calendar used to display dates in this client.
+ *
+ * @param calendar the calendar.
+ */
+export function setCalendar(calendar: CalendarType): void {
+  currentCalendar = calendar;
+}
+
+/**
+ * Returns the calendar used to display dates in this client.
+ *
+ * @returns the calendar.
+ */
+export function getCalendar(): CalendarType {
+  return currentCalendar;
+}
+
+/**
+ * Returns the calendar in the form the platform's Intl formatters expect for
+ * their `calendar` option ("gregory", not "gregorian", which is not a valid
+ * calendar identifier and makes Intl throw a RangeError).
+ *
+ * @returns the Intl calendar identifier.
+ */
+export function getIntlCalendar(): string {
+  return currentCalendar === CalendarType.Persian ? "persian" : "gregory";
+}
+
+/**
+ * Returns true if a language or locale code is Persian.
+ *
+ * @param code a language or locale code, e.g. "fa_IR" or "fa-IR".
+ * @returns true for Persian.
+ */
+export function isPersianLanguage(code: string | null | undefined): boolean {
+  return !!code && code.toLowerCase().startsWith("fa");
+}
+
+/**
+ * Returns an Intl date formatter, reused for the same locale and options,
+ * since creating one is slow and dates are formatted often.
+ *
+ * @param locale the BCP 47 locale, e.g. "fa-IR-u-ca-persian".
+ * @param options the format options.
+ * @returns the formatter.
+ */
+export function getDateTimeFormat(
+  locale: string,
+  options: Intl.DateTimeFormatOptions
+): Intl.DateTimeFormat {
+  const key = `${locale}|${JSON.stringify(options)}`;
+  let formatter = formatters.get(key);
+  if (!formatter) {
+    formatter = new Intl.DateTimeFormat(locale, options);
+    formatters.set(key, formatter);
+  }
+  return formatter;
+}
+
+/**
+ * Returns the calendar to use for a user: their preference, or the Persian
+ * calendar by default when the interface language is Persian.
+ *
+ * @param preference the stored preference, if any.
+ * @param language the user's language, e.g. "fa_IR".
+ * @returns the calendar.
+ */
+export function resolveCalendar(
+  preference: unknown,
+  language: string | null | undefined
+): CalendarType {
+  if (preference === CalendarType.Persian) {
+    return CalendarType.Persian;
+  }
+  if (preference === CalendarType.Gregorian) {
+    return CalendarType.Gregorian;
+  }
+  return isPersianLanguage(language)
+    ? CalendarType.Persian
+    : CalendarType.Gregorian;
+}
+
+/** The year, month (1-12) and day of a date in a calendar. */
+export interface CalendarDate {
+  year: number;
+  month: number;
+  day: number;
+}
+
+/**
+ * Returns the year, month and day of a date in the Persian calendar.
+ *
+ * @param date the date.
+ * @returns the Persian calendar date.
+ */
+export function toPersianDate(date: Date): CalendarDate {
+  const parts = getDateTimeFormat("en-u-ca-persian-nu-latn", {
+    year: "numeric",
+    month: "numeric",
+    day: "numeric",
+  }).formatToParts(date);
+  const get = (type: string) =>
+    parseInt(parts.find((part) => part.type === type)?.value ?? "0", 10);
+  return { year: get("year"), month: get("month"), day: get("day") };
+}
+
+/**
+ * Returns the date, at noon in local time, of a day in the Persian calendar.
+ * It is the inverse of `toPersianDate` and relies on the same Intl data, so
+ * both always agree. The day must exist in that month: the 30th of Esfand
+ * only exists in leap years.
+ *
+ * @param year the Persian year, e.g. 1405.
+ * @param month the Persian month, 1 (Farvardin) to 12 (Esfand).
+ * @param day the day of the month.
+ * @returns the date.
+ */
+export function fromPersianDate(
+  year: number,
+  month: number,
+  day: number
+): Date {
+  // Nowruz (1 Farvardin) falls between 19 and 22 March, so this estimate is
+  // at most a few days away from the right date.
+  const dayOfYear =
+    month <= 6 ? (month - 1) * 31 + day - 1 : 186 + (month - 7) * 30 + day - 1;
+  const date = new Date(year + 621, 2, 21 + dayOfYear, 12);
+  const target = year * 10000 + month * 100 + day;
+  const keyOf = (value: Date) => {
+    const parts = toPersianDate(value);
+    return parts.year * 10000 + parts.month * 100 + parts.day;
+  };
+
+  for (let i = 0; i < 10; i++) {
+    const current = keyOf(date);
+    if (current === target) {
+      break;
+    }
+    date.setDate(date.getDate() + (current < target ? 1 : -1));
+  }
+  return date;
+}
+
+/**
+ * Returns true if two dates are in the same year of the given calendar.
+ *
+ * @param a the first date.
+ * @param b the second date.
+ * @param calendar the calendar, defaults to the current one.
+ * @returns true if both dates are in the same year.
+ */
+export function isSameCalendarYear(
+  a: Date | number,
+  b: Date | number,
+  calendar: CalendarType = currentCalendar
+): boolean {
+  if (calendar === CalendarType.Persian) {
+    return toPersianDate(new Date(a)).year === toPersianDate(new Date(b)).year;
+  }
+  return new Date(a).getFullYear() === new Date(b).getFullYear();
+}
+
+const persianDigits = "۰۱۲۳۴۵۶۷۸۹";
+
+/**
+ * Replaces ASCII digits with Persian digits.
+ *
+ * @param text the text.
+ * @returns the text with Persian digits.
+ */
+export function toPersianDigits(text: string): string {
+  return text.replace(/[0-9]/g, (digit) => persianDigits[Number(digit)]);
+}
+
+/**
+ * Returns an English ordinal for a number, e.g. 1st, 22nd.
+ *
+ * @param value the number.
+ * @returns the ordinal.
+ */
+function englishOrdinal(value: number): string {
+  const rem100 = value % 100;
+  if (rem100 >= 11 && rem100 <= 13) {
+    return `${value}th`;
+  }
+  const suffix = ["th", "st", "nd", "rd"][value % 10] ?? "th";
+  return `${value}${value % 10 > 3 ? "th" : suffix}`;
+}
+
+const dateStyles: Record<number, "short" | "medium" | "long" | "full"> = {
+  1: "short",
+  2: "medium",
+  3: "long",
+  4: "full",
+};
+
+// A month name followed by the day and, optionally, the year, in the English
+// order of the patterns used by the app, e.g. "MMMM do, yyyy" or "MMM dd".
+const monthDayYear = /\b(MMMM|MMM) (do|dd|d)\b(?:, (yyyy|y)\b)?/;
+
+/**
+ * Rewrites the date part of a date-fns pattern for the chosen date format.
+ * With numeric dates it becomes "yyyy/MM/dd", in every language. With month
+ * names it is put in day, month, year order for Persian, e.g. "d MMMM yyyy",
+ * and left as it is for other languages.
+ *
+ * @param pattern the date-fns pattern.
+ * @param dateFormat the chosen date format.
+ * @param isPersianLanguage whether the language is Persian.
+ * @returns the rewritten pattern.
+ */
+function arrangeDatePattern(
+  pattern: string,
+  dateFormat: DateFormatType,
+  isPersianLanguage: boolean
+): string {
+  if (dateFormat === DateFormatType.Numeric) {
+    return pattern.replace(monthDayYear, "yyyy/MM/dd");
+  }
+  if (isPersianLanguage) {
+    return pattern.replace(
+      monthDayYear,
+      (_match, month: string, day: string, year?: string) =>
+        year ? `${day} ${month} ${year}` : `${day} ${month}`
+    );
+  }
+  return pattern;
+}
+
+/**
+ * Rewrites a date-fns format pattern so that the year, month and day are
+ * those of the Persian calendar. Those tokens are replaced with quoted
+ * literals; every other token (weekday, time, …) is left for date-fns, as it
+ * does not depend on the calendar.
+ *
+ * Supported tokens: y, yy, yyyy, M, MM, MMM, MMMM, MMMMM, L…, d, dd, do, Mo,
+ * and the localized dates P, PP, PPP, PPPP.
+ *
+ * @param date the date that will be formatted.
+ * @param pattern the date-fns pattern.
+ * @param localeCode a BCP 47 locale for month names, e.g. "fa-IR".
+ * @param dateFormat how the date is written, defaults to the current one.
+ * @returns the rewritten pattern.
+ */
+export function toPersianPattern(
+  date: Date,
+  pattern: string,
+  localeCode = "en-US",
