@@ -0,0 +1,367 @@
+/**
+ * KMS license formats and cryptography (node:crypto only).
+ *
+ * - A license (activation code) is a JSON payload signed with the vendor's
+ *   Ed25519 key and then encrypted to this server's X25519 key, so only this
+ *   server can read it: "-----BEGIN KMS ACTIVATION-----".
+ * - A renewal request is a JSON payload signed with this server's Ed25519 key
+ *   and encrypted to the vendor's X25519 key: "-----BEGIN KMS LICENSE REQUEST-----".
+ * Both use ECDH (X25519) + HKDF-SHA256 + AES-256-GCM. The vendor tool
+ * (kms-license.mjs) uses the same constants.
+ *
+ * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ */
+import {
+  createCipheriv,
+  createDecipheriv,
+  createHash,
+  createPrivateKey,
+  createPublicKey,
+  diffieHellman,
+  generateKeyPairSync,
+  hkdfSync,
+  randomBytes,
+  sign,
+  verify,
+  type KeyObject,
+} from "node:crypto";
+
+export const LICENSE_TYPE = "kms-license";
+export const REQUEST_TYPE = "kms-license-request";
+export const PRODUCT = "kms-outline";
+export const LICENSE_ARMOR = "KMS ACTIVATION";
+export const REQUEST_ARMOR = "KMS LICENSE REQUEST";
+const REQUEST_HKDF_INFO = "kms-license-request-v1";
+const LICENSE_HKDF_INFO = "kms-license-v2";
+
+/** Hashes of the hardware identifiers; raw values never leave the server. */
+export type HardwareComponents = Record<string, string>;
+
+export type LicensePayload = {
+  type: typeof LICENSE_TYPE;
+  v: 1;
+  product: string;
+  serial: string;
+  customer: string;
+  installId: string;
+  /** sha256 (hex) of the server's public key (SPKI DER). */
+  serverKey: string;
+  hw: HardwareComponents;
+  issuedAt: string;
+  notBefore: string;
+  expiresAt: string;
+  warnDays?: number;
+  note?: string;
+};
+
+export type RequestPayload = {
+  type: typeof REQUEST_TYPE;
+  v: 1;
+  product: string;
+  createdAt: string;
+  installId: string;
+  serverKey: string;
+  serverPublicKey: string;
+  /** This server's X25519 public key (base64url, raw); licenses are encrypted to it. */
+  serverBoxKey: string;
+  hw: HardwareComponents;
+  organization?: string;
+  admin?: { name?: string; email?: string };
+  current?: {
+    serial: string;
+    customer: string;
+    expiresAt: string;
+  } | null;
+  appVersion?: string;
+};
+
+export type VendorPublicKeys = {
+  v: 1;
+  product: string;
+  sign: JsonWebKey;
+  box: JsonWebKey;
+};
+
+export const b64u = (buf: Buffer) => buf.toString("base64url");
+export const fromB64u = (text: string) => Buffer.from(text, "base64url");
+
+/**
+ * Wrap text in an armor block, 64 characters per line.
+ *
+ * @param label The armor label.
+ * @param body The body text.
+ * @returns The armored text.
+ */
+export function armor(label: string, body: string) {
+  const lines = body.match(/.{1,64}/g) ?? [];
+  return `-----BEGIN ${label}-----\n${lines.join("\n")}\n-----END ${label}-----\n`;
+}
+
+/**
+ * Extract the body of an armor block (whitespace removed).
+ *
+ * @param label The armor label.
+ * @param text The armored text.
+ * @returns The body, or undefined when the block is missing.
+ */
+export function unarmor(label: string, text: string) {
+  const re = new RegExp(
+    `-----BEGIN ${label}-----([\\s\\S]*?)-----END ${label}-----`
+  );
+  const match = re.exec(text);
+  return match ? match[1].replace(/\s+/g, "") : undefined;
+}
+
+/**
+ * sha256 (hex) of a public key in SPKI DER form.
+ *
+ * @param key The public key.
+ * @returns The fingerprint.
+ */
+export function keyFingerprint(key: KeyObject) {
+  return createHash("sha256")
+    .update(key.export({ type: "spki", format: "der" }))
+    .digest("hex");
+}
+
+/**
+ * Load the vendor's public keys.
+ *
+ * @param json The parsed vendor-public.json.
+ * @returns The signing (Ed25519) and box (X25519) public keys.
+ */
+export function loadVendorKeys(json: VendorPublicKeys) {
+  if (!json?.sign?.x || !json?.box?.x) {
+    throw new Error("vendor public key file is incomplete");
+  }
+  return {
+    sign: createPublicKey({
+      key: { kty: "OKP", crv: "Ed25519", x: json.sign.x },
+      format: "jwk",
+    }),
+    box: createPublicKey({
+      key: { kty: "OKP", crv: "X25519", x: json.box.x },
+      format: "jwk",
+    }),
+  };
+}
+
+/**
+ * The raw (32 byte) form of an X25519 public key.
+ *
+ * @param key The public key.
+ * @returns The raw key.
+ */
+export const rawX25519 = (key: KeyObject) =>
+  fromB64u(key.export({ format: "jwk" }).x as string);
+
+/**
+ * An X25519 public key from its raw base64url form.
+ *
+ * @param x The raw key, base64url.
+ * @returns The public key.
+ */
+export const x25519FromRaw = (x: string) =>
+  createPublicKey({ key: { kty: "OKP", crv: "X25519", x }, format: "jwk" });
+
+/**
+ * Encrypt to an X25519 public key (ephemeral ECDH, HKDF-SHA256, AES-256-GCM).
+ *
+ * @param plain The plaintext.
+ * @param recipient The recipient's X25519 public key.
+ * @param info The HKDF info string (separates the two uses).
+ * @returns The base64url envelope.
+ */
+export function boxSeal(plain: Buffer, recipient: KeyObject, info: string) {
+  const eph = generateKeyPairSync("x25519");
+  const epk = rawX25519(eph.publicKey);
+  const rpk = rawX25519(recipient);
+  const shared = diffieHellman({ privateKey: eph.privateKey, publicKey: recipient });
+  const key = Buffer.from(
+    hkdfSync("sha256", shared, Buffer.concat([epk, rpk]), info, 32)
+  );
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", key, iv);
+  const ct = Buffer.concat([cipher.update(plain), cipher.final(), cipher.getAuthTag()]);
+  return b64u(
+    Buffer.from(
+      JSON.stringify({
+        v: 1,
+        alg: "X25519-HKDF-SHA256-A256GCM",
+        epk: b64u(epk),
+        iv: b64u(iv),
+        ct: b64u(ct),
+      }),
+      "utf8"
+    )
+  );
+}
+
+/**
+ * Decrypt a boxSeal envelope.
+ *
+ * @param body The base64url envelope.
+ * @param recipientPrivate The recipient's X25519 private key.
+ * @param info The HKDF info string.
+ * @returns The plaintext.
+ * @throws When the envelope was made for another key or was changed.
+ */
+export function boxOpen(body: string, recipientPrivate: KeyObject, info: string) {
+  const env = JSON.parse(fromB64u(body).toString("utf8"));
+  if (env.v !== 1 || env.alg !== "X25519-HKDF-SHA256-A256GCM") {
+    throw new Error("unsupported envelope");
+  }
+  const epk = fromB64u(env.epk);
+  const rpk = rawX25519(createPublicKey(recipientPrivate));
+  const shared = diffieHellman({
+    privateKey: recipientPrivate,
+    publicKey: x25519FromRaw(env.epk),
+  });
+  const key = Buffer.from(
+    hkdfSync("sha256", shared, Buffer.concat([epk, rpk]), info, 32)
+  );
+  const ct = fromB64u(env.ct);
+  try {
+    const decipher = createDecipheriv("aes-256-gcm", key, fromB64u(env.iv));
+    decipher.setAuthTag(ct.subarray(ct.length - 16));
+    return Buffer.concat([
+      decipher.update(ct.subarray(0, ct.length - 16)),
+      decipher.final(),
+    ]);
+  } catch {
+    throw new Error("it was made for another server, or it was changed");
+  }
+}
+
+/**
+ * Sign a license with the vendor key and encrypt it for one server (used by
+ * tests; the vendor tool has its own copy).
+ *
+ * @param payload The license payload.
+ * @param vendorSignPrivate The vendor's Ed25519 private key.
+ * @param serverBox The server's X25519 public key.
+ * @returns The armored activation code.
+ */
+export function sealLicense(
+  payload: LicensePayload,
+  vendorSignPrivate: KeyObject,
+  serverBox: KeyObject
+) {
+  const bytes = Buffer.from(JSON.stringify(payload), "utf8");
+  const plain = Buffer.from(
+    JSON.stringify({ p: b64u(bytes), s: b64u(sign(null, bytes, vendorSignPrivate)) }),
+    "utf8"
+  );
+  return armor(LICENSE_ARMOR, boxSeal(plain, serverBox, LICENSE_HKDF_INFO));
+}
+
+/**
+ * Decrypt a license with this server's key and verify the vendor signature.
+ *
+ * @param text The armored activation code.
+ * @param serverBoxPrivate This server's X25519 private key.
+ * @param vendorSign The vendor's Ed25519 public key.
+ * @returns The verified payload.
+ * @throws When the code is not for this server, was changed, or is not signed by the vendor.
+ */
+export function openLicense(
+  text: string,
+  serverBoxPrivate: KeyObject,
+  vendorSign: KeyObject
+) {
+  const body = unarmor(LICENSE_ARMOR, text);
+  if (!body) {
+    throw new Error("not a KMS activation code");
+  }
+  let plain: Buffer;
+  try {
+    plain = boxOpen(body, serverBoxPrivate, LICENSE_HKDF_INFO);
+  } catch (err) {
+    throw new Error(`the activation code cannot be opened: ${(err as Error).message}`);
+  }
+  const { p, s } = JSON.parse(plain.toString("utf8"));
+  const bytes = fromB64u(p);
+  if (!verify(null, bytes, vendorSign, fromB64u(s))) {
+    throw new Error("the activation code is not signed by the vendor");
+  }
+  const payload = JSON.parse(bytes.toString("utf8")) as LicensePayload;
+  if (payload.type !== LICENSE_TYPE || payload.v !== 1) {
+    throw new Error("unsupported license version");
+  }
+  return payload;
+}
+
+/**
+ * Sign a request with the server key and encrypt it for the vendor.
+ *
+ * @param payload The request payload.
+ * @param serverPrivateKey The server's Ed25519 private key.
+ * @param vendorBox The vendor's X25519 public key.
+ * @returns The armored request text.
+ */
+export function sealRequest(
+  payload: RequestPayload,
+  serverPrivateKey: KeyObject,
+  vendorBox: KeyObject
+) {
+  const inner = Buffer.from(JSON.stringify(payload), "utf8");
+  const plain = Buffer.from(
+    JSON.stringify({
+      inner: b64u(inner),
+      sig: b64u(sign(null, inner, serverPrivateKey)),
+    }),
+    "utf8"
+  );
+  return armor(REQUEST_ARMOR, boxSeal(plain, vendorBox, REQUEST_HKDF_INFO));
+}
+
+/**
+ * Decrypt and verify a request (used by tests; the vendor tool has its own copy).
+ *
+ * @param text The armored request.
+ * @param vendorBoxPrivate The vendor's X25519 private key.
+ * @returns The verified request payload.
+ */
+export function openRequest(text: string, vendorBoxPrivate: KeyObject) {
+  const body = unarmor(REQUEST_ARMOR, text);
+  if (!body) {
+    throw new Error("not a KMS license request");
+  }
+  const plain = boxOpen(body, vendorBoxPrivate, REQUEST_HKDF_INFO);
+  const { inner, sig } = JSON.parse(plain.toString("utf8"));
+  const innerBytes = fromB64u(inner);
+  const payload = JSON.parse(innerBytes.toString("utf8")) as RequestPayload;
+  const serverPublic = createPublicKey(payload.serverPublicKey);
+  if (!verify(null, innerBytes, serverPublic, fromB64u(sig))) {
+    throw new Error("the request signature is not valid");
+  }
+  if (keyFingerprint(serverPublic) !== payload.serverKey) {
+    throw new Error("the request's server key does not match its fingerprint");
+  }
+  return payload;
+}
+
+/**
+ * Count matching hardware components.
+ *
+ * @param licensed Components named in the license.
+ * @param local Components of this server.
+ * @returns Matching and required counts.
+ */
+export function matchHardware(
+  licensed: HardwareComponents,
+  local: HardwareComponents
+) {
+  const names = Object.keys(licensed).filter((n) => !!licensed[n]);
+  const matching = names.filter((n) => local[n] === licensed[n]).length;
+  const required = Math.min(2, names.length);
+  return { matching, required, ok: names.length > 0 && matching >= required };
+}
+
+/**
+ * Load a PEM private key.
+ *
+ * @param pem The PEM text.
+ * @returns The key.
+ */
+export const privateKeyFromPem = (pem: string) => createPrivateKey(pem);
