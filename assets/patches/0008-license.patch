+/**
+ * The license notice after signing in (one OK button) and the small status
+ * pill shown while the license ends soon or the workspace is read-only.
+ *
+ * VERSION: 1.3 (2026-10-12) — KMS patch 0008; 1.3 = shorter trial text, signature card
+ */
+import type { TFunction } from "i18next";
+import { observer } from "mobx-react";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import { EmailIcon } from "outline-icons";
+import { Link } from "react-router-dom";
+import styled from "styled-components";
+import { depths, s } from "@shared/styles";
+import Button from "~/components/Button";
+import Flex from "~/components/Flex";
+import Text from "~/components/Text";
+import useCurrentUser from "~/hooks/useCurrentUser";
+import useStores from "~/hooks/useStores";
+import useUserCalendar from "~/hooks/useUserCalendar";
+import useUserDateFormat from "~/hooks/useUserDateFormat";
+import {
+  LICENSE_NOTICE_KEY,
+  fetchLicense,
+  formatLicenseDate,
+  formatLicenseNumber,
+  licenseState,
+  type LicenseInfo,
+} from "~/utils/license";
+import { settingsPath } from "~/utils/routeHelpers";
+
+/** How long an acknowledged notice stays quiet within one session. */
+const ACK_VALID_MS = 12 * 60 * 60 * 1000;
+
+/** Path of Settings → License. */
+export const licenseSettingsPath = () => settingsPath("license");
+
+/**
+ * The sentence describing the license state, or undefined when all is well.
+ *
+ * @param info The license information.
+ * @param t The translation function.
+ * @param date The formatted expiry date.
+ * @param days The formatted number of days left.
+ * @returns The message.
+ */
+export function licenseMessage(
+  info: LicenseInfo,
+  t: TFunction,
+  date: string,
+  days: string
+) {
+  switch (info.status) {
+    case "active":
+      return undefined;
+    case "warning":
+      return t(
+        "The license of this system ends in {{ days }} days, on {{ date }}.",
+        { days, date }
+      );
+    case "trial":
+      return t(
+        "This system has not been activated yet. You can use it for {{ days }} more days.",
+        { days }
+      );
+    case "trialEnded":
+      return t(
+        "The trial period ended on {{ date }}. The system is read-only until it is activated.",
+        { date }
+      );
+    case "expired":
+      return t(
+        "The license of this system ended on {{ date }}. The system is read-only until the license is renewed.",
+        { date }
+      );
+    case "missing":
+    case "unconfigured":
+      return t(
+        "This system has not been activated yet and is read-only until a license is applied."
+      );
+    case "clock":
+      return t(
+        "The system clock is earlier than expected, so the license cannot be checked. The system is read-only."
+      );
+    case "notYetValid":
+      return t("The license of this system is not valid yet. The system is read-only.");
+    default:
+      return t("The license of this system is not valid. The system is read-only.");
+  }
+}
+
+/** The supplier's thanks and contact, shown under every license message. */
+export function LicenseSignature() {
+  const { t } = useTranslation();
+  return (
+    <Signature>
+      <Thanks>{t("With many thanks")}</Thanks>
+      <SignatureName>{t("Seyed Mostafa Ziaei")}</SignatureName>
+      <div>
+        <Contact href="mailto:ziaei@mail.ir" dir="ltr">
+          <EmailIcon size={18} />
+          ziaei@mail.ir
+        </Contact>
+      </div>
+      <div>
+        <Contact href="tel:+989926969774" dir="ltr">
+          <PhoneGlyph />
+          +98 992 696 9774
+        </Contact>
+      </div>
+    </Signature>
+  );
+}
+
+function PhoneGlyph() {
+  return (
+    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
+      <path
+        fill="currentColor"
+        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
+      />
+    </svg>
+  );
+}
+
+function NoticeDialog({
+  message,
+  isAdmin,
+  onOk,
+}: {
+  message: string;
+  isAdmin: boolean;
+  onOk: () => void;
+}) {
+  const { t } = useTranslation();
+  return (
+    <Flex column gap={12}>
+      <Text as="p">{message}</Text>
+      <LicenseSignature />
+      {isAdmin && (
+        <Text as="p" type="secondary" size="small">
+          {t(
+            "To renew or activate it, open Settings → License, download the request file and send it to your supplier."
+          )}
+        </Text>
+      )}
+      <Flex justify="flex-end">
+        <Button onClick={onOk} autoFocus>
+          {t("OK")}
+        </Button>
+      </Flex>
+    </Flex>
+  );
+}
+
+function LicenseNotice() {
+  const { t } = useTranslation();
+  const { dialogs } = useStores();
+  const user = useCurrentUser();
+  const calendar = useUserCalendar();
+  const dateFormat = useUserDateFormat();
+  const info = licenseState.info;
+
+  React.useEffect(() => {
+    void fetchLicense();
+    // Once an hour, so the pill appears when the license ends during a session.
+    const timer = setInterval(() => void fetchLicense(), 60 * 60 * 1000);
+    return () => clearInterval(timer);
+  }, []);
+
+  const date = formatLicenseDate(info?.expiresAt, {
+    language: user.language,
+    calendar,
+    dateFormat,
+  });
+  const days = formatLicenseNumber(Math.max(0, info?.daysLeft ?? 0), user.language);
+  const message = info ? licenseMessage(info, t, date, days) : undefined;
+
+  // Shown once after signing in (the acknowledgement is removed on logout, and
+  // expires after 12 hours for sessions that end without one) and again when
+  // the status changes.
+  React.useEffect(() => {
+    if (!info || !message) {
+      return;
+    }
+    const ackValue = `${user.id}|${info.status}|${info.expiresAt ?? ""}`;
+    let acknowledged: { value?: string; at?: number } = {};
+    try {
+      acknowledged = JSON.parse(localStorage.getItem(LICENSE_NOTICE_KEY) || "{}");
+    } catch {
+      acknowledged = {};
+    }
+    if (
+      acknowledged.value === ackValue &&
+      Date.now() - (acknowledged.at ?? 0) < ACK_VALID_MS
+    ) {
+      return;
+    }
+    const ok = () => {
+      try {
+        localStorage.setItem(
+          LICENSE_NOTICE_KEY,
+          JSON.stringify({ value: ackValue, at: Date.now() })
+        );
+      } catch {
+        // storage unavailable: the notice shows again next time
+      }
+      dialogs.closeAllModals();
+    };
+    dialogs.openModal({
+      title: t("License"),
+      content: (
+        <NoticeDialog message={message} isAdmin={user.isAdmin} onOk={ok} />
+      ),
+      onClose: ok,
+    });
+  }, [info, message, user.id, user.isAdmin, dialogs, t]);
+
+  if (!info || info.status === "active") {
+    return null;
+  }
+
+  return (
+    <Pill
+      to={licenseSettingsPath()}
+      $danger={info.readOnly}
+      title={message}
+      aria-label={message}
+    >
+      {info.readOnly
+        ? t("Read-only · license")
+        : info.status === "trial"
+          ? t("Trial: {{ days }} days left", { days })
+          : t("License: {{ days }} days left", { days })}
+    </Pill>
+  );
+}
+
+const Pill = styled(Link)<{ $danger: boolean }>`
+  position: fixed;
+  bottom: 12px;
+  inset-inline-end: 16px;
+  z-index: ${depths.toc};
+  padding: 4px 12px;
+  border-radius: 14px;
+  font-size: 13px;
+  font-weight: 500;
+  color: ${(props) => (props.$danger ? props.theme.white : props.theme.text)};
+  background: ${(props) =>
+    props.$danger ? props.theme.danger : props.theme.warning};
+  box-shadow: ${s("menuShadow")};
+  text-decoration: none;
+
+  &:hover {
+    opacity: 0.9;
+  }
+
+  @media print {
+    display: none;
+  }
+`;
+
+const Signature = styled.div`
+  margin-top: 4px;
+  padding: 10px 14px;
+  border-radius: 8px;
+  border-inline-start: 3px solid ${s("accent")};
+  background: ${s("backgroundSecondary")};
+  font-size: 14px;
+  line-height: 1.7;
+`;
+
+const Thanks = styled.div`
+  color: ${s("textSecondary")};
+  font-size: 13px;
+`;
+
+const SignatureName = styled.div`
+  font-weight: 600;
+  margin-bottom: 2px;
+`;
+
+const Contact = styled.a`
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: ${s("textSecondary")};
+  text-decoration: none;
+
+  svg {
+    flex-shrink: 0;
+    color: ${s("accent")};
+    fill: currentColor;
+  }
+
+  &:hover {
+    color: ${s("accent")};
+  }
+`;
+
+export default observer(LicenseNotice);
