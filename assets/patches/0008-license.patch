+++ b/app/scenes/Settings/License.tsx
@@ -0,0 +1,258 @@
+/**
+ * Settings → License: the customer and the validity of the license for every
+ * user; for admins the renewal request download and applying a new license.
+ *
+ * VERSION: 1.2 (2026-10-12) — KMS patch 0008; 1.2 = signature under the message
+ */
+import { observer } from "mobx-react";
+import { DownloadIcon, ShieldIcon } from "outline-icons";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+import styled from "styled-components";
+import { s } from "@shared/styles";
+import Button from "~/components/Button";
+import Flex from "~/components/Flex";
+import Heading from "~/components/Heading";
+import Input from "~/components/Input";
+import Scene from "~/components/Scene";
+import Text from "~/components/Text";
+import { LicenseSignature, licenseMessage } from "~/components/LicenseNotice";
+import useCurrentUser from "~/hooks/useCurrentUser";
+import useStores from "~/hooks/useStores";
+import useUserCalendar from "~/hooks/useUserCalendar";
+import useUserDateFormat from "~/hooks/useUserDateFormat";
+import { client } from "~/utils/ApiClient";
+import { download } from "~/utils/download";
+import {
+  fetchLicense,
+  formatLicenseDate,
+  formatLicenseNumber,
+  licenseState,
+  licenseStatusLabel,
+  type LicenseInfo,
+} from "~/utils/license";
+import SettingRow from "./components/SettingRow";
+
+
+function AppliedDialog({ message, onOk }: { message: string; onOk: () => void }) {
+  const { t } = useTranslation();
+  return (
+    <Flex column gap={12}>
+      <Text as="p">{message}</Text>
+      <Flex justify="flex-end">
+        <Button onClick={onOk} autoFocus>
+          {t("OK")}
+        </Button>
+      </Flex>
+    </Flex>
+  );
+}
+
+function License() {
+  const { t } = useTranslation();
+  const { dialogs } = useStores();
+  const user = useCurrentUser();
+  const calendar = useUserCalendar();
+  const dateFormat = useUserDateFormat();
+  const info = licenseState.info;
+  const [text, setText] = React.useState("");
+  const [isApplying, setApplying] = React.useState(false);
+  const [isRequesting, setRequesting] = React.useState(false);
+  const fileRef = React.useRef<HTMLInputElement>(null);
+
+  React.useEffect(() => {
+    void fetchLicense();
+  }, []);
+
+  const fmtDate = (iso?: string) =>
+    formatLicenseDate(iso, { language: user.language, calendar, dateFormat });
+  const fmtNumber = (value: number) => formatLicenseNumber(value, user.language);
+
+  const handleRequest = React.useCallback(async () => {
+    setRequesting(true);
+    try {
+      const res = await client.post("/license.request");
+      download(res.data.text, res.data.fileName, "text/plain");
+      toast.success(t("Request file downloaded. Send it to your supplier."));
+    } catch (err) {
+      toast.error((err as Error).message);
+    } finally {
+      setRequesting(false);
+    }
+  }, [t]);
+
+  const handleFile = React.useCallback(
+    async (ev: React.ChangeEvent<HTMLInputElement>) => {
+      const file = ev.target.files?.[0];
+      if (file) {
+        setText(await file.text());
+      }
+      ev.target.value = "";
+    },
+    []
+  );
+
+  const handleApply = React.useCallback(async () => {
+    setApplying(true);
+    try {
+      const res = await client.post("/license.apply", { license: text.trim() });
+      const applied = res.data as LicenseInfo;
+      setText("");
+      const message = t("Your license is active until {{ date }}.", {
+        date: formatLicenseDate(applied.expiresAt, {
+          language: user.language,
+          calendar,
+          dateFormat,
+        }),
+      });
+      // Permissions change with the license, so the app is reloaded after OK.
+      const ok = () => {
+        dialogs.closeAllModals();
+        window.location.reload();
+      };
+      dialogs.openModal({
+        title: t("License"),
+        content: <AppliedDialog message={message} onOk={ok} />,
+        onClose: ok,
+      });
+    } catch (err) {
+      toast.error((err as Error).message);
+    } finally {
+      setApplying(false);
+    }
+  }, [text, t, dialogs, user.language, calendar, dateFormat]);
+
+  const message =
+    info &&
+    licenseMessage(
+      info,
+      t,
+      fmtDate(info.expiresAt),
+      fmtNumber(Math.max(0, info.daysLeft ?? 0))
+    );
+
+  return (
+    <Scene title={t("License")} icon={<ShieldIcon />}>
+      <Heading>{t("License")}</Heading>
+      {message && (
+        <Banner $danger={!!info?.readOnly}>
+          <Text as="p">{message}</Text>
+          <LicenseSignature />
+        </Banner>
+      )}
+
+      <SettingRow name="kms-license-customer" label={t("Customer")}>
+        <Text as="span" selectable>
+          {info?.customer ?? "—"}
+        </Text>
+      </SettingRow>
+      <SettingRow name="kms-license-status" label={t("Status")}>
+        <Text as="span" type={info?.readOnly ? "danger" : undefined}>
+          {info ? licenseStatusLabel(info.status, t) : "…"}
+          {info?.readOnly ? ` · ${t("Read-only")}` : ""}
+        </Text>
+      </SettingRow>
+      <SettingRow name="kms-license-serial" label={t("Serial number")}>
+        <Text as="span" selectable dir="ltr">
+          {info?.serial ?? "—"}
+        </Text>
+      </SettingRow>
+      <SettingRow name="kms-license-from" label={t("Valid from")}>
+        <Text as="span">{fmtDate(info?.notBefore)}</Text>
+      </SettingRow>
+      <SettingRow name="kms-license-until" label={t("Valid until")}>
+        <Text as="span">
+          {fmtDate(info?.expiresAt)}
+          {info?.daysLeft !== undefined && info.daysLeft > 0
+            ? ` (${t("{{ days }} days left", { days: fmtNumber(info.daysLeft) })})`
+            : ""}
+        </Text>
+      </SettingRow>
+
+      {user.isAdmin ? (
+        <>
+          <SettingRow
+            name="kms-license-install"
+            label={t("Installation ID")}
+            description={
+              info?.reason
+                ? `${t("Details")}: ${info.reason}`
+                : info?.hardware
+                  ? t("Hardware: {{ matching }} of {{ required }} identifiers match", {
+                      matching: fmtNumber(info.hardware.matching),
+                      required: fmtNumber(info.hardware.required),
+                    })
+                  : undefined
+            }
+          >
+            <Text as="span" selectable dir="ltr" size="small">
+              {info?.installId ?? "—"}
+            </Text>
+          </SettingRow>
+
+          <Heading as="h2">{t("Renew or activate")}</Heading>
+          <Text as="p" type="secondary">
+            {t(
+              "Download the request file and send it to your supplier. It is encrypted and contains this server's identity. You will receive an activation code to apply below."
+            )}
+          </Text>
+          <Button
+            icon={<DownloadIcon />}
+            onClick={handleRequest}
+            disabled={isRequesting}
+            neutral
+          >
+            {t("Download license request")}
+          </Button>
+
+          <Heading as="h2">{t("Apply license")}</Heading>
+          <Input
+            type="textarea"
+            label={t("Activation code")}
+            placeholder="-----BEGIN KMS ACTIVATION-----"
+            value={text}
+            onChange={(ev) => setText(ev.target.value)}
+            dir="ltr"
+            rows={6}
+            flex
+          />
+          <Flex gap={8}>
+            <Button
+              onClick={handleApply}
+              disabled={isApplying || !text.includes("KMS ACTIVATION")}
+            >
+              {isApplying ? `${t("Applying")}…` : t("Apply license")}
+            </Button>
+            <Button neutral onClick={() => fileRef.current?.click()}>
+              {t("Open activation file")}
+            </Button>
+            <input
+              ref={fileRef}
+              type="file"
+              accept=".kmslic,.txt,text/plain"
+              onChange={handleFile}
+              hidden
+            />
+          </Flex>
+        </>
+      ) : (
+        <Text as="p" type="secondary">
+          {t("Only an admin can renew the license.")}
+        </Text>
+      )}
+
+    </Scene>
+  );
+}
+
+const Banner = styled.div<{ $danger: boolean }>`
+  margin: 8px 0 16px;
+  padding: 8px 12px;
+  border-radius: 6px;
+  border-inline-start: 4px solid
+    ${(props) => (props.$danger ? props.theme.danger : props.theme.warning)};
+  background: ${s("backgroundSecondary")};
+`;
+
+export default observer(License);
