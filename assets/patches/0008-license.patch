+/**
+ * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ */
+import { z } from "zod";
+import { BaseSchema } from "@server/routes/api/schema";
+
+export const LicenseApplySchema = BaseSchema.extend({
+  body: z.object({
+    /** The armored activation code sent by the vendor. */
+    license: z.string().min(16).max(20000),
+  }),
+});
+
+export type LicenseApplyReq = z.infer<typeof LicenseApplySchema>;
