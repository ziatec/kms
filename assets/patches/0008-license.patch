+/**
+ * Client side of the KMS license: the current state (shared by the notice,
+ * the status pill and Settings → License) and display helpers.
+ *
+ * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ */
+import type { TFunction } from "i18next";
+import { observable, runInAction } from "mobx";
+import type { CalendarType, DateFormatType } from "@shared/types";
+import { dateLocale, formatDate, unicodeCLDRtoBCP47 } from "@shared/utils/date";
+import { client } from "~/utils/ApiClient";
+
+export type LicenseStatus =
+  | "active"
+  | "warning"
+  | "trial"
+  | "trialEnded"
+  | "expired"
+  | "notYetValid"
+  | "missing"
+  | "invalid"
+  | "clock"
+  | "unconfigured";
+
+export type LicenseInfo = {
+  status: LicenseStatus;
+  readOnly: boolean;
+  customer?: string;
+  serial?: string;
+  issuedAt?: string;
+  notBefore?: string;
+  expiresAt?: string;
+  daysLeft?: number;
+  warnDays: number;
+  trialDays: number;
+  installId?: string;
+  reason?: string;
+  hardware?: { matching: number; required: number };
+  /** Set once, when this request started the trial period. */
+  trialStarted?: boolean;
+};
+
+/** localStorage key of the acknowledged login notice; cleared on logout. */
+export const LICENSE_NOTICE_KEY = "kms.license.notice";
+
+export const licenseState = observable({
+  info: undefined as LicenseInfo | undefined,
+  loading: false,
+});
+
+/**
+ * Load (or reload) the license information.
+ *
+ * @returns The license information, or undefined when it cannot be loaded.
+ */
+export async function fetchLicense(): Promise<LicenseInfo | undefined> {
+  runInAction(() => {
+    licenseState.loading = true;
+  });
+  try {
+    const res = await client.post("/license.info");
+    const info = res.data as LicenseInfo;
+    if (info.trialStarted) {
+      // Permissions were sent as read-only before the trial started: reload once.
+      window.location.reload();
+      return info;
+    }
+    runInAction(() => {
+      licenseState.info = info;
+    });
+    return info;
+  } catch {
+    return undefined;
+  } finally {
+    runInAction(() => {
+      licenseState.loading = false;
+    });
+  }
+}
+
+/**
+ * Format a license date with the user's calendar (Persian digits in fa).
+ *
+ * @param iso The ISO date.
+ * @param options The user's language, calendar and date format.
+ * @returns The formatted date.
+ */
+export function formatLicenseDate(
+  iso: string | undefined,
+  options: {
+    language?: string;
+    calendar: CalendarType;
+    dateFormat: DateFormatType;
+  }
+) {
+  if (!iso) {
+    return "—";
+  }
+  return formatDate(new Date(iso), "MMMM do, yyyy", {
+    locale: dateLocale(options.language as Parameters<typeof dateLocale>[0]),
+    calendar: options.calendar,
+    dateFormat: options.dateFormat,
+  });
+}
+
+/**
+ * Format a number for the user's language (Persian digits in fa).
+ *
+ * @param value The number.
+ * @param language The user's language (e.g. fa_IR).
+ * @returns The formatted number.
+ */
+export function formatLicenseNumber(value: number, language?: string) {
+  try {
+    return new Intl.NumberFormat(unicodeCLDRtoBCP47(language || "en_US")).format(
+      value
+    );
+  } catch {
+    return String(value);
+  }
+}
+
+/**
+ * The status as a short label.
+ *
+ * @param status The license status.
+ * @param t The translation function.
+ * @returns The label.
+ */
+export function licenseStatusLabel(status: LicenseStatus, t: TFunction) {
+  switch (status) {
+    case "active":
+      return t("Active");
+    case "warning":
+      return t("Ending soon");
+    case "trial":
+      return t("Trial");
+    case "trialEnded":
+      return t("Trial ended");
+    case "expired":
+      return t("Expired");
+    case "notYetValid":
+      return t("Not valid yet");
+    case "missing":
+    case "unconfigured":
+      return t("Not activated");
+    case "clock":
+      return t("System clock problem");
+    default:
+      return t("Not valid");
+  }
+}
