index 0000000..1a645ec
--- /dev/null
+++ b/server/license/state.ts
@@ -0,0 +1,480 @@
+/**
+ * The license of this server: loading, status, the trial period, renewal
+ * requests and applying a new activation code. Without a valid license or a
+ * running trial the workspace is read-only (see server/policies/cancan.ts);
+ * signing in always works.
+ *
+ * Files written by the installer (read-only in the container):
+ *   $KMS_LICENSE_CONFIG_DIR (/etc/kms-license): install.json, server-key.pem,
+ *   server-pub.pem, server-box.pem, hardware.json
+ * Files written by the app:
+ *   $KMS_LICENSE_DATA_DIR (/var/lib/kms-license): license.kmslic, state.json
+ * The vendor's public keys are part of the build:
+ *   $KMS_LICENSE_VENDOR_KEY (<app>/kms-license/vendor-public.json)
+ *
+ * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ */
+import { createHash, createPublicKey, type KeyObject } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import {
+  PRODUCT,
+  REQUEST_TYPE,
+  b64u,
+  keyFingerprint,
+  loadVendorKeys,
+  matchHardware,
+  openLicense,
+  privateKeyFromPem,
+  rawX25519,
+  sealRequest,
+  type HardwareComponents,
+  type LicensePayload,
+  type RequestPayload,
+} from "./format";
+
+export type LicenseStatus =
+  | "active"
+  | "warning"
+  | "trial"
+  | "trialEnded"
+  | "expired"
+  | "notYetValid"
+  | "missing"
+  | "invalid"
+  | "clock"
+  | "unconfigured";
+
+export type LicenseInfo = {
+  status: LicenseStatus;
+  /** Whether the workspace is read-only because of the license. */
+  readOnly: boolean;
+  customer?: string;
+  serial?: string;
+  issuedAt?: string;
+  notBefore?: string;
+  /** End of the license, or of the trial period. */
+  expiresAt?: string;
+  /** Whole days until the license (or trial) ends; negative once it ended. */
+  daysLeft?: number;
+  warnDays: number;
+  trialDays: number;
+  installId?: string;
+  /** Why the license is not valid, in English (the client translates the status). */
+  reason?: string;
+  hardware?: { matching: number; required: number };
+};
+
+const DAY = 24 * 60 * 60 * 1000;
+const DEFAULT_WARN_DAYS = 30;
+/** Days the system can be used before it is activated, from the first admin sign-in. */
+export const TRIAL_DAYS = 7;
+const RECHECK_MS = 60 * 1000;
+const CLOCK_TOLERANCE_MS = DAY;
+const LAST_SEEN_STEP_MS = 60 * 60 * 1000;
+
+const configDir = () =>
+  process.env.KMS_LICENSE_CONFIG_DIR || "/etc/kms-license";
+const dataDir = () => process.env.KMS_LICENSE_DATA_DIR || "/var/lib/kms-license";
+const vendorKeyPath = () =>
+  process.env.KMS_LICENSE_VENDOR_KEY ||
+  path.resolve(process.cwd(), "kms-license", "vendor-public.json");
+const hostMachineIdPath = () =>
+  process.env.KMS_LICENSE_HOST_MACHINE_ID || "/etc/kms-host-machine-id";
+const licensePath = () => path.join(dataDir(), "license.kmslic");
+const statePath = () => path.join(dataDir(), "state.json");
+
+/** Same hash as the installer: sha256("kms-hw-v1|<name>|<value>"). */
+export const hardwareHash = (name: string, value: string) =>
+  createHash("sha256").update(`kms-hw-v1|${name}|${value.trim()}`).digest("hex");
+
+const readJson = <T>(file: string): T | undefined => {
+  try {
+    return JSON.parse(fs.readFileSync(file, "utf8")) as T;
+  } catch {
+    return undefined;
+  }
+};
+
+type State = { lastSeen?: string; trialStartedAt?: string };
+
+const readState = (): State => readJson<State>(statePath()) ?? {};
+
+/**
+ * Update state.json, keeping the other fields.
+ *
+ * @param change The fields to set.
+ * @returns Whether the file could be written.
+ */
+function writeState(change: State) {
+  try {
+    fs.mkdirSync(dataDir(), { recursive: true });
+    const next = { ...readState(), ...change };
+    const tmp = `${statePath()}.tmp`;
+    fs.writeFileSync(tmp, JSON.stringify(next) + "\n");
+    fs.renameSync(tmp, statePath());
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+type ServerIdentity = {
+  installId: string;
+  serverKey: string;
+  serverPublicKeyPem: string;
+  boxPrivate: KeyObject;
+  boxPublicRaw: string;
+  hw: HardwareComponents;
+};
+
+/**
+ * Read the identity the installer created for this server.
+ *
+ * @returns The identity, or undefined when the installer files are missing.
+ */
+function loadIdentity(): ServerIdentity | undefined {
+  const dir = configDir();
+  const install = readJson<{ installId?: string }>(path.join(dir, "install.json"));
+  const hardware = readJson<{ components?: HardwareComponents }>(
+    path.join(dir, "hardware.json")
+  );
+  let pem: string;
+  let boxPem: string;
+  try {
+    pem = fs.readFileSync(path.join(dir, "server-pub.pem"), "utf8");
+    boxPem = fs.readFileSync(path.join(dir, "server-box.pem"), "utf8");
+  } catch {
+    return undefined;
+  }
+  if (!install?.installId || !hardware?.components) {
+    return undefined;
+  }
+  const hw = { ...hardware.components };
+  // The host's machine-id is mounted into the container: a hardware.json copied
+  // from another server is caught here even without running the installer.
+  try {
+    const machineId = fs.readFileSync(hostMachineIdPath(), "utf8");
+    if (machineId.trim()) {
+      hw.machineid = hardwareHash("machineid", machineId);
+    }
+  } catch {
+    // not mounted: hardware.json alone is used
+  }
+  const boxPrivate = privateKeyFromPem(boxPem);
+  return {
+    installId: install.installId,
+    serverKey: keyFingerprint(createPublicKey(pem)),
+    serverPublicKeyPem: pem,
+    boxPrivate,
+    boxPublicRaw: b64u(rawX25519(createPublicKey(boxPrivate))),
+    hw,
+  };
+}
+
+/**
+ * Check a verified license against this server.
+ *
+ * @param payload The license payload.
+ * @param identity This server's identity.
+ * @returns An error message, or undefined when the license is for this server.
+ */
+function bindingError(payload: LicensePayload, identity: ServerIdentity) {
+  if (payload.product !== PRODUCT) {
+    return `the license is for another product (${payload.product})`;
+  }
+  if (payload.installId !== identity.installId) {
+    return "the license is for another installation";
+  }
+  if (payload.serverKey !== identity.serverKey) {
+    return "the license is for another server key";
+  }
+  const hw = matchHardware(payload.hw ?? {}, identity.hw);
+  if (!hw.ok) {
+    return `the hardware does not match (${hw.matching} of ${hw.required} required identifiers)`;
+  }
+  return undefined;
+}
+
+/**
+ * Detect a clock set back: the last time seen is kept in state.json.
+ *
+ * @param now The current time.
+ * @returns Whether the clock is earlier than a time already seen.
+ */
+function clockWasSetBack(now: number) {
+  const state = readState();
+  const lastSeen = state.lastSeen ? Date.parse(state.lastSeen) : 0;
+  if (lastSeen && now < lastSeen - CLOCK_TOLERANCE_MS) {
+    return true;
+  }
+  if (!lastSeen || now > lastSeen + LAST_SEEN_STEP_MS) {
+    writeState({ lastSeen: new Date(now).toISOString() });
+  }
+  return false;
+}
+
+/**
+ * The status while no license is applied: trial, trial ended, or not started.
+ *
+ * @param now The current time.
+ * @param base Fields shared by every status.
+ * @returns The license information.
+ */
+function trialInfo(now: number, base: LicenseInfo): LicenseInfo {
+  const started = readState().trialStartedAt;
+  if (!started) {
+    return {
+      ...base,
+      status: "missing",
+      readOnly: true,
+      reason: "no license has been applied and the trial has not started",
+    };
+  }
+  const end = Date.parse(started) + TRIAL_DAYS * DAY;
+  const info: LicenseInfo = {
+    ...base,
+    status: "trial",
+    readOnly: false,
+    notBefore: started,
+    expiresAt: new Date(end).toISOString(),
+    daysLeft: Math.ceil((end - now) / DAY),
+  };
+  if (clockWasSetBack(now)) {
+    return {
+      ...info,
+      status: "clock",
+      readOnly: true,
+      reason: "the system clock is earlier than a time already seen",
+    };
+  }
+  if (now >= end) {
+    return { ...info, status: "trialEnded", readOnly: true };
+  }
+  return info;
+}
+
+/**
+ * Compute the license status from the files.
+ *
+ * @returns The license information.
+ */
+function compute(): LicenseInfo {
+  const now = Date.now();
+  const base: LicenseInfo = {
+    status: "missing",
+    readOnly: true,
+    warnDays: DEFAULT_WARN_DAYS,
+    trialDays: TRIAL_DAYS,
+  };
+  const identity = loadIdentity();
+  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  if (!identity || !vendorJson) {
+    // A development checkout has no installer files and is not limited.
+    return {
+      ...base,
+      status: "unconfigured",
+      readOnly: process.env.NODE_ENV === "production",
+      reason: !identity
+        ? `installer license files are missing in ${configDir()}`
+        : `vendor public key is missing (${vendorKeyPath()})`,
+    };
+  }
+  base.installId = identity.installId;
+  let text: string;
+  try {
+    text = fs.readFileSync(licensePath(), "utf8");
+  } catch {
+    return trialInfo(now, base);
+  }
+  let payload: LicensePayload;
+  try {
+    payload = openLicense(text, identity.boxPrivate, loadVendorKeys(vendorJson).sign);
+  } catch (err) {
+    return {
+      ...base,
+      status: "invalid",
+      readOnly: true,
+      reason: (err as Error).message,
+    };
+  }
+  const info: LicenseInfo = {
+    ...base,
+    status: "active",
+    readOnly: false,
+    customer: payload.customer,
+    serial: payload.serial,
+    issuedAt: payload.issuedAt,
+    notBefore: payload.notBefore,
+    expiresAt: payload.expiresAt,
+    warnDays: payload.warnDays ?? DEFAULT_WARN_DAYS,
+    hardware: (({ matching, required }) => ({ matching, required }))(
+      matchHardware(payload.hw ?? {}, identity.hw)
+    ),
+  };
+  const error = bindingError(payload, identity);
+  if (error) {
+    return { ...info, status: "invalid", readOnly: true, reason: error };
+  }
+  if (clockWasSetBack(now)) {
+    return {
+      ...info,
+      status: "clock",
+      readOnly: true,
+      reason: "the system clock is earlier than a time already seen",
+    };
+  }
+  const expires = Date.parse(payload.expiresAt);
+  info.daysLeft = Math.ceil((expires - now) / DAY);
+  if (now < Date.parse(payload.notBefore)) {
+    return { ...info, status: "notYetValid", readOnly: true };
+  }
+  if (now >= expires) {
+    return { ...info, status: "expired", readOnly: true };
+  }
+  if (info.daysLeft <= info.warnDays) {
+    info.status = "warning";
+  }
+  return info;
+}
+
+let cached: LicenseInfo | undefined;
+let cachedAt = 0;
+
+/**
+ * The license information, recomputed at most once a minute.
+ *
+ * @param force Recompute now.
+ * @returns The license information.
+ */
+export function getLicenseInfo(force = false): LicenseInfo {
+  const now = Date.now();
+  if (!force && cached && now - cachedAt < RECHECK_MS) {
+    return cached;
+  }
+  try {
+    cached = compute();
+  } catch (err) {
+    cached = {
+      status: "invalid",
+      readOnly: true,
+      warnDays: DEFAULT_WARN_DAYS,
+      trialDays: TRIAL_DAYS,
+      reason: (err as Error).message,
+    };
+  }
+  cachedAt = now;
+  return cached;
+}
+
+/**
+ * Whether the workspace is read-only because of the license. Called for every
+ * policy check, so it only reads the cached state.
+ *
+ * @returns true when changes are not allowed.
+ */
+export function isLicenseReadOnly() {
+  return getLicenseInfo().readOnly;
+}
+
+/**
+ * Start the trial period on the first admin sign-in, when no license is
+ * applied and no trial was started before.
+ *
+ * @returns true when the trial was started now.
+ */
+export function startTrialIfNeeded() {
+  const info = getLicenseInfo(true);
+  if (info.status !== "missing" || readState().trialStartedAt) {
+    return false;
+  }
+  if (!writeState({ trialStartedAt: new Date().toISOString() })) {
+    return false;
+  }
+  getLicenseInfo(true);
+  return true;
+}
+
+/**
+ * Build the encrypted renewal / activation request for the vendor.
+ *
+ * @param meta Details shown to the vendor.
+ * @returns The armored request and a suggested file name.
+ */
+export function createLicenseRequest(meta: {
+  organization?: string;
+  adminName?: string;
+  adminEmail?: string;
+  appVersion?: string;
+}) {
+  const identity = loadIdentity();
+  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  if (!identity || !vendorJson) {
+    throw new Error("the installer license files or the vendor key are missing");
+  }
+  const privatePem = fs.readFileSync(path.join(configDir(), "server-key.pem"), "utf8");
+  const info = getLicenseInfo(true);
+  const payload: RequestPayload = {
+    type: REQUEST_TYPE,
+    v: 1,
+    product: PRODUCT,
+    createdAt: new Date().toISOString(),
+    installId: identity.installId,
+    serverKey: identity.serverKey,
+    serverPublicKey: identity.serverPublicKeyPem,
+    serverBoxKey: identity.boxPublicRaw,
+    hw: identity.hw,
+    organization: meta.organization,
+    admin: { name: meta.adminName, email: meta.adminEmail },
+    current:
+      info.serial && info.customer && info.expiresAt
+        ? { serial: info.serial, customer: info.customer, expiresAt: info.expiresAt }
+        : null,
+    appVersion: meta.appVersion,
+  };
+  const text = sealRequest(
+    payload,
+    privateKeyFromPem(privatePem),
+    loadVendorKeys(vendorJson).box
+  );
+  const slug =
+    (meta.organization || "kms")
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, "-")
+      .replace(/^-|-$/g, "")
+      .slice(0, 40) || "kms";
+  const date = payload.createdAt.slice(0, 10);
+  return { text, fileName: `kms-license-request-${slug}-${date}.kmsreq` };
+}
+
+/**
+ * Open an activation code with this server's key, check it and store it.
+ *
+ * @param text The armored activation code.
+ * @returns The new license information.
+ * @throws When the code is not for this server or already expired.
+ */
+export function applyLicense(text: string): LicenseInfo {
+  const identity = loadIdentity();
+  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  if (!identity || !vendorJson) {
+    throw new Error("the installer license files or the vendor key are missing");
+  }
+  const payload = openLicense(text, identity.boxPrivate, loadVendorKeys(vendorJson).sign);
+  const error = bindingError(payload, identity);
+  if (error) {
+    throw new Error(error);
+  }
+  if (Date.parse(payload.expiresAt) <= Date.now()) {
+    throw new Error("this license has already expired");
+  }
+  fs.mkdirSync(dataDir(), { recursive: true });
+  const target = licensePath();
+  if (fs.existsSync(target)) {
+    fs.copyFileSync(target, `${target}.bak-${Date.now()}`);
+  }
+  const tmp = `${target}.tmp`;
+  fs.writeFileSync(tmp, text.trim() + "\n", { mode: 0o640 });
+  fs.renameSync(tmp, target);
+  return getLicenseInfo(true);
+}
