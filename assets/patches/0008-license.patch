+/**
+ * license.info, license.request and license.apply. These work while the
+ * workspace is read-only, so an expired server can always be renewed.
+ *
+ * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ */
+import Router from "@koa/router";
+import { UserRole } from "@shared/types";
+import { ValidationError } from "@server/errors";
+import {
+  applyLicense,
+  createLicenseRequest,
+  getLicenseInfo,
+  startTrialIfNeeded,
+  type LicenseInfo,
+} from "@server/license/state";
+import auth from "@server/middlewares/authentication";
+import validate from "@server/middlewares/validate";
+import type { APIContext } from "@server/types";
+import { getVersion } from "@server/utils/getInstallationInfo";
+import * as T from "./schema";
+
+const router = new Router();
+
+/**
+ * The license information a user may see; admins also get the technical
+ * details needed for support.
+ *
+ * @param info The full license information.
+ * @param isAdmin Whether the user is an admin.
+ * @returns The presented information.
+ */
+const present = (info: LicenseInfo, isAdmin: boolean) => {
+  const { installId, reason, hardware, ...publicInfo } = info;
+  return isAdmin ? { ...publicInfo, installId, reason, hardware } : publicInfo;
+};
+
+router.post("license.info", auth(), async (ctx: APIContext) => {
+  const { user } = ctx.state.auth;
+  const isAdmin = user.role === UserRole.Admin;
+  // The trial period starts with the first admin sign-in.
+  const trialStarted = isAdmin && startTrialIfNeeded();
+  ctx.body = {
+    data: { ...present(getLicenseInfo(), isAdmin), trialStarted },
+  };
+});
+
+router.post(
+  "license.request",
+  auth({ role: UserRole.Admin }),
+  async (ctx: APIContext) => {
+    const { user } = ctx.state.auth;
+    const team = user.team;
+    try {
+      const { text, fileName } = createLicenseRequest({
+        organization: team?.name,
+        adminName: user.name,
+        adminEmail: user.email ?? undefined,
+        appVersion: getVersion(),
+      });
+      ctx.body = { data: { text, fileName } };
+    } catch (err) {
+      throw ValidationError((err as Error).message);
+    }
+  }
+);
+
+router.post(
+  "license.apply",
+  auth({ role: UserRole.Admin }),
+  validate(T.LicenseApplySchema),
+  async (ctx: APIContext<T.LicenseApplyReq>) => {
+    const { license } = ctx.input.body;
+    try {
+      ctx.body = { data: present(applyLicense(license), true) };
+    } catch (err) {
+      throw ValidationError((err as Error).message);
+    }
+  }
+);
+
+export default router;
