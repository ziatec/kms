@@ -0,0 +1,61 @@
+/**
+ * What stays allowed while the license makes the workspace read-only:
+ * reading, downloading and exporting, personal stars and subscriptions, and
+ * the user's own account (profile, preferences, notifications, passkeys).
+ *
+ * VERSION: 1.0 (2026-10-12) — KMS patch 0008
+ */
+
+const READ_ACTIONS = new Set([
+  "read",
+  "readDocument",
+  "readDetails",
+  "readEmail",
+  "readReaction",
+  "readTemplate",
+  "listUsers",
+  "listViews",
+  "listRevisions",
+  "listApiKeys",
+  "download",
+  "export",
+  "audit",
+  "star",
+  "unstar",
+  "subscribe",
+  "unsubscribe",
+  "createUserPasskey",
+]);
+
+/** Models the user owns personally; changes to them are not workspace content. */
+const PERSONAL_MODELS = new Set(["Notification", "UserPasskey"]);
+
+/**
+ * Whether an action is allowed while the workspace is read-only.
+ *
+ * @param performerId The id of the user performing the action.
+ * @param action The policy action.
+ * @param targetClass The class name of the target model, if any.
+ * @param targetId The id of the target model, if any.
+ * @returns true when the action does not change workspace content.
+ */
+export function allowedWhileReadOnly(
+  performerId: string | undefined,
+  action: string,
+  targetClass: string | undefined,
+  targetId: string | undefined
+) {
+  if (READ_ACTIONS.has(action)) {
+    return true;
+  }
+  if (targetClass && PERSONAL_MODELS.has(targetClass)) {
+    return true;
+  }
+  // The user's own profile and preferences.
+  return (
+    targetClass === "User" &&
+    !!performerId &&
+    performerId === targetId &&
+    action === "update"
+  );
+}
