+/**
+ * Actions for the right-click menu of the document area (title and editor).
+ * Existing document actions are reused; the editor-specific ones are built
+ * here for the position that was clicked.
+ *
+ * VERSION: 1.0 (2026-10-11) — KMS patch 0006
+ */
+import copy from "copy-to-clipboard";
+import { capitalize } from "es-toolkit/compat";
+import {
+  CommentIcon,
+  CopyIcon,
+  DownloadIcon,
+  EditIcon,
+  InsertAboveIcon,
+  InsertBelowIcon,
+  InsertLeftIcon,
+  InsertRightIcon,
+  LinkIcon,
+  NewDocumentIcon,
+  PlusIcon,
+  PrintIcon,
+  SearchIcon,
+  ShapesIcon,
+  SparklesIcon,
+  TableOfContentsIcon,
+  TrashIcon,
+  ZoomInIcon,
+  ZoomOutIcon,
+} from "outline-icons";
+import { Fragment, Slice } from "prosemirror-model";
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import { NodeSelection, TextSelection } from "prosemirror-state";
+import type { EditorView } from "prosemirror-view";
+import { isInTable, selectedRect } from "prosemirror-tables";
+import * as React from "react";
+import { toast } from "sonner";
+import type { MenuItem as EditorMenuItem } from "@shared/editor/types";
+import { UserPreference } from "@shared/types";
+import { removeUrlFragment, removeUrlPathSuffix } from "@shared/utils/urls";
+import { ProsemirrorHelper } from "@shared/utils/ProsemirrorHelper";
+import type Document from "~/models/Document";
+import {
+  ActionSeparator,
+  createAction,
+  createActionWithChildren,
+  createInternalLinkAction,
+  createRootMenuAction,
+  resolve,
+} from "~/actions";
+import {
+  archiveDocument,
+  copyDocumentLink,
+  createDocumentAfter,
+  createNestedDocument,
+  createNewDocumentInAlphabeticalCollection,
+  createTemplateFromDocument,
+  deleteDocument,
+  downloadDocumentAsHTML,
+  downloadDocumentAsMarkdown,
+  duplicateDocument,
+  moveDocument,
+  openDocumentHistory,
+  pinDocument,
+  printDocument,
+  shareDocument,
+  starDocument,
+  unstarDocument,
+} from "~/actions/definitions/documents";
+import { logout } from "~/actions/definitions/navigation";
+import { ActiveDocumentSection } from "~/actions/sections";
+import TextDirectionIcon from "~/components/Icons/TextDirectionIcon";
+import type { Editor as TEditor } from "~/editor";
+import blockMenuItems from "~/editor/menus/block";
+import { getDocumentZoomControls } from "~/scenes/Document/components/DocumentZoom";
+import ImageAltTextDialog from "~/scenes/Document/components/ImageAltTextDialog";
+import type {
+  ActionContext,
+  ActionSeparator as TActionSeparator,
+  ActionVariant,
+} from "~/types";
+import { newDocumentPath } from "~/utils/routeHelpers";
+
+/** What was under the pointer (or caret) when the menu was opened. */
+export type DocumentEditorMenuTarget = {
+  /** The document being viewed or edited. */
+  document: Document;
+  /** The editor instance, when loaded. */
+  editor: TEditor | null;
+  /** Whether the click landed in the editor body (not the title). */
+  inEditor: boolean;
+  /** Document position under the pointer, when inEditor. */
+  pos: number | null;
+  /** Whether the editor accepts changes. */
+  editable: boolean;
+  /** Read-only or shared view: only copy, link, view and export. */
+  limited: boolean;
+  /** Whether this is the public shared view. */
+  isShare: boolean;
+  /** Whether the user may change the document. */
+  canUpdate: boolean;
+  /** Whether the user may comment. */
+  canComment: boolean;
+  /** Whether text is selected where the menu was opened. */
+  hasSelection: boolean;
+  /** The selected text, for selections outside the editor body. */
+  selectionText: string;
+  /** Whether the title (or another editable outside the body) was clicked. */
+  titleEditable: boolean;
+  /** Puts focus and the DOM selection back where they were on open. */
+  restoreSelection: () => void;
+  /** Position of the table cell under the pointer. */
+  tableCellPos: number | null;
+  /** Position of the image under the pointer. */
+  imagePos: number | null;
+  /** Position of the code block under the pointer. */
+  codePos: number | null;
+  /** Position of the nearest heading at or above the pointer. */
+  headingPos: number | null;
+  /** Explicit direction of the block under the pointer (patch 0001). */
+  blockDir: "rtl" | "ltr" | null;
+  /** Whether the table of contents is shown. */
+  tocShown: boolean;
+  /** Shows or hides the table of contents. */
+  setTocShown: (shown: boolean) => void;
+};
+
+/**
+ * Whether an existing action is visible in the context.
+ *
+ * @param action The action to check.
+ * @param ctx The action context.
+ * @returns false only when the action resolves to invisible.
+ */
+function isVisible(action: ActionVariant, ctx: ActionContext): boolean {
+  return resolve<boolean | undefined>(action.visible, ctx) !== false;
+}
+
+/** Whether the asynchronous Clipboard API can read text in this context. */
+export function canReadClipboard(): boolean {
+  return (
+    typeof navigator !== "undefined" &&
+    !!navigator.clipboard?.readText &&
+    (typeof window === "undefined" || window.isSecureContext)
+  );
+}
+
+/**
+ * Insert plain text as paragraphs, without markdown or rich text handling.
+ *
+ * @param view The editor view.
+ * @param text The text to insert.
+ */
+function insertPlainText(view: EditorView, text: string) {
+  const { state } = view;
+  const lines = text.replace(/\r\n?/g, "\n").split("\n");
+  if (lines.length === 1) {
+    view.dispatch(state.tr.insertText(text).scrollIntoView());
+    return;
+  }
+  const paragraph = state.schema.nodes.paragraph;
+  const nodes = lines.map((line) =>
+    paragraph.create(null, line ? state.schema.text(line) : undefined)
+  );
+  view.dispatch(
+    state.tr
+      .replaceSelection(new Slice(Fragment.from(nodes), 1, 1))
+      .scrollIntoView()
+  );
+}
+
+/**
+ * Place the caret at a position unless the selection already contains it.
+ *
+ * @param view The editor view.
+ * @param pos The document position.
+ */
+function caretAt(view: EditorView, pos: number) {
+  const { selection, doc } = view.state;
+  if (!selection.empty && pos >= selection.from && pos <= selection.to) {
+    return;
+  }
+  const safe = Math.max(0, Math.min(pos, doc.content.size));
+  view.dispatch(
+    view.state.tr.setSelection(TextSelection.near(doc.resolve(safe)))
+  );
+}
+
+/**
+ * Insert an empty paragraph after the block at `pos` (or reuse the block when
+ * it is an empty paragraph) and put the caret in it.
+ *
+ * @param view The editor view.
+ * @param pos The document position that was clicked.
+ */
+function prepareInsertAt(view: EditorView, pos: number) {
+  const { state } = view;
+  const paragraph = state.schema.nodes.paragraph;
+  const safe = Math.max(0, Math.min(pos, state.doc.content.size));
+  const $pos = state.doc.resolve(safe);
+
+  if ($pos.parent.isTextblock) {
+    if ($pos.parent.type === paragraph && $pos.parent.content.size === 0) {
+      view.dispatch(
+        state.tr.setSelection(TextSelection.create(state.doc, $pos.start()))
+      );
+      return;
+    }
+    const after = $pos.after($pos.depth);
+    const tr = state.tr.insert(after, paragraph.create());
+    view.dispatch(
+      tr.setSelection(TextSelection.create(tr.doc, after + 1)).scrollIntoView()
+    );
+    return;
+  }
+
+  const index = $pos.index();
+  if ($pos.parent.canReplaceWith(index, index, paragraph)) {
+    const tr = state.tr.insert(safe, paragraph.create());
+    view.dispatch(tr.setSelection(TextSelection.create(tr.doc, safe + 1)));
+    return;
+  }
+  view.dispatch(
+    state.tr.setSelection(TextSelection.near(state.doc.resolve(safe)))
+  );
+}
+
+/**
+ * The "copy link to heading" URL for the heading at `headingPos`, using the
+ * same anchor ids as the editor (ProsemirrorHelper.getHeadings).
+ *
+ * @param doc The editor document.
+ * @param headingPos Position of the heading node.
+ * @returns The URL, or undefined when the heading was not found.
+ */
+function headingUrl(doc: ProsemirrorNode, headingPos: number) {
+  let index = -1;
+  let count = 0;
+  doc.descendants((node, pos) => {
+    if (node.type.name === "heading") {
+      if (pos === headingPos) {
+        index = count;
+      }
+      count++;
+    }
+  });
+  const heading = ProsemirrorHelper.getHeadings(doc)[index];
+  if (!heading) {
+    return undefined;
+  }
+  const base = removeUrlPathSuffix(
+    removeUrlFragment(window.location.href),
+    "/edit"
+  );
+  return `${base}#${heading.id}`;
+}
+
+/**
+ * Build the root action of the document area context menu.
+ *
+ * @param target What was under the pointer when the menu opened.
+ * @returns The root menu action.
+ */
+export function createDocumentEditorMenuAction(
+  target: DocumentEditorMenuTarget
+) {
+  const {
+    document,
+    editor,
+    inEditor,
+    pos,
+    editable,
+    limited,
+    isShare,
+    canUpdate,
+    canComment,
+    hasSelection,
+    restoreSelection,
+  } = target;
+  const view = editor?.view;
+  const commands = editor?.commands as
+    | Record<string, ((attrs?: unknown) => unknown) | undefined>
+    | undefined;
+  const editorReady = !!view && !!commands && inEditor && pos !== null;
+  const canEditBody = editorReady && editable;
+
+  const run = (name: string, attrs?: unknown) => {
+    const command =
+      commands?.[name] ?? commands?.[`create${capitalize(name)}`];
+    command?.(attrs);
+  };
+
+  // 0. Context section -----------------------------------------------------
+
+  const tableIndexAction = (
+    name: string,
+    label: (ctx: ActionContext) => string,
+    icon: React.ReactNode,
+    command: string,
+    index: (rect: ReturnType<typeof selectedRect>) => number | undefined
+  ) =>
+    createAction({
+      name: label,
+      section: ActiveDocumentSection,
+      icon,
+      visible: canEditBody && target.tableCellPos !== null && !limited,
+      perform: () => {
+        if (!view || target.tableCellPos === null) {
+          return;
+        }
+        view.dispatch(
+          view.state.tr.setSelection(
+            TextSelection.near(view.state.doc.resolve(target.tableCellPos + 1))
+          )
+        );
+        if (!isInTable(view.state)) {
+          return;
+        }
+        const rect = selectedRect(view.state);
+        run(command, { index: index(rect) });
+      },
+      analyticsName: name,
+    });
+
+  const tableActions: ActionVariant[] = [
+    tableIndexAction(
+      "Context menu add row above",
+      ({ t }) => t("Add row above"),
+      <InsertAboveIcon />,
+      "addRowBefore",
+      (rect) => rect.top
+    ),
+    tableIndexAction(
+      "Context menu add row below",
+      ({ t }) => t("Add row below"),
+      <InsertBelowIcon />,
+      "addRowAfter",
+      (rect) => rect.bottom - 1
+    ),
+    tableIndexAction(
+      "Context menu add column before",
+      ({ t }) => t("Add column before"),
+      <InsertLeftIcon />,
+      "addColumnBefore",
+      (rect) => rect.left
+    ),
+    tableIndexAction(
+      "Context menu add column after",
+      ({ t }) => t("Add column after"),
+      <InsertRightIcon />,
+      "addColumnAfter",
+      (rect) => rect.right - 1
+    ),
+    tableIndexAction(
+      "Context menu delete row",
+      ({ t }) => t("Delete row"),
+      <TrashIcon />,
+      "deleteRow",
+      () => undefined
+    ),
+    tableIndexAction(
+      "Context menu delete column",
+      ({ t }) => t("Delete column"),
+      <TrashIcon />,
+      "deleteColumn",
+      () => undefined
+    ),
+  ];
+
+  const selectImage = () => {
+    if (!view || target.imagePos === null) {
+      return false;
+    }
+    const node = view.state.doc.nodeAt(target.imagePos);
+    if (node?.type.name !== "image") {
+      return false;
+    }
+    view.dispatch(
+      view.state.tr.setSelection(
+        NodeSelection.create(view.state.doc, target.imagePos)
+      )
+    );
+    return true;
+  };
+
+  const imageActions: ActionVariant[] = [
+    createAction({
+      name: ({ t }) => t("Download image"),
+      section: ActiveDocumentSection,
+      icon: <DownloadIcon />,
+      visible: editorReady && target.imagePos !== null,
+      perform: () => {
+        if (selectImage()) {
+          run("downloadImage");
+        }
+      },
+    }),
+    createAction({
+      name: ({ t }) => `${t("Edit alt text")}…`,
+      section: ActiveDocumentSection,
+      icon: <EditIcon />,
+      visible: canEditBody && target.imagePos !== null && !limited,
+      perform: ({ stores, t }) => {
+        if (!view || target.imagePos === null) {
+          return;
+        }
+        const imagePos = target.imagePos;
+        const node = view.state.doc.nodeAt(imagePos);
+        if (node?.type.name !== "image") {
+          return;
+        }
+        stores.dialogs.openModal({
+          title: t("Edit alt text"),
+          content: (
+            <ImageAltTextDialog
+              initialValue={String(node.attrs.alt ?? "")}
+              onSubmit={(alt) => {
+                const current = view.state.doc.nodeAt(imagePos);
+                if (current?.type.name === "image") {
+                  view.dispatch(
+                    view.state.tr.setNodeMarkup(imagePos, undefined, {
+                      ...current.attrs,
+                      alt: alt || null,
+                    })
+                  );
+                }
+                stores.dialogs.closeAllModals();
+              }}
+            />
+          ),
+        });
+      },
+    }),
+  ];
+
+  const codeActions: ActionVariant[] = [
+    createAction({
+      name: ({ t }) => t("Copy code"),
+      section: ActiveDocumentSection,
+      icon: <CopyIcon />,
+      visible: editorReady && target.codePos !== null,
+      perform: ({ t }) => {
+        if (!view || target.codePos === null) {
+          return;
+        }
+        const node = view.state.doc.nodeAt(target.codePos);
+        if (node) {
+          copy(node.textContent);
+          toast.success(t("Copied to clipboard"));
+        }
+      },
+    }),
+  ];
+
+  // 1. Selection ------------------------------------------------------------
+
+  const execClipboard = (command: "copy" | "cut") => {
+    restoreSelection();
+    try {
+      window.document.execCommand(command);
+    } catch {
+      // Some browsers refuse; the native menu (Shift+right-click) still works.
+    }
+  };
+
+  const selectedSlice = () => {
+    if (!view) {
+      return undefined;
+    }
+    const { from, to } = view.state.selection;
+    return from === to ? undefined : view.state.doc.slice(from, to);
+  };
+
+  const clipboardReadable = canReadClipboard();
+  const pasteTooltip = ({ t }: ActionContext) =>
+    clipboardReadable
+      ? undefined
+      : t("Not allowed by the browser. Use Shift+right-click for its menu.");
+
+  const pasteFailed = (t: ActionContext["t"]) =>
+    toast.error(
+      t("Not allowed by the browser. Use Shift+right-click for its menu.")
+    );
+
+  const selectionActions: ActionVariant[] = [
+    createAction({
+      name: ({ t }) => t("Cut"),
+      section: ActiveDocumentSection,
+      visible:
+        hasSelection &&
+        !limited &&
+        (inEditor ? canEditBody : target.titleEditable),
+      perform: () => execClipboard("cut"),
+    }),
+    createAction({
+      name: ({ t }) => t("Copy"),
+      section: ActiveDocumentSection,
+      icon: <CopyIcon />,
+      visible: hasSelection,
+      perform: () => execClipboard("copy"),
+    }),
+    createAction({
+      name: ({ t }) => t("Copy as Markdown"),
+      section: ActiveDocumentSection,
+      visible: hasSelection,
+      perform: ({ t }) => {
+        const slice = inEditor ? selectedSlice() : undefined;
+        const text =
+          slice && editor
+            ? editor.serializer.serialize(slice.content, { commonMark: true })
+            : target.selectionText;
+        copy(text);
+        toast.success(t("Copied to clipboard"));
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Copy as plain text"),
+      section: ActiveDocumentSection,
+      visible: hasSelection,
+      perform: ({ t }) => {
+        const slice = inEditor ? selectedSlice() : undefined;
+        const text =
+          slice && view
+            ? view.state.doc.textBetween(
+                view.state.selection.from,
+                view.state.selection.to,
+                "\n\n",
+                "\n"
+              )
+            : target.selectionText;
+        copy(text);
+        toast.success(t("Copied to clipboard"));
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Paste"),
+      section: ActiveDocumentSection,
+      visible: !limited && (inEditor ? canEditBody : target.titleEditable),
+      disabled: !clipboardReadable,
+      tooltip: pasteTooltip,
+      perform: async ({ t }) => {
+        try {
+          restoreSelection();
+          if (inEditor && view) {
+            if (navigator.clipboard.read) {
+              const items = await navigator.clipboard.read();
+              for (const item of items) {
+                if (item.types.includes("text/html")) {
+                  const html = await (await item.getType("text/html")).text();
+                  view.pasteHTML(html);
+                  return;
+                }
+                if (item.types.includes("text/plain")) {
+                  const text = await (
+                    await item.getType("text/plain")
+                  ).text();
+                  view.pasteText(text);
+                  return;
+                }
+              }
+              return;
+            }
+            view.pasteText(await navigator.clipboard.readText());
+            return;
+          }
+          const text = await navigator.clipboard.readText();
+          restoreSelection();
+          window.document.execCommand("insertText", false, text);
+        } catch {
+          pasteFailed(t);
+        }
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Paste as plain text"),
+      section: ActiveDocumentSection,
+      visible: !limited && (inEditor ? canEditBody : target.titleEditable),
+      disabled: !clipboardReadable,
+      tooltip: pasteTooltip,
+      perform: async ({ t }) => {
+        try {
+          const text = await navigator.clipboard.readText();
+          restoreSelection();
+          if (inEditor && view) {
+            insertPlainText(view, text);
+          } else {
+            window.document.execCommand("insertText", false, text);
+          }
+        } catch {
+          pasteFailed(t);
+        }
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Add comment"),
+      section: ActiveDocumentSection,
+      icon: <CommentIcon />,
+      visible:
+        hasSelection &&
+        inEditor &&
+        !limited &&
+        canComment &&
+        !!commands?.comment,
+      perform: () => {
+        restoreSelection();
+        run("comment");
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Add link"),
+      section: ActiveDocumentSection,
+      icon: <LinkIcon />,
+      visible: hasSelection && canEditBody && !limited,
+      perform: () => {
+        restoreSelection();
+        run("addLink", { href: "" });
+      },
+    }),
+  ];
+
+  // 2. Create ---------------------------------------------------------------
+
+  const newFromTemplate = createActionWithChildren({
+    name: ({ t }) => t("New from template"),
+    section: ActiveDocumentSection,
+    icon: <ShapesIcon />,
+    visible: ({ currentTeamId, stores }) =>
+      !limited &&
+      !!currentTeamId &&
+      stores.policies.abilities(currentTeamId).createDocument,
+    children: ({ stores }) =>
+      stores.templates.published
+        .filter(
+          (template) =>
+            template.isWorkspaceTemplate ||
+            template.collectionId === document.collectionId
+        )
+        .map((template) =>
+          createInternalLinkAction({
+            name: template.titleWithDefault,
+            section: ActiveDocumentSection,
+            visible: !!document.collectionId,
+            to: ({ sidebarContext }) => {
+              const [pathname, search] = newDocumentPath(
+                document.collectionId,
+                { templateId: template.id }
+              ).split("?");
+              return { pathname, search, state: { sidebarContext } };
+            },
+          })
+        ),
+  });
+
+  const createActions: ActionVariant[] = [
+    {
+      ...createDocumentAfter,
+      id: "kms-context-new-sibling",
+      name: ({ t }: ActionContext) => t("New document"),
+      icon: <NewDocumentIcon />,
+      visible: (ctx: ActionContext) =>
+        !limited && isVisible(createDocumentAfter, ctx),
+    },
+    {
+      ...createNestedDocument,
+      id: "kms-context-new-nested",
+      name: ({ t }: ActionContext) => t("New sub-document"),
+      visible: (ctx: ActionContext) =>
+        !limited &&
+        isVisible(createNestedDocument, ctx) &&
+        // In alphabetical collections the next item covers this.
+        !isVisible(createNewDocumentInAlphabeticalCollection, ctx),
+    },
+    {
+      ...createNewDocumentInAlphabeticalCollection,
+      id: "kms-context-new-alpha",
+      name: ({ t }: ActionContext) => t("New sub-document"),
+      visible: (ctx: ActionContext) =>
+        !limited && isVisible(createNewDocumentInAlphabeticalCollection, ctx),
+    },
+    newFromTemplate,
+  ];
+
+  // 3. Insert ---------------------------------------------------------------
+
+  const insertChildren = (ctx: ActionContext) => {
+    if (!view || !commands || pos === null) {
+      return [];
+    }
+    const documentRef = {
+      current: view.dom as HTMLDivElement,
+    } as React.RefObject<HTMLDivElement>;
+    const skip = new Set(["image", "video", "attachment", "embed", "noop"]);
+    const items: (ActionVariant | TActionSeparator)[] = [];
+    for (const item of blockMenuItems(ctx.t, documentRef) as EditorMenuItem[]) {
+      if (item.name === "separator") {
+        items.push(ActionSeparator);
+        continue;
+      }
+      if (
+        !item.name ||
+        skip.has(item.name) ||
+        item.visible === false ||
+        item.defaultHidden ||
+        (!commands[item.name] && !commands[`create${capitalize(item.name)}`])
+      ) {
+        continue;
+      }
+      const name = item.name;
+      items.push(
+        createAction({
+          name: String(item.title ?? item.label ?? name),
+          section: ActiveDocumentSection,
+          icon: item.icon,
+          perform: () => {
+            prepareInsertAt(view, pos);
+            const attrs =
+              typeof item.attrs === "function"
+                ? item.attrs(view.state)
+                : item.attrs;
+            run(name, attrs);
+            if (item.appendSpace) {
+              view.dispatch(view.state.tr.insertText(" "));
+            }
+            view.focus();
+          },
+        })
+      );
+    }
+    return items;
+  };
+
+  const insertAction = createActionWithChildren({
+    name: ({ t }) => t("Insert"),
+    section: ActiveDocumentSection,
+    icon: <PlusIcon />,
+    visible: canEditBody && !limited,
+    children: insertChildren,
+  });
+
+  // 4. Link -----------------------------------------------------------------
+
+  const linkActions: ActionVariant[] = [
+    {
+      ...copyDocumentLink,
+      id: "kms-context-copy-link",
+      name: ({ t }: ActionContext) => t("Copy link to document"),
+      icon: <LinkIcon />,
+      iconInContextMenu: true,
+      visible: !isShare,
+    },
+    createAction({
+      name: ({ t }) => t("Copy link to document"),
+      section: ActiveDocumentSection,
+      icon: <LinkIcon />,
+      visible: isShare,
+      perform: ({ t }) => {
+        copy(
+          removeUrlPathSuffix(removeUrlFragment(window.location.href), "/edit")
+        );
+        toast.success(t("Link copied to clipboard"));
+      },
+    }),
+    createAction({
+      name: ({ t }) => t("Copy link to this heading"),
+      section: ActiveDocumentSection,
+      visible: editorReady && target.headingPos !== null,
+      perform: ({ t }) => {
+        if (!view || target.headingPos === null) {
+          return;
+        }
+        const url = headingUrl(view.state.doc, target.headingPos);
+        if (url) {
+          copy(url);
+          toast.success(t("Link copied to clipboard"));
+        }
+      },
+    }),
+    {
+      ...shareDocument,
+      id: "kms-context-share",
+      visible: (ctx: ActionContext) =>
+        !limited && isVisible(shareDocument, ctx),
+    },
+  ];
+
+  // 5. View -----------------------------------------------------------------
+
+  const zoom = getDocumentZoomControls();
+  const directionAction = (
+    dir: "rtl" | "ltr" | null,
+    label: (ctx: ActionContext) => string
+  ) =>
+    createAction({
+      name: label,
+      section: ActiveDocumentSection,
+      icon: <TextDirectionIcon dir={dir ?? "auto"} />,
+      selected: target.blockDir === dir,
+      perform: () => {
+        if (!view || pos === null) {
+          return;
+        }
+        caretAt(view, pos);
+        run("setTextDirection", { dir });
+      },
+    });
+
+  const viewActions: ActionVariant[] = [
+    createAction({
+      name: ({ t }) => `${t("Find and replace")}…`,
+      section: ActiveDocumentSection,
+      icon: <SearchIcon />,
+      visible: !!commands?.openFindAndReplace,
+      perform: () => run("openFindAndReplace"),
+    }),
+    createAction({
+      name: ({ t }) => t("Table of contents"),
+      section: ActiveDocumentSection,
+      icon: <TableOfContentsIcon />,
+      selected: target.tocShown,
+      perform: () => target.setTocShown(!target.tocShown),
+    }),
+    createAction({
+      name: ({ t }) => t("Full width"),
+      section: ActiveDocumentSection,
+      selected: document.fullWidth,
+      perform: ({ stores }) => {
+        const checked = !document.fullWidth;
+        document.fullWidth = checked;
+        if (canUpdate && !isShare) {
+          const user = stores.auth.user;
+          if (user) {
+            user.setPreference(UserPreference.FullWidthDocuments, checked);
+            void user.save();
+          }
+          void document.save({ fullWidth: checked });
+        }
+      },
+    }),
+    createActionWithChildren({
+      name: ({ t }) => t("Text direction"),
+      section: ActiveDocumentSection,
+      icon: <TextDirectionIcon dir={target.blockDir ?? "auto"} />,
+      visible: canEditBody && !limited && !!commands?.setTextDirection,
+      children: [
+        directionAction("rtl", ({ t }) => t("Right to left")),
+        directionAction("ltr", ({ t }) => t("Left to right")),
+        directionAction(null, ({ t }) => t("Automatic direction")),
+      ],
+    }),
+    createActionWithChildren({
+      name: ({ t }) => t("Zoom"),
+      section: ActiveDocumentSection,
+      icon: <ZoomInIcon />,
+      visible: !!zoom,
+      children: [
+        createAction({
+          name: ({ t }) => t("Zoom in"),
+          section: ActiveDocumentSection,
+          icon: <ZoomInIcon />,
+          perform: () => getDocumentZoomControls()?.zoomIn(),
+        }),
+        createAction({
+          name: ({ t }) => t("Zoom out"),
+          section: ActiveDocumentSection,
+          icon: <ZoomOutIcon />,
+          perform: () => getDocumentZoomControls()?.zoomOut(),
+        }),
+        createAction({
+          name: ({ t }) => t("Reset zoom"),
+          section: ActiveDocumentSection,
+          selected: (zoom?.getZoom() ?? 1) === 1,
+          perform: () => getDocumentZoomControls()?.reset(),
+        }),
+      ],
+    }),
+  ];
+
+  // 6. AI (coming soon) -------------------------------------------------------
+
+  const aiAction = (label: (ctx: ActionContext) => string, id: string) =>
+    createAction({
+      id: `kms-ai-${id}`,
+      name: label,
+      section: ActiveDocumentSection,
+      visible: true,
+      disabled: true,
+      tooltip: ({ t }) => t("Coming soon"),
+      perform: () => undefined,
+    });
+
+  const aiMenu = createActionWithChildren({
+    name: ({ t }) => t("AI"),
+    section: ActiveDocumentSection,
+    icon: <SparklesIcon />,
+    visible: !limited,
+    children: [
+      aiAction(({ t }) => t("Summarize"), "summarize"),
+      aiAction(({ t }) => t("Rewrite / improve"), "rewrite"),
+      aiAction(({ t }) => t("Translate fa ↔ en"), "translate"),
+      aiAction(({ t }) => t("Continue writing"), "continue"),
+      aiAction(({ t }) => t("Fix spelling"), "spelling"),
+    ],
+  });
+
+  // 7. Export ------------------------------------------------------------------
+
+  const exportMenu = createActionWithChildren({
+    name: ({ t }) => t("Export"),
+    section: ActiveDocumentSection,
+    icon: <DownloadIcon />,
+    children: [
+      downloadDocumentAsMarkdown,
+      downloadDocumentAsHTML,
+      ActionSeparator,
+      createAction({
+        name: ({ t }) => t("PDF (print → save as PDF)"),
+        section: ActiveDocumentSection,
+        icon: <PrintIcon />,
+        iconInContextMenu: false,
+        visible: !!window.print,
+        perform: () => {
+          setTimeout(window.print, 0);
+        },
+      }),
+      printDocument,
+    ],
+  });
+
+  // 8. Document ----------------------------------------------------------------
+
+  const documentActions: ActionVariant[] = limited
+    ? []
+    : [
+        openDocumentHistory,
+        starDocument,
+        unstarDocument,
+        pinDocument,
+        moveDocument,
+        duplicateDocument,
+        createTemplateFromDocument,
+        archiveDocument,
+        deleteDocument,
+      ];
+
+  // 9. Log out -------------------------------------------------------------------
+
+  const logoutAction = {
+    ...logout,
+    id: "kms-context-logout",
+    visible: ({ currentUserId }: ActionContext) =>
+      !limited && !isShare && !!currentUserId,
+  };
+
+  const contextActions: ActionVariant[] = [
+    ...(target.tableCellPos !== null ? tableActions : []),
+    ...(target.imagePos !== null ? imageActions : []),
+    ...(target.codePos !== null ? codeActions : []),
+  ];
+
+  return createRootMenuAction([
+    ...contextActions,
+    ActionSeparator,
+    ...selectionActions,
+    ActionSeparator,
+    ...createActions,
+    ActionSeparator,
+    insertAction,
+    ActionSeparator,
+    ...linkActions,
+    ActionSeparator,
+    ...viewActions,
+    ActionSeparator,
+    aiMenu,
+    ActionSeparator,
+    exportMenu,
+    ActionSeparator,
+    ...documentActions,
+    ActionSeparator,
+    logoutAction,
+  ]);
+}
