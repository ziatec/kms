+/**
+ * Dialog to edit the alternative text of an image.
+ *
+ * VERSION: 1.0 (2026-10-11) — KMS patch 0006
+ */
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import Button from "~/components/Button";
+import Flex from "~/components/Flex";
+import Input from "~/components/Input";
+
+type Props = {
+  /** The current alt text. */
+  initialValue: string;
+  /** Called with the new alt text (may be empty). */
+  onSubmit: (alt: string) => void;
+};
+
+function ImageAltTextDialog({ initialValue, onSubmit }: Props) {
+  const { t } = useTranslation();
+  const [value, setValue] = React.useState(initialValue);
+
+  const handleSubmit = React.useCallback(
+    (ev: React.SyntheticEvent) => {
+      ev.preventDefault();
+      onSubmit(value.trim());
+    },
+    [onSubmit, value]
+  );
+
+  return (
+    <form onSubmit={handleSubmit}>
+      <Flex column>
+        <Input
+          type="text"
+          label={t("Alt text")}
+          onChange={(ev) => setValue(ev.target.value)}
+          value={value}
+          autoSelect
+          flex
+        />
+      </Flex>
+      <Flex justify="flex-end">
+        <Button type="submit">{t("Save")}</Button>
+      </Flex>
+    </form>
+  );
+}
+
+export default ImageAltTextDialog;
