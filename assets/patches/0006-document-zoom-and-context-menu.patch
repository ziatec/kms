+/**
+ * Settings → Preferences row for the sidebar zoom.
+ *
+ * VERSION: 1.0 (2026-10-11) — KMS patch 0006
+ */
+import { observer } from "mobx-react";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+import { UserPreference } from "@shared/types";
+import { unicodeCLDRtoBCP47 } from "@shared/utils/date";
+import { INTERFACE_ZOOM_CHOICES } from "@shared/utils/zoom";
+import type { Option } from "~/components/InputSelect";
+import { InputSelect } from "~/components/InputSelect";
+import useCurrentUser from "~/hooks/useCurrentUser";
+import SettingRow from "./SettingRow";
+
+function InterfaceZoomSetting() {
+  const { t, i18n } = useTranslation();
+  const user = useCurrentUser();
+  const current = Number(user.getPreference(UserPreference.InterfaceZoom, 1));
+  const value = INTERFACE_ZOOM_CHOICES.includes(
+    current as (typeof INTERFACE_ZOOM_CHOICES)[number]
+  )
+    ? current
+    : 1;
+
+  const options: Option[] = React.useMemo(() => {
+    let locale: string | undefined;
+    try {
+      locale = unicodeCLDRtoBCP47(user.language || i18n.language || "en_US");
+    } catch {
+      locale = undefined;
+    }
+    const format = new Intl.NumberFormat(locale, {
+      style: "percent",
+      maximumFractionDigits: 0,
+    });
+    return INTERFACE_ZOOM_CHOICES.map(
+      (choice) =>
+        ({
+          type: "item",
+          label: format.format(choice),
+          value: String(choice),
+        }) satisfies Option
+    );
+  }, [user.language, i18n.language]);
+
+  const handleChange = React.useCallback(
+    async (next: string) => {
+      const zoom = Number(next);
+      if (!Number.isFinite(zoom)) {
+        return;
+      }
+      user.setPreference(UserPreference.InterfaceZoom, zoom);
+      await user.save();
+      toast.success(t("Preferences saved"));
+    },
+    [user, t]
+  );
+
+  return (
+    <SettingRow
+      name={UserPreference.InterfaceZoom}
+      label={t("Sidebar size")}
+      description={t(
+        "Zoom level of the side menu. Documents are zoomed with Ctrl + mouse wheel or Ctrl with +, - and 0."
+      )}
+    >
+      <InputSelect
+        options={options}
+        value={String(value)}
+        onChange={handleChange}
+        label={t("Sidebar size")}
+        labelHidden
+      />
+    </SettingRow>
+  );
+}
+
+export default observer(InterfaceZoomSetting);
