+/**
+ * View-only document zoom: Ctrl+wheel, trackpad pinch and Ctrl/Cmd + = - 0.
+ * The zoom is never saved; each document opens at 100%.
+ *
+ * VERSION: 1.1 (2026-10-11) — KMS patch 0006
+ */
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import styled from "styled-components";
+import { HEADER_HEIGHT } from "@shared/constants";
+import { depths, s } from "@shared/styles";
+import { unicodeCLDRtoBCP47 } from "@shared/utils/date";
+import { metaDisplay } from "@shared/utils/keyboard";
+import {
+  DOC_ZOOM_VAR,
+  clampDocZoom,
+  stepDocZoom,
+} from "@shared/utils/zoom";
+import Tooltip from "~/components/Tooltip";
+import useMobile from "~/hooks/useMobile";
+
+type Props = {
+  /** The element that receives the zoom (the document's Main column). */
+  targetRef: React.RefObject<HTMLElement | null>;
+};
+
+/** Wheel deltas below this (in pixels) are treated as a continuous pinch. */
+const PINCH_DELTA_LIMIT = 40;
+
+/** How strongly a pinch delta changes the zoom. */
+const PINCH_SENSITIVITY = 0.01;
+
+/** Zoom commands for other parts of the document page, e.g. its context menu. */
+export type DocumentZoomControls = {
+  zoomIn: () => void;
+  zoomOut: () => void;
+  reset: () => void;
+  getZoom: () => number;
+};
+
+let activeControls: DocumentZoomControls | null = null;
+
+/**
+ * Returns the zoom controls of the document that is open, if any.
+ *
+ * @returns The controls, or null when no document zoom is mounted.
+ */
+export function getDocumentZoomControls(): DocumentZoomControls | null {
+  return activeControls;
+}
+
+const ZOOM_IN_CODES = new Set(["Equal", "NumpadAdd"]);
+const ZOOM_OUT_CODES = new Set(["Minus", "NumpadSubtract"]);
+const ZOOM_RESET_CODES = new Set(["Digit0", "Numpad0"]);
+
+/**
+ * Find the element that scrolls the given element vertically.
+ *
+ * @param el The element inside the scroll container.
+ * @returns The scrolling ancestor, or the document scrolling element.
+ */
+function getScrollParent(el: HTMLElement): HTMLElement {
+  let node: HTMLElement | null = el.parentElement;
+  while (node && node !== document.body) {
+    const { overflowY } = window.getComputedStyle(node);
+    if (
+      (overflowY === "auto" || overflowY === "scroll") &&
+      node.scrollHeight > node.clientHeight
+    ) {
+      return node;
+    }
+    node = node.parentElement;
+  }
+  return (document.scrollingElement as HTMLElement) ?? document.documentElement;
+}
+
+/**
+ * Renders the zoom badge and owns the zoom input listeners for one document.
+ * Mount it with `key={document.id}` so another document starts at 100%.
+ */
+function DocumentZoom({ targetRef }: Props) {
+  const { t, i18n } = useTranslation();
+  const isMobile = useMobile();
+  const zoomRef = React.useRef(1);
+  const [zoom, setZoom] = React.useState(1);
+
+  /**
+   * Apply a new zoom, keeping the content at `anchorY` (viewport px) in place.
+   * When no anchor is given the top of the visible text stays in place.
+   */
+  const applyZoom = React.useCallback(
+    (requested: number, anchorY?: number) => {
+      const target = targetRef.current;
+      if (!target) {
+        return;
+      }
+      const previous = zoomRef.current;
+      const next = clampDocZoom(requested);
+      if (next === previous) {
+        return;
+      }
+
+      const scroller = getScrollParent(target);
+      const isDocumentScroller =
+        scroller === document.scrollingElement ||
+        scroller === document.documentElement;
+      const scrollerTop = isDocumentScroller
+        ? 0
+        : scroller.getBoundingClientRect().top;
+      const rect = target.getBoundingClientRect();
+      const y =
+        anchorY ?? Math.max(rect.top, scrollerTop + HEADER_HEIGHT);
+      // Distance of the anchor from the top of Main, in unzoomed CSS px.
+      const offset = Math.max(0, (y - rect.top) / previous);
+
+      zoomRef.current = next;
+      if (next === 1) {
+        target.style.removeProperty(DOC_ZOOM_VAR);
+      } else {
+        target.style.setProperty(DOC_ZOOM_VAR, String(next));
+      }
+      // Main's top does not move with its own zoom, so the anchored point
+      // moved by offset * (next - previous); scroll by the same amount.
+      scroller.scrollTop += offset * (next - previous);
+      setZoom(next);
+    },
+    [targetRef]
+  );
+
+  const reset = React.useCallback(() => applyZoom(1), [applyZoom]);
+
+  React.useEffect(() => {
+    const controls: DocumentZoomControls = {
+      zoomIn: () => applyZoom(stepDocZoom(zoomRef.current, 1)),
+      zoomOut: () => applyZoom(stepDocZoom(zoomRef.current, -1)),
+      reset: () => applyZoom(1),
+      getZoom: () => zoomRef.current,
+    };
+    activeControls = controls;
+    return () => {
+      if (activeControls === controls) {
+        activeControls = null;
+      }
+    };
+  }, [applyZoom]);
+
+  React.useEffect(() => {
+    if (isMobile) {
+      return;
+    }
+
+    const handleWheel = (event: WheelEvent) => {
+      // Trackpad pinch arrives as a wheel event with ctrlKey set.
+      if (!event.ctrlKey) {
+        return;
+      }
+      event.preventDefault();
+      const current = zoomRef.current;
+      const isPinch =
+        event.deltaMode === 0 && Math.abs(event.deltaY) < PINCH_DELTA_LIMIT;
+      const next = isPinch
+        ? current * Math.exp(-event.deltaY * PINCH_SENSITIVITY)
+        : event.deltaY === 0
+          ? current
+          : stepDocZoom(current, event.deltaY < 0 ? 1 : -1);
+      applyZoom(next, event.clientY);
+    };
+
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (!(event.ctrlKey || event.metaKey) || event.altKey) {
+        return;
+      }
+      const { code } = event;
+      let next: number | undefined;
+      if (ZOOM_IN_CODES.has(code)) {
+        // "+" needs Shift on many layouts, so Shift is allowed here only.
+        next = stepDocZoom(zoomRef.current, 1);
+      } else if (event.shiftKey) {
+        // Ctrl+Shift+Minus (horizontal rule) and Ctrl+Shift+0 (paragraph)
+        // belong to the editor.
+        return;
+      } else if (ZOOM_OUT_CODES.has(code)) {
+        next = stepDocZoom(zoomRef.current, -1);
+      } else if (ZOOM_RESET_CODES.has(code)) {
+        next = 1;
+      }
+      if (next === undefined) {
+        return;
+      }
+      event.preventDefault();
+      event.stopPropagation();
+      applyZoom(next);
+    };
+
+    window.addEventListener("wheel", handleWheel, { passive: false });
+    window.addEventListener("keydown", handleKeyDown, true);
+    return () => {
+      window.removeEventListener("wheel", handleWheel);
+      window.removeEventListener("keydown", handleKeyDown, true);
+    };
+  }, [isMobile, applyZoom]);
+
+  // Leaving the document (unmount) always returns to 100%.
+  React.useEffect(() => {
+    const target = targetRef.current;
+    return () => {
+      target?.style.removeProperty(DOC_ZOOM_VAR);
+    };
+  }, [targetRef]);
+
+  const label = React.useMemo(() => {
+    let locale: string | undefined;
+    try {
+      locale = unicodeCLDRtoBCP47(i18n.language || "en_US");
+    } catch {
+      locale = undefined;
+    }
+    return new Intl.NumberFormat(locale, {
+      style: "percent",
+      maximumFractionDigits: 0,
+    }).format(zoom);
+  }, [zoom, i18n.language]);
+
+  if (zoom === 1) {
+    return null;
+  }
+
+  return (
+    <BadgeAnchor>
+      <Tooltip content={t("Reset zoom")} shortcut={`${metaDisplay}+0`}>
+        <Badge
+          type="button"
+          onClick={reset}
+          aria-label={`${t("Document zoom")} ${label}. ${t("Reset zoom")}`}
+        >
+          {label}
+        </Badge>
+      </Tooltip>
+    </BadgeAnchor>
+  );
+}
+
+const BadgeAnchor = styled.div`
+  position: sticky;
+  top: ${HEADER_HEIGHT + 8}px;
+  height: 0;
+  z-index: ${depths.toc};
+  pointer-events: none;
+
+  @media print {
+    display: none;
+  }
+`;
+
+const Badge = styled.button`
+  position: absolute;
+  top: 0;
+  inset-inline-end: 16px;
+  pointer-events: auto;
+  cursor: var(--pointer);
+  padding: 2px 8px;
+  border: 1px solid ${s("divider")};
+  border-radius: 12px;
+  background: ${s("menuBackground")};
+  color: ${s("textSecondary")};
+  box-shadow: ${s("menuShadow")};
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+  line-height: 18px;
+
+  &:hover {
+    color: ${s("text")};
+  }
+
+  @media print {
+    display: none;
+  }
+`;
+
+export default DocumentZoom;
