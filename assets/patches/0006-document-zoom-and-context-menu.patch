diff --git a/app/scenes/Document/components/DocumentEditorContextMenu.tsx b/app/scenes/Document/components/DocumentEditorContextMenu.tsx
new file mode 100644
index 0000000..d7a5896
--- /dev/null
+++ b/app/scenes/Document/components/DocumentEditorContextMenu.tsx
@@ -0,0 +1,369 @@
+/**
+ * Right-click menu for the document area (title and editor), built on the
+ * action system. Shift+right-click keeps the browser's own menu; on mobile the
+ * native long-press menu is used. The ContextMenu key and Shift+F10 open the
+ * menu at the caret. The menu scales with the document zoom (patch 0006).
+ *
+ * VERSION: 1.0 (2026-10-11) — KMS patch 0006
+ */
+import { observer } from "mobx-react";
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import styled from "styled-components";
+import { isCode } from "@shared/editor/lib/isCode";
+import type Document from "~/models/Document";
+import { actionToMenuItem, resolve } from "~/actions";
+import {
+  createDocumentEditorMenuAction,
+  type DocumentEditorMenuTarget,
+} from "~/actions/definitions/documentEditor";
+import { toMenuItems } from "~/components/Menu/transformer";
+import { Menu, MenuContent, MenuTrigger } from "~/components/primitives/Menu";
+import { MenuProvider } from "~/components/primitives/Menu/MenuContext";
+import type { Editor as TEditor } from "~/editor";
+import useActionContext, {
+  ActionContextProvider,
+} from "~/hooks/useActionContext";
+import { useComputed } from "~/hooks/useComputed";
+import { useDocumentActiveModels } from "~/hooks/useDocumentActiveModels";
+import useMobile from "~/hooks/useMobile";
+import type { ActionVariant } from "~/types";
+import { preventDefault } from "~/utils/events";
+
+type Props = {
+  /** The document shown in the area. */
+  document: Document;
+  /** The editor of the document body. */
+  editorRef: React.RefObject<TEditor | null>;
+  /** Whether the document is shown read-only. */
+  readOnly: boolean;
+  /** Whether this is the public shared view. */
+  isShare: boolean;
+  /** Permissions of the current user on the document. */
+  abilities: Record<string, boolean>;
+  /** Whether the table of contents is shown. */
+  tocShown: boolean;
+  /** Shows or hides the table of contents. */
+  onChangeTocShown: (shown: boolean) => void;
+  /** The document area (title and editor). */
+  children: React.ReactNode;
+};
+
+/** How long a native contextmenu right after a keyboard open is ignored. */
+const KEYBOARD_ECHO_MS = 800;
+
+/**
+ * Find the position of the closest ancestor of `pos` matching `predicate`.
+ *
+ * @param doc The document.
+ * @param pos A position inside the document.
+ * @param predicate The node test.
+ * @returns The position before the matching node, or null.
+ */
+function findAncestorPos(
+  doc: ProsemirrorNode,
+  pos: number,
+  predicate: (node: ProsemirrorNode) => boolean
+): number | null {
+  const $pos = doc.resolve(Math.max(0, Math.min(pos, doc.content.size)));
+  for (let depth = $pos.depth; depth > 0; depth--) {
+    if (predicate($pos.node(depth))) {
+      return $pos.before(depth);
+    }
+  }
+  return null;
+}
+
+function DocumentEditorContextMenuInner({
+  document,
+  editorRef,
+  readOnly,
+  isShare,
+  abilities,
+  tocShown,
+  onChangeTocShown,
+  children,
+}: Props) {
+  const { t } = useTranslation();
+  const isMobile = useMobile();
+  const actionContext = useActionContext({ isMenu: true });
+  const [open, setOpen] = React.useState(false);
+  const [target, setTarget] = React.useState<DocumentEditorMenuTarget | null>(
+    null
+  );
+  const [host, setHost] = React.useState<HTMLDivElement | null>(null);
+  const keyboardOpenAt = React.useRef(0);
+  const keyboardPending = React.useRef(false);
+
+  const limited = isShare || !abilities.update;
+
+  const buildTarget = React.useCallback(
+    (event: React.MouseEvent): DocumentEditorMenuTarget => {
+      const editor = editorRef.current;
+      const view = editor?.view;
+      const element =
+        event.target instanceof Element ? event.target : undefined;
+      const inEditor = !!view && !!element && view.dom.contains(element);
+      const fromKeyboard = keyboardPending.current;
+      keyboardPending.current = false;
+
+      let pos: number | null = null;
+      let inside = -1;
+      if (inEditor && view) {
+        if (fromKeyboard) {
+          pos = view.state.selection.head;
+        } else {
+          const found = view.posAtCoords({
+            left: event.clientX,
+            top: event.clientY,
+          });
+          pos = found ? found.pos : view.state.selection.head;
+          inside = found?.inside ?? -1;
+        }
+      }
+
+      let tableCellPos: number | null = null;
+      let imagePos: number | null = null;
+      let codePos: number | null = null;
+      let headingPos: number | null = null;
+      let blockDir: "rtl" | "ltr" | null = null;
+
+      if (view && pos !== null) {
+        const { doc } = view.state;
+        tableCellPos = findAncestorPos(doc, pos, (node) => {
+          const role = node.type.spec.tableRole;
+          return role === "cell" || role === "header_cell";
+        });
+        codePos = findAncestorPos(doc, pos, isCode);
+
+        const image = element?.closest("img");
+        const candidates = [inside];
+        if (image && view.dom.contains(image)) {
+          try {
+            const domPos = view.posAtDOM(image, 0);
+            candidates.push(domPos, domPos - 1);
+          } catch {
+            // The image is not part of the document (e.g. a widget).
+          }
+        }
+        imagePos =
+          candidates.find(
+            (candidate) =>
+              candidate >= 0 && doc.nodeAt(candidate)?.type.name === "image"
+          ) ?? null;
+
+        doc.descendants((node, nodePos) => {
+          if (nodePos > pos!) {
+            return false;
+          }
+          if (node.type.name === "heading") {
+            headingPos = nodePos;
+          }
+          return true;
+        });
+
+        const dir = doc.resolve(pos).parent.attrs.dir;
+        blockDir = dir === "rtl" || dir === "ltr" ? dir : null;
+      }
+
+      const domSelection = window.getSelection();
+      const savedRange =
+        domSelection && domSelection.rangeCount > 0
+          ? domSelection.getRangeAt(0).cloneRange()
+          : null;
+      const editableElement = element?.closest<HTMLElement>(
+        '[contenteditable="true"]'
+      );
+      const selectionText = domSelection?.toString() ?? "";
+      const hasSelection =
+        inEditor && view
+          ? !view.state.selection.empty
+          : selectionText.length > 0;
+
+      const restoreSelection = () => {
+        if (inEditor && view && view.editable) {
+          view.focus();
+          return;
+        }
+        editableElement?.focus({ preventScroll: true });
+        if (savedRange) {
+          const selection = window.getSelection();
+          selection?.removeAllRanges();
+          selection?.addRange(savedRange);
+        }
+      };
+
+      return {
+        document,
+        editor: editor ?? null,
+        inEditor,
+        pos,
+        editable: !!view?.editable && !readOnly,
+        limited,
+        isShare,
+        canUpdate: !!abilities.update,
+        canComment: !!abilities.comment,
+        hasSelection,
+        selectionText,
+        titleEditable: !inEditor && !!editableElement && !readOnly,
+        restoreSelection,
+        tableCellPos,
+        imagePos,
+        codePos,
+        headingPos,
+        blockDir,
+        tocShown,
+        setTocShown: onChangeTocShown,
+      };
+    },
+    [
+      editorRef,
+      document,
+      readOnly,
+      limited,
+      isShare,
+      abilities.update,
+      abilities.comment,
+      tocShown,
+      onChangeTocShown,
+    ]
+  );
+
+  const handleContextMenuCapture = React.useCallback(
+    (event: React.MouseEvent) => {
+      if (isMobile) {
+        return;
+      }
+      // Shift+right-click: leave the event to the browser's own menu.
+      if (event.shiftKey) {
+        event.stopPropagation();
+        return;
+      }
+      // A browser that also fires its own contextmenu for the key press.
+      if (
+        event.isTrusted &&
+        !keyboardPending.current &&
+        Date.now() - keyboardOpenAt.current < KEYBOARD_ECHO_MS
+      ) {
+        event.preventDefault();
+        event.stopPropagation();
+        return;
+      }
+      setTarget(buildTarget(event));
+    },
+    [isMobile, buildTarget]
+  );
+
+  const handleKeyDown = React.useCallback(
+    (event: React.KeyboardEvent) => {
+      if (
+        isMobile ||
+        !(event.key === "ContextMenu" || (event.shiftKey && event.key === "F10"))
+      ) {
+        return;
+      }
+      const element =
+        event.target instanceof HTMLElement ? event.target : undefined;
+      if (!element) {
+        return;
+      }
+      event.preventDefault();
+      const view = editorRef.current?.view;
+      let x: number;
+      let y: number;
+      if (view && view.dom.contains(element)) {
+        const coords = view.coordsAtPos(view.state.selection.head);
+        x = coords.left;
+        y = coords.bottom;
+      } else {
+        const rect = element.getBoundingClientRect();
+        x = rect.left + Math.min(16, rect.width / 2);
+        y = rect.top + Math.min(16, rect.height / 2);
+      }
+      keyboardPending.current = true;
+      keyboardOpenAt.current = Date.now();
+      element.dispatchEvent(
+        new MouseEvent("contextmenu", {
+          bubbles: true,
+          cancelable: true,
+          clientX: x,
+          clientY: y,
+          button: 2,
+        })
+      );
+      keyboardPending.current = false;
+    },
+    [isMobile, editorRef]
+  );
+
+  const menuItems = useComputed(() => {
+    if (!open || !target) {
+      return [];
+    }
+    const root = createDocumentEditorMenuAction(target);
+    return resolve<ActionVariant[]>(root.children, actionContext).map(
+      (action) => actionToMenuItem(action, actionContext)
+    );
+  }, [open, target, actionContext]);
+
+  const content = open ? toMenuItems(menuItems) : null;
+
+  return (
+    <MenuProvider variant="context" container={host}>
+      <Menu open={open} onOpenChange={setOpen}>
+        <MenuTrigger disabled={isMobile}>
+          <Area
+            onContextMenuCapture={handleContextMenuCapture}
+            onKeyDown={handleKeyDown}
+          >
+            {children}
+            <MenuHost ref={setHost} />
+          </Area>
+        </MenuTrigger>
+        <MenuContent
+          aria-label={t("Document")}
+          onCloseAutoFocus={preventDefault}
+        >
+          {content}
+        </MenuContent>
+      </Menu>
+    </MenuProvider>
+  );
+}
+
+/**
+ * Wraps the document area in its right-click menu.
+ */
+function DocumentEditorContextMenu(props: Props) {
+  const activeModels = useDocumentActiveModels(props.document);
+
+  return (
+    <ActionContextProvider value={{ activeModels }}>
+      <DocumentEditorContextMenuInner {...props} />
+    </ActionContextProvider>
+  );
+}
+
+/** Takes no box of its own, so the document layout is unchanged. */
+const Area = styled.div`
+  display: contents;
+`;
+
+/**
+ * Menus are portaled here: the host undoes the document zoom so they are
+ * positioned in viewport px, and their content is zoomed again (patch 0006).
+ */
+const MenuHost = styled.div`
+  zoom: calc(1 / var(--kms-doc-zoom, 1));
+
+  & > * > * {
+    zoom: var(--kms-doc-zoom, 1);
+  }
+
+  @media print {
+    display: none;
+  }
+`;
+
+export default observer(DocumentEditorContextMenu);
