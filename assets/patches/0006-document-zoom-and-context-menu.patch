+/**
+ * Document and interface zoom helpers.
+ *
+ * VERSION: 1.0 (2026-10-11) — KMS patch 0006
+ */
+
+/** CSS custom property holding the view-only zoom of the open document. */
+export const DOC_ZOOM_VAR = "--kms-doc-zoom";
+
+/** Smallest document zoom. */
+export const DOC_ZOOM_MIN = 0.5;
+
+/** Largest document zoom. */
+export const DOC_ZOOM_MAX = 2;
+
+/** Step used by the mouse wheel and the keyboard. */
+export const DOC_ZOOM_STEP = 0.1;
+
+/** Choices offered for the sidebar ("interface") zoom in Preferences. */
+export const INTERFACE_ZOOM_CHOICES = [0.8, 0.9, 1, 1.1, 1.25, 1.5] as const;
+
+/** Smallest accepted interface zoom, shared with the API validation. */
+export const INTERFACE_ZOOM_MIN = 0.8;
+
+/** Largest accepted interface zoom, shared with the API validation. */
+export const INTERFACE_ZOOM_MAX = 1.5;
+
+/**
+ * Clamp a document zoom to the allowed range and round it to whole percent.
+ *
+ * @param zoom The requested zoom factor.
+ * @returns The zoom factor within range, rounded to 1%.
+ */
+export function clampDocZoom(zoom: number): number {
+  if (!Number.isFinite(zoom)) {
+    return 1;
+  }
+  const rounded = Math.round(zoom * 100) / 100;
+  return Math.min(DOC_ZOOM_MAX, Math.max(DOC_ZOOM_MIN, rounded));
+}
+
+/**
+ * Move one step up or down from the current zoom, snapped to the step grid
+ * (for example 1.07 steps up to 1.1 and down to 1.0).
+ *
+ * @param zoom The current zoom factor.
+ * @param direction 1 to zoom in, -1 to zoom out.
+ * @returns The next zoom factor on the grid, clamped to the range.
+ */
+export function stepDocZoom(zoom: number, direction: 1 | -1): number {
+  const steps = zoom / DOC_ZOOM_STEP;
+  const epsilon = 1e-6;
+  const next =
+    direction > 0
+      ? Math.floor(steps + epsilon) + 1
+      : Math.ceil(steps - epsilon) - 1;
+  return clampDocZoom(next * DOC_ZOOM_STEP);
+}
+
+/**
+ * Read the document zoom that applies to an element, from the inherited CSS
+ * custom property. Elements outside a zoomed document return 1.
+ *
+ * @param el The element to read from.
+ * @returns The zoom factor, 1 when unset.
+ */
+export function getDocZoom(el?: Element | null): number {
+  if (!el || typeof window === "undefined") {
+    return 1;
+  }
+  const value = parseFloat(
+    window.getComputedStyle(el).getPropertyValue(DOC_ZOOM_VAR)
+  );
+  return Number.isFinite(value) && value > 0 ? value : 1;
+}
