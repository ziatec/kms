From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dev <dev@local>
Date: Fri, 16 Oct 2026 12:30:00 +0330
Subject: [PATCH 23/23] feat(license): vendor public key compiled into the server,
 no runtime file and no environment override

VERSION: 1.0 (2026-10-16)
Root: build/outline-1.11.0 (apply after 0001..0022)

Until now the server read the vendor's public key from
<app>/kms-license/vendor-public.json (or the path in KMS_LICENSE_VENDOR_KEY).
Whoever controls the server could replace that file with their own key and
sign their own activation codes. The key is now imported from
server/license/vendorKey.ts, which install.sh writes from
assets/license/vendor-public.json just before "yarn build", so it ends up in
the compiled JavaScript. The file is NOT part of this patch (it is generated
per vendor); a development checkout without it does not compile.

Files (1; M = modified):
  M server/license/state.ts

---
---

diff --git a/server/license/state.ts b/server/license/state.ts
index b29bc27..5566073 100644
--- a/server/license/state.ts
+++ b/server/license/state.ts
@@ -9,10 +9,12 @@
  *   server-pub.pem, server-box.pem, hardware.json
  * Files written by the app:
  *   $KMS_LICENSE_DATA_DIR (/var/lib/kms-license): license.kmslic, state.json
- * The vendor's public keys are part of the build:
- *   $KMS_LICENSE_VENDOR_KEY (<app>/kms-license/vendor-public.json)
+ * The vendor's public keys are compiled into the build (server/license/vendorKey.ts,
+ * written by the installer from assets/license/vendor-public.json before the
+ * build). There is no runtime file and no environment override, so a customer
+ * cannot swap in their own key.
  *
- * VERSION: 1.1 (2026-10-12) — KMS patch 0008
+ * VERSION: 1.2 (2026-10-16) — KMS patch 0008; 1.2 = embedded vendor key (patch 0023)
  */
 import { createHash, createPublicKey, type KeyObject } from "node:crypto";
 import fs from "node:fs";
@@ -32,6 +34,7 @@ import {
   type LicensePayload,
   type RequestPayload,
 } from "./format";
+import { VENDOR_PUBLIC_KEY } from "./vendorKey";
 
 export type LicenseStatus =
   | "active"
@@ -76,9 +79,8 @@ const LAST_SEEN_STEP_MS = 60 * 60 * 1000;
 const configDir = () =>
   process.env.KMS_LICENSE_CONFIG_DIR || "/etc/kms-license";
 const dataDir = () => process.env.KMS_LICENSE_DATA_DIR || "/var/lib/kms-license";
-const vendorKeyPath = () =>
-  process.env.KMS_LICENSE_VENDOR_KEY ||
-  path.resolve(process.cwd(), "kms-license", "vendor-public.json");
+// KMS patch 0023: the vendor key comes from the compiled code only.
+const vendorKey = () => VENDOR_PUBLIC_KEY as Parameters<typeof loadVendorKeys>[0] | null;
 const hostMachineIdPath = () =>
   process.env.KMS_LICENSE_HOST_MACHINE_ID || "/etc/kms-host-machine-id";
 const licensePath = () => path.join(dataDir(), "license.kmslic");
@@ -268,7 +270,7 @@ function compute(): LicenseInfo {
     trialDays: TRIAL_DAYS,
   };
   const identity = loadIdentity();
-  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  const vendorJson = vendorKey();
   if (!identity || !vendorJson) {
     // A development checkout has no installer files and is not limited.
     return {
@@ -277,7 +279,7 @@ function compute(): LicenseInfo {
       readOnly: process.env.NODE_ENV === "production",
       reason: !identity
         ? `installer license files are missing in ${configDir()}`
-        : `vendor public key is missing (${vendorKeyPath()})`,
+        : "vendor public key is not built into this server",
     };
   }
   base.installId = identity.installId;
@@ -416,7 +418,7 @@ export function createLicenseRequest(meta: {
   requested?: { days?: number; note?: string };
 }) {
   const identity = loadIdentity();
-  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  const vendorJson = vendorKey();
   if (!identity || !vendorJson) {
     throw new Error("the installer license files or the vendor key are missing");
   }
@@ -470,7 +472,7 @@ export function createLicenseRequest(meta: {
  */
 export function applyLicense(text: string): LicenseInfo {
   const identity = loadIdentity();
-  const vendorJson = readJson<Parameters<typeof loadVendorKeys>[0]>(vendorKeyPath());
+  const vendorJson = vendorKey();
   if (!identity || !vendorJson) {
     throw new Error("the installer license files or the vendor key are missing");
   }
