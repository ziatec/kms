--- /dev/null
+++ b/shared/editor/queries/getListDirection.test.ts
@@ -0,0 +1,50 @@
+import { parser } from "../../test/editor";
+import { getListDirection } from "./getListDirection";
+
+const RLM = "‏";
+
+/**
+ * Parses Markdown and returns its first block, expected to be a list.
+ *
+ * @param markdown the Markdown text.
+ * @returns the list node.
+ */
+function firstList(markdown: string) {
+  const list = parser.parse(markdown)?.firstChild;
+  if (!list) {
+    throw new Error("no list");
+  }
+  return list;
+}
+
+describe("getListDirection", () => {
+  it("is right-to-left when the first item is Persian", () => {
+    expect(getListDirection(firstList("1. سلام\n2. hello"))).toBe("rtl");
+  });
+
+  it("is left-to-right when the first item is English", () => {
+    expect(getListDirection(firstList("1. Hello\n2. سلام"))).toBe("ltr");
+  });
+
+  it("uses the explicit direction of the first item", () => {
+    expect(getListDirection(firstList(`1. ${RLM}Outline یک ویکی است`))).toBe(
+      "rtl"
+    );
+  });
+
+  it("skips items without letters", () => {
+    expect(getListDirection(firstList("- 123\n- سلام"))).toBe("rtl");
+  });
+
+  it("is not changed by a nested list of the other direction", () => {
+    const outer = firstList("1. Hello\n   1. سلام");
+    const nested = outer.firstChild?.child(1);
+
+    expect(getListDirection(outer)).toBe("ltr");
+    expect(nested && getListDirection(nested)).toBe("rtl");
+  });
+
+  it("has no direction while the list is empty", () => {
+    expect(getListDirection(firstList("1. 42"))).toBeNull();
+  });
+});
