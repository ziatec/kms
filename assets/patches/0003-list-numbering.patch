--- /dev/null
+++ b/shared/editor/queries/getListDirection.ts
@@ -0,0 +1,84 @@
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import type { EditorState } from "prosemirror-state";
+import type { TextDirection } from "../../utils/bidi";
+import { toTextDirection } from "../../utils/bidi";
+import { isRTL } from "../../utils/rtl";
+import { findParentNode } from "./findParentNode";
+
+/** Names of the list nodes that are laid out in their own direction. */
+export const listNodeNames = new Set([
+  "ordered_list",
+  "bullet_list",
+  "checkbox_list",
+]);
+
+/** Matches any letter, used to tell left-to-right text from no text. */
+const letter = /\p{L}/u;
+
+/**
+ * Returns the direction of a text block: its explicit direction when one is
+ * set, otherwise the direction of its first strong character, as `dir="auto"`
+ * does.
+ *
+ * @param node the text block, e.g. a paragraph or heading.
+ * @returns "rtl" or "ltr", or null when the block has no letters.
+ */
+export function getBlockDirection(node: ProsemirrorNode): TextDirection | null {
+  const explicit = toTextDirection(node.attrs.dir);
+  if (explicit) {
+    return explicit;
+  }
+  const text = node.textContent;
+  if (isRTL(text)) {
+    return "rtl";
+  }
+  return letter.test(text) ? "ltr" : null;
+}
+
+/**
+ * Returns the direction of a list, taken from its first item that has text.
+ * Only the item's own blocks are read; nested lists have their own direction.
+ *
+ * @param list the list node.
+ * @returns "rtl" or "ltr", or null when no item has text yet.
+ */
+export function getListDirection(list: ProsemirrorNode): TextDirection | null {
+  for (let i = 0; i < list.childCount; i++) {
+    const item = list.child(i);
+    for (let j = 0; j < item.childCount; j++) {
+      const block = item.child(j);
+      if (listNodeNames.has(block.type.name) || !block.isTextblock) {
+        continue;
+      }
+      const dir = getBlockDirection(block);
+      if (dir) {
+        return dir;
+      }
+    }
+  }
+  return null;
+}
+
+/**
+ * Returns the closest numbered list around the selection.
+ *
+ * @param state the editor state.
+ * @returns the list and its position, or undefined.
+ */
+export function findOrderedList(state: EditorState) {
+  return findParentNode((node) => node.type.name === "ordered_list")(
+    state.selection
+  );
+}
+
+/**
+ * Returns a function that tests whether the numbered list around the
+ * selection has the given style, for use as a menu item's `active` state.
+ *
+ * @param listStyle the list style, e.g. "number-paren".
+ * @returns a predicate over the editor state.
+ */
+export function isListStyleActive(listStyle: string) {
+  return (state: EditorState): boolean =>
+    findOrderedList(state)?.node.attrs.listStyle === listStyle;
+}
