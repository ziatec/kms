+
+/**
+ * Numbered styles with another suffix than a period: "1)" and "1-". They are
+ * written as a data attribute rather than a list-style-type, as the CSS picks
+ * Persian or Western digits from the direction of the list.
+ */
+const NUMBER_STYLES = ["number-paren", "number-dash"];
+
+/** The number styles offered in the menu: "1.", "1)" and "1-". */
+export const NUMBER_STYLE_CHOICES = ["number", "number-paren", "number-dash"];
+
+/** The suffixes typed after a number to start a list, by list style. */
+const SUFFIX_STYLES: Record<string, string> = {
+  ".": "number",
+  ")": "number-paren",
+  "-": "number-dash",
+};
+
+const persianDigits = "۰۱۲۳۴۵۶۷۸۹";
+const arabicDigits = "٠١٢٣٤٥٦٧٨٩";
+
+/**
+ * Parses a number written in Western, Persian or Arabic-Indic digits.
+ *
+ * @param text the digits, e.g. "12", "۱۲" or "١٢".
+ * @returns the number.
+ */
+function parseDigits(text: string): number {
+  return parseInt(
+    text
+      .replace(/[۰-۹]/g, (digit) => String(persianDigits.indexOf(digit)))
+      .replace(/[٠-٩]/g, (digit) => String(arabicDigits.indexOf(digit))),
+    10
+  );
+}
+
+/**
+ * Sets the number style of the numbered list around the selection.
+ *
+ * @param attrs the command attributes, e.g. `{ listStyle: "number-dash" }`.
+ * @returns the command.
+ */
+function setListStyle(attrs: unknown): Command {
+  return (state, dispatch) => {
+    const listStyle =
+      attrs && typeof attrs === "object" && "listStyle" in attrs
+        ? attrs.listStyle
+        : null;
+    if (
+      typeof listStyle !== "string" ||
+      !NUMBER_STYLE_CHOICES.includes(listStyle)
+    ) {
+      return false;
+    }
+    const list = findOrderedList(state);
+    if (!list) {
+      return false;
+    }
+    if (list.node.attrs.listStyle !== listStyle) {
+      dispatch?.(
+        state.tr.setNodeMarkup(list.pos, undefined, {
+          ...list.node.attrs,
+          listStyle,
+        })
+      );
+    }
+    return true;
+  };
+}
+
+/**
+ * Returns the first text node inside a node.
+ *
+ * @param node the node to search.
+ * @returns the first text node, or null.
+ */
+function firstText(node: ProsemirrorNode): ProsemirrorNode | null {
+  if (node.isText) {
+    return node;
+  }
+  for (let i = 0; i < node.childCount; i++) {
+    const found = firstText(node.child(i));
+    if (found) {
+      return found;
+    }
+  }
+  return null;
+}
+
+/**
+ * Builds decorations that give the number of each list item the font and size
+ * of the item's text, set with the text style mark, through CSS variables read
+ * by the ::marker rule in the editor styles.
+ *
+ * @param doc the document.
+ * @returns the decorations.
+ */
+function buildMarkerDecorations(doc: ProsemirrorNode): DecorationSet {
+  const decorations: Decoration[] = [];
+
+  doc.descendants((node, pos) => {
+    if (node.type.name !== "ordered_list") {
+      return true;
+    }
+    node.forEach((item, offset) => {
+      const from = pos + 1 + offset;
+      const text = item.firstChild ? firstText(item.firstChild) : null;
+      const style = text?.marks.find(
+        (m) => m.type.name === "text_style"
+      )?.attrs;
+      const font = style?.fontFamily ? fontFamilies[style.fontFamily] : null;
+      const size = style?.fontSize;
+      if (font || size) {
+        decorations.push(
+          Decoration.node(from, from + item.nodeSize, {
+            "data-marker-style": "",
+            style: [
+              `--marker-font: ${font ? font.css : "initial"}`,
+              `--marker-size: ${size ? `${size}px` : "initial"}`,
+            ].join("; "),
+          })
+        );
+      }
+    });
+    return true;
+  });
+
+  return DecorationSet.create(doc, decorations);
+}
 
