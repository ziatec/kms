+import { findNodes, parser, serializer } from "../../test/editor";
+
+describe("OrderedList", () => {
+  it("reads and writes a list numbered with parentheses", () => {
+    const markdown = "1) one\n2) two";
+    const [list] = findNodes(parser.parse(markdown)?.toJSON(), "ordered_list");
+
+    expect(list?.attrs?.listStyle).toBe("number-paren");
+    expect(serializer.serialize(parser.parse(markdown)).trim()).toBe(markdown);
+  });
+
+  it("keeps lists numbered with periods", () => {
+    const [list] = findNodes(
+      parser.parse("1. one\n2. two")?.toJSON(),
+      "ordered_list"
+    );
+
+    expect(list?.attrs?.listStyle).toBe("number");
+  });
+});
