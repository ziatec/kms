+type Props = {
+  /** The number and suffix shown, e.g. "1)" or "۱-". */
+  label: string;
+  /** The direction of the list, so the suffix is placed as in the text. */
+  dir?: "rtl" | "ltr";
+  /** The size of the icon, 24px is default to match standard icons. */
+  size?: number;
+  /** The color of the icon, defaults to the current text color. */
+  color?: string;
+};
+
+/**
+ * An icon showing a list number with its suffix, for the number style menu.
+ */
+export default function ListStyleIcon({
+  label,
+  dir = "ltr",
+  size = 24,
+  color = "currentColor",
+}: Props) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden>
+      <text
+        x="12"
+        y="16.5"
+        textAnchor="middle"
+        fontSize="12"
+        fontWeight="600"
+        fill={color}
+        direction={dir}
+      >
+        {label}
+      </text>
+    </svg>
+  );
+}
