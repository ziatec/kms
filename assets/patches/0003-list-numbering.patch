diff --git a/shared/editor/extensions/ListDirection.ts b/shared/editor/extensions/ListDirection.ts
new file mode 100644
index 0000000..6f8a933
--- /dev/null
+++ b/shared/editor/extensions/ListDirection.ts
@@ -0,0 +1,61 @@
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import { Plugin, PluginKey } from "prosemirror-state";
+import { Decoration, DecorationSet } from "prosemirror-view";
+import Extension from "../lib/Extension";
+import { getListDirection, listNodeNames } from "../queries/getListDirection";
+
+const pluginKey = new PluginKey<DecorationSet>("listDirection");
+
+/**
+ * Builds decorations that give every list the `dir` attribute of its own
+ * first item with text.
+ *
+ * @param doc the document.
+ * @returns the decorations.
+ */
+function buildDecorations(doc: ProsemirrorNode): DecorationSet {
+  const decorations: Decoration[] = [];
+
+  doc.descendants((node, pos) => {
+    if (node.isTextblock) {
+      return false;
+    }
+    if (listNodeNames.has(node.type.name)) {
+      const dir = getListDirection(node);
+      if (dir) {
+        decorations.push(Decoration.node(pos, pos + node.nodeSize, { dir }));
+      }
+    }
+    return true;
+  });
+
+  return DecorationSet.create(doc, decorations);
+}
+
+/**
+ * Lays out each list in the direction of its own first item, so that the
+ * numbers or bullets of a right-to-left list are on the right and those of a
+ * left-to-right list on the left, whatever the direction of the page, of the
+ * other items or of nested lists. A list without text yet follows the page.
+ */
+export default class ListDirection extends Extension {
+  get name() {
+    return "list_direction";
+  }
+
+  get plugins() {
+    return [
+      new Plugin<DecorationSet>({
+        key: pluginKey,
+        state: {
+          init: (_, state) => buildDecorations(state.doc),
+          apply: (tr, value) =>
+            tr.docChanged ? buildDecorations(tr.doc) : value,
+        },
+        props: {
+          decorations: (state) => pluginKey.getState(state),
+        },
+      }),
+    ];
+  }
+}
