diff --git a/app/utils/fontNames.ts b/app/utils/fontNames.ts
new file mode 100644
index 0000000..af97997
--- /dev/null
+++ b/app/utils/fontNames.ts
@@ -0,0 +1,29 @@
+import i18n from "i18next";
+import { fontFamilies } from "@shared/utils/textStyle";
+import names from "../../public/fonts/names.json";
+
+/** Font names by font key and language, e.g. { vazirmatn: { fa: "وزیرمتن" } }. */
+const localizedNames: Record<string, Record<string, string>> = names;
+
+/**
+ * Returns the name of a font in the interface language. Names come from
+ * public/fonts/names.json, keyed by language ("fa") or locale ("fa_IR"); a
+ * font without a name for the language shows its own (English) name.
+ *
+ * @param key the font family key, e.g. "vazirmatn".
+ * @param language the language, defaults to the interface language.
+ * @returns the localized font name.
+ */
+export function getFontLabel(
+  key: string,
+  language: string = i18n.language ?? ""
+): string {
+  const entry = localizedNames[key];
+  const locale = language.replace("-", "_");
+  return (
+    entry?.[locale] ??
+    entry?.[locale.split("_")[0]] ??
+    fontFamilies[key]?.label ??
+    key
+  );
+}
