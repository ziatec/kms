diff --git a/shared/editor/marks/TextStyle.ts b/shared/editor/marks/TextStyle.ts
new file mode 100644
index 0000000..6175ad3
--- /dev/null
+++ b/shared/editor/marks/TextStyle.ts
@@ -0,0 +1,166 @@
+import type { MarkSpec, MarkType } from "prosemirror-model";
+import type { Command } from "prosemirror-state";
+import type { TextStyleAttrs } from "../../utils/textStyle";
+import {
+  fontFamilies,
+  toFontFamily,
+  toFontSize,
+  toTextColor,
+  toPastedTextStyle,
+} from "../../utils/textStyle";
+import { isInCode } from "../queries/isInCode";
+import Mark from "./Mark";
+
+/** Marks spans written by the editor, as opposed to pasted ones. */
+const dataAttribute = "data-text-style";
+
+/**
+ * A mark for the font, size and color of a piece of text. All three are
+ * optional; a missing value leaves the default look.
+ */
+export default class TextStyle extends Mark {
+  get name() {
+    return "text_style";
+  }
+
+  get schema(): MarkSpec {
+    return {
+      attrs: {
+        fontFamily: {
+          default: null,
+          validate: (v: unknown) => v === null || toFontFamily(v) === v,
+        },
+        fontSize: {
+          default: null,
+          validate: (v: unknown) => v === null || toFontSize(v) === v,
+        },
+        color: {
+          default: null,
+          validate: (v: unknown) => v === null || toTextColor(v) === v,
+        },
+      },
+      parseDOM: [
+        {
+          tag: "span[style]",
+          consuming: false,
+          getAttrs: (dom) => {
+            const attrs: TextStyleAttrs = {
+              fontFamily: toFontFamily(dom.style.fontFamily),
+              fontSize: toFontSize(dom.style.fontSize),
+              color: toTextColor(dom.style.color),
+            };
+            // Spans written by the editor are marked and keep every value;
+            // styles pasted from elsewhere, e.g. black 11pt Arial from a word
+            // processor, are kept only when they match a value in the menus.
+            const result = dom.hasAttribute(dataAttribute)
+              ? attrs
+              : toPastedTextStyle(attrs);
+            return result.fontFamily || result.fontSize || result.color
+              ? result
+              : false;
+          },
+        },
+      ],
+      toDOM: (mark) => {
+        const { fontFamily, fontSize, color } = mark.attrs;
+        const style = [
+          fontFamily && fontFamilies[fontFamily]
+            ? `font-family: ${fontFamilies[fontFamily].css}`
+            : "",
+          fontSize ? `font-size: ${fontSize}px` : "",
+          color ? `color: ${color}` : "",
+        ]
+          .filter(Boolean)
+          .join("; ");
+        return ["span", { style, [dataAttribute]: "" }, 0];
+      },
+    };
+  }
+
+  commands({ type }: { type: MarkType }) {
+    return {
+      setTextStyle: (attrs?: unknown) => setTextStyle(type, attrs),
+    };
+  }
+
+  toMarkdown() {
+    // Markdown has no way to express font, size or color.
+    return {
+      open: "",
+      close: "",
+      mixable: true,
+      expelEnclosingWhitespace: true,
+    };
+  }
+}
+
+/**
+ * Changes the font, size or color of the selected text, or of the text typed
+ * next at a bare cursor. A value that is present in `attrs` replaces the old
+ * one, and null clears it; values that are absent are kept.
+ *
+ * @param type the text style mark type.
+ * @param attrs the changes, e.g. `{ fontSize: 18 }`.
+ * @returns the command.
+ */
+function setTextStyle(type: MarkType, attrs: unknown): Command {
+  const input = (attrs && typeof attrs === "object" ? attrs : {}) as Record<
+    string,
+    unknown
+  >;
+  const merge = (
+    old: Partial<TextStyleAttrs> | undefined
+  ): TextStyleAttrs | null => {
+    const next: TextStyleAttrs = {
+      fontFamily: old?.fontFamily ?? null,
+      fontSize: old?.fontSize ?? null,
+      color: old?.color ?? null,
+    };
+    if ("fontFamily" in input) {
+      next.fontFamily = toFontFamily(input.fontFamily);
+    }
+    if ("fontSize" in input) {
+      next.fontSize = toFontSize(input.fontSize);
+    }
+    if ("color" in input) {
+      next.color = toTextColor(input.color);
+    }
+    return next.fontFamily || next.fontSize || next.color ? next : null;
+  };
+
+  return (state, dispatch) => {
+    if (isInCode(state)) {
+      return false;
+    }
+    const tr = state.tr;
+    const { selection } = state;
+
+    if (selection.empty) {
+      const marks = state.storedMarks ?? selection.$from.marks();
+      const next = merge(marks.find((m) => m.type === type)?.attrs);
+      const others = marks.filter((m) => m.type !== type);
+      tr.setStoredMarks(next ? [...others, type.create(next)] : others);
+    } else {
+      for (const range of selection.ranges) {
+        const from = range.$from.pos;
+        const to = range.$to.pos;
+        state.doc.nodesBetween(from, to, (node, pos) => {
+          if (!node.isInline) {
+            return true;
+          }
+          const start = Math.max(pos, from);
+          const end = Math.min(pos + node.nodeSize, to);
+          const next = merge(node.marks.find((m) => m.type === type)?.attrs);
+          tr.removeMark(start, end, type);
+          if (next) {
+            tr.addMark(start, end, type.create(next));
+          }
+          return false;
+        });
+      }
+    }
+
+    dispatch?.(tr);
+    return true;
+  };
+}
