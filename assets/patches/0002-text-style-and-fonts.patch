diff --git a/shared/editor/queries/getTextStyle.ts b/shared/editor/queries/getTextStyle.ts
new file mode 100644
index 0000000..4444b2f
--- /dev/null
+++ b/shared/editor/queries/getTextStyle.ts
@@ -0,0 +1,38 @@
+import type { Mark } from "prosemirror-model";
+import type { EditorState } from "prosemirror-state";
+import type { TextStyleAttrs } from "../../utils/textStyle";
+
+/**
+ * Returns the text style mark at the cursor, or on the first text in the
+ * selection.
+ *
+ * @param state the editor state.
+ * @returns the mark attributes (fontFamily, fontSize, color), or null.
+ */
+export function getTextStyle(state: EditorState): TextStyleAttrs | null {
+  const type = state.schema.marks.text_style;
+  if (!type) {
+    return null;
+  }
+  const { selection } = state;
+  let marks: readonly Mark[] = [];
+
+  if (selection.empty) {
+    marks = state.storedMarks ?? selection.$from.marks();
+  } else {
+    state.doc.nodesBetween(selection.from, selection.to, (node) => {
+      if (node.isInline && !marks.length) {
+        marks = node.marks;
+      }
+      return !node.isInline;
+    });
+  }
+  const attrs = marks.find((m) => m.type === type)?.attrs;
+  return attrs
+    ? {
+        fontFamily: attrs.fontFamily ?? null,
+        fontSize: attrs.fontSize ?? null,
+        color: attrs.color ?? null,
+      }
+    : null;
+}
diff --git a/shared/utils/textStyle.test.ts b/shared/utils/textStyle.test.ts
new file mode 100644
index 0000000..fd8a34c
--- /dev/null
+++ b/shared/utils/textStyle.test.ts
@@ -0,0 +1,46 @@
+import {
+  toFontFamily,
+  toFontSize,
+  toPastedTextStyle,
+  toTextColor,
+} from "./textStyle";
+
+describe("toFontFamily", () => {
+  it("accepts keys and CSS font stacks", () => {
+    expect(toFontFamily("sahel")).toBe("sahel");
+    expect(toFontFamily("Vazirmatn, Tahoma, sans-serif")).toBe("vazirmatn");
+    expect(toFontFamily("'Times New Roman', Times, serif")).toBe("times");
+    expect(toFontFamily("Comic Sans MS")).toBeNull();
+    expect(toFontFamily("")).toBeNull();
+  });
+});
+
+describe("toFontSize", () => {
+  it("converts px and pt and keeps sizes in range", () => {
+    expect(toFontSize(18)).toBe(18);
+    expect(toFontSize("24px")).toBe(24);
+    expect(toFontSize("12pt")).toBe(16);
+    expect(toFontSize("2em")).toBeNull();
+    expect(toFontSize(200)).toBeNull();
+  });
+});
+
+describe("toTextColor", () => {
+  it("accepts hex and rgb colors", () => {
+    expect(toTextColor("#dc2626")).toBe("#DC2626");
+    expect(toTextColor("rgb(220, 38, 38)")).toBe("#DC2626");
+    expect(toTextColor("red")).toBeNull();
+    expect(toTextColor("rgb(300, 0, 0)")).toBeNull();
+  });
+});
+
+describe("toPastedTextStyle", () => {
+  it("keeps only values offered in the menus", () => {
+    expect(
+      toPastedTextStyle({ fontFamily: "arial", fontSize: 15, color: "#000000" })
+    ).toEqual({ fontFamily: null, fontSize: null, color: null });
+    expect(
+      toPastedTextStyle({ fontFamily: "sahel", fontSize: 18, color: "#DC2626" })
+    ).toEqual({ fontFamily: "sahel", fontSize: 18, color: "#DC2626" });
+  });
+});
diff --git a/shared/utils/textStyle.ts b/shared/utils/textStyle.ts
new file mode 100644
index 0000000..f57f4b7
--- /dev/null
+++ b/shared/utils/textStyle.ts
@@ -0,0 +1,158 @@
+/**
+ * Fonts, sizes and colors that text can be given with the text style mark.
+ * Only these values are accepted, so pasted content cannot inject arbitrary CSS.
+ */
+
+/**
+ * Font families by key. The first name of each stack is the font itself. Fonts
+ * without `legacy` are served from public/fonts (see index.html) so they show
+ * on any device; `legacy` ones rely on the system and are kept only so that
+ * text already styled with them still renders; they are not offered in the menu.
+ */
+export const fontFamilies: Record<
+  string,
+  { label: string; css: string; legacy?: boolean }
+> = {
+  vazirmatn: { label: "Vazirmatn", css: "Vazirmatn, Tahoma, sans-serif" },
+  sahel: { label: "Sahel", css: "Sahel, Vazirmatn, Tahoma, sans-serif" },
+  shabnam: { label: "Shabnam", css: "Shabnam, Vazirmatn, Tahoma, sans-serif" },
+  samim: { label: "Samim", css: "Samim, Vazirmatn, Tahoma, sans-serif" },
+  parastoo: {
+    label: "Parastoo",
+    css: "Parastoo, Vazirmatn, 'Times New Roman', serif",
+  },
+  inter: { label: "Inter", css: "Inter, Vazirmatn, sans-serif" },
+  tahoma: { label: "Tahoma", css: "Tahoma, sans-serif", legacy: true },
+  arial: {
+    label: "Arial",
+    css: "Arial, Helvetica, sans-serif",
+    legacy: true,
+  },
+  times: {
+    label: "Times New Roman",
+    css: "'Times New Roman', Times, serif",
+    legacy: true,
+  },
+  georgia: { label: "Georgia", css: "Georgia, serif", legacy: true },
+  courier: {
+    label: "Courier New",
+    css: "'Courier New', Courier, monospace",
+    legacy: true,
+  },
+};
+
+/** Font sizes in pixels offered in the menu. */
+export const fontSizes = [10, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48];
+
+/** Text colors offered in the menu, readable on light and dark themes. */
+export const textColors = [
+  { name: "Gray", hex: "#6B7280" },
+  { name: "Red", hex: "#DC2626" },
+  { name: "Orange", hex: "#EA580C" },
+  { name: "Green", hex: "#16A34A" },
+  { name: "Teal", hex: "#0D9488" },
+  { name: "Blue", hex: "#2563EB" },
+  { name: "Purple", hex: "#7C3AED" },
+  { name: "Pink", hex: "#DB2777" },
+];
+
+/** The values of the text style mark; null leaves the default look. */
+export interface TextStyleAttrs {
+  fontFamily: string | null;
+  fontSize: number | null;
+  color: string | null;
+}
+
+/**
+ * Keeps only the values of a pasted style that are offered in the menus, so
+ * that text pasted from elsewhere does not bring fixed colors, which can be
+ * unreadable in the dark theme, or sizes and fonts that differ from the menu.
+ *
+ * @param attrs the values read from the pasted style.
+ * @returns the values that are offered in the menus, the others null.
+ */
+export function toPastedTextStyle(attrs: TextStyleAttrs): TextStyleAttrs {
+  const { fontFamily, fontSize, color } = attrs;
+  return {
+    fontFamily:
+      fontFamily && !fontFamilies[fontFamily]?.legacy ? fontFamily : null,
+    fontSize: fontSize && fontSizes.includes(fontSize) ? fontSize : null,
+    color: color && textColors.some((c) => c.hex === color) ? color : null,
+  };
+}
+
+/**
+ * Restricts a value to a known font family key.
+ *
+ * @param value a key, or a CSS font-family value from pasted content.
+ * @returns the key, or null.
+ */
+export function toFontFamily(value: unknown): string | null {
+  if (typeof value !== "string" || !value) {
+    return null;
+  }
+  if (value in fontFamilies) {
+    return value;
+  }
+  const first = value.split(",")[0].replace(/['"]/g, "").trim().toLowerCase();
+  return (
+    Object.keys(fontFamilies).find(
+      (key) =>
+        fontFamilies[key].css
+          .split(",")[0]
+          .replace(/['"]/g, "")
+          .trim()
+          .toLowerCase() === first
+    ) ?? null
+  );
+}
+
+/**
+ * Restricts a value to a font size in pixels between 8 and 96.
+ *
+ * @param value a number, or a CSS size in px or pt.
+ * @returns the size in pixels, or null.
+ */
+export function toFontSize(value: unknown): number | null {
+  let size: number;
+  if (typeof value === "number") {
+    size = value;
+  } else if (typeof value === "string") {
+    const match = value.trim().match(/^(\d+(?:\.\d+)?)(px|pt)$/);
+    if (!match) {
+      return null;
+    }
+    size = match[2] === "pt" ? (parseFloat(match[1]) * 4) / 3 : +match[1];
+  } else {
+    return null;
+  }
+  size = Math.round(size);
+  return size >= 8 && size <= 96 ? size : null;
+}
+
+/**
+ * Restricts a value to a 6-digit hex color.
+ *
+ * @param value a hex color, or a CSS rgb() value from pasted content.
+ * @returns the upper-case hex color, or null.
+ */
+export function toTextColor(value: unknown): string | null {
+  if (typeof value !== "string") {
+    return null;
+  }
+  if (/^#[0-9a-f]{6}$/i.test(value)) {
+    return value.toUpperCase();
+  }
+  const rgb = value.match(/^rgb\(\s*(\d+),\s*(\d+),\s*(\d+)\s*\)$/);
+  if (!rgb) {
+    return null;
+  }
+  const channels = rgb.slice(1).map(Number);
+  return channels.every((c) => c <= 255)
+    ? "#" +
+        channels
+          .map((c) => c.toString(16).padStart(2, "0"))
+          .join("")
+          .toUpperCase()
+    : null;
+}
