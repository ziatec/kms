@@ -0,0 +1,51 @@
+type Props = {
+  /** Which control the icon stands for. */
+  kind: "size" | "color";
+  /** For "size", the size to show; for "color", the color of the bar. */
+  value?: string | number | null;
+  size?: number;
+};
+
+/**
+ * Icons for the font size and text color controls. The size icon shows
+ * the current size, and the color icon a bar in the current color.
+ */
+export default function TextStyleIcon({ kind, value, size = 24 }: Props) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden>
+      {kind === "color" ? (
+        <>
+          <text
+            x="12"
+            y="16"
+            textAnchor="middle"
+            fontSize="15"
+            fontWeight="700"
+            fill="currentColor"
+          >
+            A
+          </text>
+          <rect
+            x="4"
+            y="19"
+            width="16"
+            height="3"
+            rx="1"
+            fill={(value as string) || "currentColor"}
+          />
+        </>
+      ) : (
+        <text
+          x="12"
+          y="16.5"
+          textAnchor="middle"
+          fontSize={12}
+          fontWeight="700"
+          fill="currentColor"
+        >
+          {value ?? 16}
+        </text>
+      )}
+    </svg>
+  );
+}
