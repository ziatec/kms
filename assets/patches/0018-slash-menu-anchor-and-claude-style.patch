From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dev <dev@local>
Date: Thu, 15 Oct 2026 14:00:00 +0330
Subject: [PATCH 18/18] fix: "/" menu stays next to the typed "/", Claude-like look
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VERSION: 1.1 (2026-10-15)  1.1: the menu really follows the "/" now. The rect measured
  when the menu opened was written back into the anchor on every render, which undid the
  new measurement at the trigger, so the menu stayed on the left after a Persian letter
  turned the line right-to-left. It is taken once now, and the trigger is measured again
  for a few frames after each typed letter (the direction can change one frame later).
  1.0: first version.
Root: build/outline-1.11.0 (apply after 0001..0017)

Problem 1: the "/" menu appeared far from where it was typed (at the left edge
while the text was on the right).

Cause: the menu position was measured once, when the menu opened. In an empty
line "/" is left-aligned; the first Persian letter then turns the line RTL and
right-aligned, so the text moved to the right and the menu stayed at the old
place on the left.

Fix: the anchor is measured again, at the trigger character ("/", ":", "@"),
every time the search text changes. The menu follows the line's direction.
Applies to all menus built on SuggestionsMenu (/, emoji, mention).

Problem 2 (look): like the Claude slash menu. Rounder card with a thin border,
rows with rounded corners, the chosen row is a light gray bar with normal text
(was a solid accent-colored bar), subtitles/shortcuts keep the gray color, and
list alignment follows the direction (text-align: start/end).

Files (2; N = new, M = modified, D = deleted):
  M app/editor/components/SuggestionsMenu.tsx
  M app/editor/components/SuggestionsMenuItem.tsx

---
---

diff --git a/app/editor/components/SuggestionsMenu.tsx b/app/editor/components/SuggestionsMenu.tsx
index aceb583..f6e6267 100644
--- a/app/editor/components/SuggestionsMenu.tsx
+++ b/app/editor/components/SuggestionsMenu.tsx
@@ -200,6 +200,37 @@ function measureCaretRect(view: EditorView): DOMRect | undefined {
   }
 }
 
+/**
+ * Measures the rect of the trigger character(s) (e.g. "/") that opened the
+ * menu, so the menu stays next to where it was typed. KMS patch 0020.
+ *
+ * @param view the editor view to measure within.
+ * @param triggerLength the length of the trigger text.
+ * @param searchLength the length of the search text typed after the trigger.
+ * @returns the rect of the trigger, or undefined if it cannot be measured.
+ */
+function measureTriggerRect(
+  view: EditorView,
+  triggerLength: number,
+  searchLength: number
+): DOMRect | undefined {
+  try {
+    const start = view.state.selection.from - searchLength - triggerLength;
+    if (start < 0) {
+      return undefined;
+    }
+    const fromPos = view.coordsAtPos(start, 1);
+    const toPos = view.coordsAtPos(start + triggerLength, -1);
+    const top = Math.min(fromPos.top, toPos.top);
+    const bottom = Math.max(fromPos.bottom, toPos.bottom);
+    const left = Math.min(fromPos.left, toPos.left);
+    const right = Math.max(fromPos.right, toPos.right);
+    return new DOMRect(left, top, right - left, bottom - top);
+  } catch {
+    return undefined;
+  }
+}
+
 function SuggestionsMenu<T extends MenuItem>(props: Props<T>) {
   const { view, commands, props: editorProps } = useEditor();
   const { t } = useTranslation();
@@ -238,8 +269,13 @@ function SuggestionsMenu<T extends MenuItem>(props: Props<T>) {
   );
 
   // Keep the last known rect when measuring fails, rather than collapsing the
-  // anchor to the top left corner of the viewport.
-  if (caretRect) {
+  // anchor to the top left corner of the viewport. KMS patch 0018 v1.1: the
+  // rect measured when the menu opened is taken only once; before, every
+  // render wrote it back and undid the later measurement at the trigger, so
+  // the menu stayed where the line was before its direction changed.
+  const openedRectRef = React.useRef<DOMRect | undefined>(undefined);
+  if (caretRect && caretRect !== openedRectRef.current) {
+    openedRectRef.current = caretRect;
     caretRectRef.current = caretRect;
   }
 
@@ -284,6 +320,69 @@ function SuggestionsMenu<T extends MenuItem>(props: Props<T>) {
     // eslint-disable-next-line react-hooks/exhaustive-deps
   }, [props.isActive, props.search]);
 
+  // KMS patch 0020: the anchor was measured only when the menu opened. The
+  // first typed letters can change the direction and alignment of the line
+  // (a Persian letter turns an empty left-aligned line into a right-aligned
+  // one), which moved the text away and left the menu behind. The anchor is
+  // measured again at the trigger character whenever the search changes.
+  React.useEffect(() => {
+    if (!props.isActive) {
+      return;
+    }
+    const frame = requestAnimationFrame(() => {
+      const triggers = Array.isArray(props.trigger)
+        ? props.trigger
+        : [props.trigger];
+      const rect =
+        measureTriggerRect(
+          view,
+          triggers[0].length,
+          (props.search ?? "").length
+        ) ?? measureCaretRect(view);
+      if (rect) {
+        caretRectRef.current = rect;
+        setCaretAnchor({ getBoundingClientRect: () => caretRectRef.current });
+      }
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [props.isActive, props.search, props.trigger, view]);
+
+  // KMS patch 0018 v1.1: the line can also change direction one frame later
+  // (its direction is set by a decoration after the text is in place), so the
+  // trigger is measured again on the following frames while the menu is open,
+  // and the menu moves only when the trigger has moved.
+  React.useEffect(() => {
+    if (!props.isActive) {
+      return;
+    }
+    const triggers = Array.isArray(props.trigger)
+      ? props.trigger
+      : [props.trigger];
+    let frame = 0;
+    let count = 0;
+    const check = () => {
+      const rect = measureTriggerRect(
+        view,
+        triggers[0].length,
+        (props.search ?? "").length
+      );
+      const last = caretRectRef.current;
+      if (
+        rect &&
+        (Math.abs(rect.left - last.left) > 1 ||
+          Math.abs(rect.top - last.top) > 1)
+      ) {
+        caretRectRef.current = rect;
+        setCaretAnchor({ getBoundingClientRect: () => caretRectRef.current });
+      }
+      if (++count < 10) {
+        frame = requestAnimationFrame(check);
+      }
+    };
+    frame = requestAnimationFrame(check);
+    return () => cancelAnimationFrame(frame);
+  }, [props.isActive, props.search, props.trigger, view]);
+
   React.useEffect(() => {
     setSubmenu(null);
 
@@ -1297,6 +1396,10 @@ const bouncyFadeIn = keyframes`
 const BouncyPopoverContent = styled(PopoverContent)`
   ${hideScrollbars()}
 
