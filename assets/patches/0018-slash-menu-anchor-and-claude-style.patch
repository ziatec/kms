     animation: ${bouncyFadeIn} 150ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
   }
@@ -1319,7 +1422,7 @@ const LinkInput = styled(Input)`
 
 const List = styled.ol`
   list-style: none;
-  text-align: left;
+  text-align: start;
   height: 100%;
   padding: 6px;
   margin: 0;
