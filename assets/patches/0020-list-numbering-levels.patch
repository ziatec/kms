+++ b/shared/editor/lib/listNumbering.test.ts
@@ -0,0 +1,185 @@
+// VERSION: 1.2 (2026-10-16) patch 0020-list-numbering-levels
+import type { Node } from "prosemirror-model";
+import type { Command } from "prosemirror-state";
+import { EditorState, TextSelection } from "prosemirror-state";
+import { doc, p, schema } from "@shared/test/editor";
+import {
+  changeListLevel,
+  computeNumbering,
+  formatNumber,
+  joinPreviousList,
+  restartNumbering,
+  setNumberSuffix,
+  setNumberType,
+  syncSegmentStarts,
+  toggleFullNumber,
+} from "./listNumbering";
+
+const { ordered_list, list_item } = schema.nodes;
+
+/** A numbered list item with a paragraph and optional nested lists. */
+function li(text: string, ...children: Node[]) {
+  return list_item.create(null, [p(text), ...children]);
+}
+
+/** A numbered list. */
+function ol(attrs: Record<string, unknown>, ...items: Node[]) {
+  return ordered_list.create(attrs, items);
+}
+
+/** The numbers of all items, in document order. */
+function labels(node: Node, dir: "rtl" | "ltr" = "ltr") {
+  return computeNumbering(node, dir)
+    .items.map((item) => item.label)
+    .join(" ");
+}
+
+/** A state with the cursor in the first text node with the given text. */
+function stateAt(node: Node, text: string) {
+  let pos = -1;
+  node.descendants((child, childPos) => {
+    if (pos === -1 && child.isText && child.text === text) {
+      pos = childPos;
+    }
+    return pos === -1;
+  });
+  const state = EditorState.create({ doc: node });
+  return state.apply(
+    state.tr.setSelection(TextSelection.create(state.doc, pos))
+  );
+}
+
+/** Runs a command and returns the new state. */
+function run(state: EditorState, command: Command) {
+  let next = state;
+  command(state, (tr) => {
+    next = state.apply(tr);
+  });
+  return next;
+}
+
+describe("formatNumber", () => {
+  it("writes Persian letters in alphabet and Abjad order", () => {
+    expect([1, 2, 3, 32].map((n) => formatNumber(n, "alpha-fa", "rtl"))).toEqual(
+      ["الف", "ب", "پ", "ی"]
+    );
+    expect([1, 3, 5, 28].map((n) => formatNumber(n, "abjad", "rtl"))).toEqual([
+      "الف",
+      "ج",
+      "هـ",
+      "غ",
+    ]);
+  });
+
+  it("writes Persian digits in right-to-left lists", () => {
+    expect(formatNumber(12, "decimal", "rtl")).toBe("۱۲");
+    expect(formatNumber(12, "decimal", "ltr")).toBe("12");
+  });
+});
+
+describe("computeNumbering", () => {
+  it("numbers nested lists", () => {
+    const node = doc([
+      ol({}, li("a"), li("b", ol({}, li("b1"), li("b2"))), li("c")),
+    ]);
+    expect(labels(node)).toBe("1. 2. a. b. 3.");
+  });
+
+  it("numbers segments with one list id as one list", () => {
+    const node = doc([
+      ol({ listId: "L" }, li("a"), li("b")),
+      p("x"),
+      ol({ listId: "L" }, li("c")),
+      ol({}, li("d")),
+    ]);
+    expect(labels(node)).toBe("1. 2. 3. 1.");
+  });
+
+  it("shows full numbers with the type of each level", () => {
+    const node = doc([
+      ol(
+        {
+          listId: "L",
+          numbering: { full: true, suffix: ")", levels: [{}, { type: "alpha-fa" }] },
+        },
+        li("آ", ol({}, li("آ۱"), li("آ۲"))),
+        li("ب")
+      ),
+      p("x"),
+      ol({ listId: "L", level: 1 }, li("ب۱")),
+    ]);
+    expect(labels(node)).toBe("۱) ۱.الف) ۱.ب) ۲) ۲.الف)");
+  });
+});
+
+describe("changeListLevel", () => {
+  it("nests an item under the one before", () => {
+    const state = stateAt(doc([ol({}, li("a"), li("b"), li("c"))]), "b");
+    expect(labels(run(state, changeListLevel(1)).doc)).toBe("1. a. 2.");
+  });
+
+  it("gives the first item a segment one level deeper, and back", () => {
+    const state = stateAt(doc([ol({}, li("a"), li("b"))]), "a");
+    const deeper = run(state, changeListLevel(1));
+    expect(deeper.doc.childCount).toBe(2);
+    expect(deeper.doc.child(0).attrs.level).toBe(1);
+    expect(deeper.doc.child(0).attrs.listId).toBe(
+      deeper.doc.child(1).attrs.listId
+    );
+    const back = run(deeper, changeListLevel(-1));
+    expect(back.doc.childCount).toBe(1);
+    expect(labels(back.doc)).toBe("1. 2.");
+  });
+});
+
+describe("later segments", () => {
+  it("start a deeper level at 1, not at their stored start", () => {
+    const node = doc([
+      ol({ listId: "L" }, li("a"), li("b")),
+      p("x"),
+      ol({ listId: "L", level: 1, order: 3 }, li("b1"), li("b2")),
+    ]);
+    expect(labels(node)).toBe("1. 2. a. b.");
+  });
+});
+
+describe("joinPreviousList", () => {
+  it("joins a paragraph after other content and numbers on", () => {
+    const state = stateAt(
+      doc([ol({}, li("a"), li("b")), p("x"), p("y"), ol({}, li("z"))]),
+      "y"
+    );
+    const joined = run(state, joinPreviousList());
+    expect(labels(joined.doc)).toBe("1. 2. 3. 1.");
+    const deeper = run(joined, changeListLevel(1));
+    expect(labels(deeper.doc)).toBe("1. 2. a. 1.");
+    const full = run(run(deeper, toggleFullNumber()), setNumberType("alpha-fa"));
+    expect(labels(full.doc)).toBe("1. 2. 2.الف. 1.");
+    expect(labels(run(full, setNumberSuffix("-")).doc)).toBe(
+      "1- 2- 2.الف- 1."
+    );
+  });
+
+  it("joins a whole list and restarts it again", () => {
+    const state = stateAt(
+      doc([ol({}, li("a")), p("x"), ol({}, li("b"), li("c"))]),
+      "c"
+    );
+    const joined = run(state, joinPreviousList());
+    expect(labels(joined.doc)).toBe("1. 2. 3.");
+    expect(labels(run(joined, restartNumbering()).doc)).toBe("1. 1. 2.");
+  });
+});
+
+describe("syncSegmentStarts", () => {
+  it("writes the start number of later segments", () => {
+    const state = EditorState.create({
+      doc: doc([
+        ol({ listId: "L" }, li("a"), li("b")),
+        p("x"),
+        ol({ listId: "L" }, li("c")),
+      ]),
+    });
+    expect(syncSegmentStarts(state)?.doc.child(2).attrs.order).toBe(3);
+  });
+});
diff --git a/shared/editor/lib/listNumbering.ts b/shared/editor/lib/listNumbering.ts
new file mode 100644
index 0000000..1269209
--- /dev/null
+++ b/shared/editor/lib/listNumbering.ts
@@ -0,0 +1,1355 @@
+// VERSION: 1.2 (2026-10-16) patch 0020-list-numbering-levels
+import type { Node as ProsemirrorNode, NodeType } from "prosemirror-model";
+import type { Command, EditorState, Transaction } from "prosemirror-state";
+import { EditorState as State, TextSelection } from "prosemirror-state";
+import {
+  liftListItem,
+  sinkListItem,
+  wrapInList,
+} from "prosemirror-schema-list";
+import { canJoin } from "prosemirror-transform";
+import { getListDirection } from "../queries/getListDirection";
+import { newListId } from "./listId";
+import type { MultiSelectionMeta, SelectedRange } from "./multiSelection";
+import {
+  getExtraRanges,
+  multiSelectionKey,
+  normalizeRanges,
+} from "./multiSelection";
+
+/*
+ * Multi-level numbering of numbered lists (KMS patch 0020).
+ *
+ * The numbers are never stored: they are computed from the document. Every
+ * top-level numbered list (a "segment") may carry a list id; segments with
+ * the same id are numbered as one list, in document order, also when other
+ * content lies between them. A segment has a level (0 = first level), and a
+ * list nested in an item is one level deeper than the item. The look of each
+ * level (number type and color), the suffix (. ) -) and whether the full
+ * number (1.2.1) is shown are kept in the `numbering` attribute of the
+ * segments of a list.
+ */
+
+/** The kinds of numbers. "auto" is the default of the level. */
+export type NumberType =
+  | "auto"
+  | "decimal"
+  | "alpha-fa"
+  | "abjad"
+  | "lower-alpha"
+  | "upper-alpha"
+  | "lower-roman";
+
+/** The number types offered in the menu. */
+export const NUMBER_TYPES: Exclude<NumberType, "auto" | "lower-roman">[] = [
+  "decimal",
+  "alpha-fa",
+  "abjad",
+  "lower-alpha",
+  "upper-alpha",
+];
+
+/** The suffixes after a number. */
+export type NumberSuffix = "." | ")" | "-";
+
+/** The look of one level of a list. */
+export type LevelConfig = {
+  /** The kind of numbers, the level's default when absent. */
+  type?: NumberType;
+  /** The color of the numbers, the color of the text when absent. */
+  color?: string | null;
+};
+
+/** The numbering of a list, kept on its segments. */
+export type NumberingConfig = {
+  /** The suffix after the number, from the list style when absent. */
+  suffix?: NumberSuffix;
+  /** Whether the numbers of the levels above are shown too: 1.2.1 */
+  full?: boolean;
+  /** The look of each level, from the first level on. */
+  levels?: LevelConfig[];
+};
+
+/** The list node types. */
+const LIST_NAMES = new Set(["ordered_list", "bullet_list", "checkbox_list"]);
+
+/** The deepest level kept in the configuration. */
+const MAX_LEVELS = 9;
+
+/** The suffix of each list style. */
+const STYLE_SUFFIX: Record<string, NumberSuffix> = {
+  number: ".",
+  "number-paren": ")",
+  "number-dash": "-",
+  "lower-alpha": ".",
+  "upper-alpha": ".",
+};
+
+/** The list style written for each suffix (also used by Markdown). */
+export const SUFFIX_STYLE: Record<NumberSuffix, string> = {
+  ".": "number",
+  ")": "number-paren",
+  "-": "number-dash",
+};
+
+/** The Persian alphabet, in the order of the alphabet. */
+const PERSIAN_ALPHABET = [
+  "الف",
+  "ب",
+  "پ",
+  "ت",
+  "ث",
+  "ج",
+  "چ",
+  "ح",
+  "خ",
+  "د",
+  "ذ",
+  "ر",
+  "ز",
+  "ژ",
+  "س",
+  "ش",
+  "ص",
+  "ض",
+  "ط",
+  "ظ",
+  "ع",
+  "غ",
+  "ف",
+  "ق",
+  "ک",
+  "گ",
+  "ل",
+  "م",
+  "ن",
+  "و",
+  "هـ",
+  "ی",
+];
+
+/** The letters in Abjad order (ابجد هوز حطی کلمن سعفص قرشت ثخذ ضظغ). */
+const ABJAD = [
+  "الف",
+  "ب",
+  "ج",
+  "د",
+  "هـ",
+  "و",
+  "ز",
+  "ح",
+  "ط",
+  "ی",
+  "ک",
+  "ل",
+  "م",
+  "ن",
+  "س",
+  "ع",
+  "ف",
+  "ص",
+  "ق",
+  "ر",
+  "ش",
+  "ت",
+  "ث",
+  "خ",
+  "ذ",
+  "ض",
+  "ظ",
+  "غ",
+];
+
+const LATIN = "abcdefghijklmnopqrstuvwxyz".split("");
+const PERSIAN_DIGITS = "۰۱۲۳۴۵۶۷۸۹";
+
+/**
+ * Writes a number with letters: 1 → the first letter, after the last letter
+ * two letters follow (bijective, like aa, ab).
+ *
+ * @param n the number, 1 or more.
+ * @param letters the letters.
+ * @param join the text between two letters.
+ * @returns the letters.
+ */
+function toLetters(n: number, letters: string[], join = ""): string {
+  const parts: string[] = [];
+  let rest = n;
+  while (rest > 0) {
+    const index = (rest - 1) % letters.length;
+    parts.unshift(letters[index]);
+    rest = Math.floor((rest - 1) / letters.length);
+  }
+  return parts.join(join);
+}
+
+/**
+ * Writes a number with Roman numerals.
+ *
+ * @param n the number, 1 to 3999.
+ * @returns the numerals, in capitals.
+ */
+function toRoman(n: number): string {
+  const table: [number, string][] = [
+    [1000, "M"],
+    [900, "CM"],
+    [500, "D"],
+    [400, "CD"],
+    [100, "C"],
+    [90, "XC"],
+    [50, "L"],
+    [40, "XL"],
+    [10, "X"],
+    [9, "IX"],
+    [5, "V"],
+    [4, "IV"],
+    [1, "I"],
+  ];
+  let rest = n;
+  let result = "";
+  for (const [value, numeral] of table) {
+    while (rest >= value) {
+      result += numeral;
+      rest -= value;
+    }
+  }
+  return result;
+}
+
+/**
+ * Writes one number of a list.
+ *
+ * @param n the number.
+ * @param type the kind of number (not "auto").
+ * @param dir the direction of the list: Persian digits when right to left.
+ * @returns the number as text.
+ */
+export function formatNumber(
+  n: number,
+  type: NumberType,
+  dir: "rtl" | "ltr"
+): string {
+  if (n < 1 || !Number.isFinite(n) || type === "decimal" || type === "auto") {
+    const text = String(n);
+    return dir === "rtl"
+      ? text.replace(/[0-9]/g, (d) => PERSIAN_DIGITS[Number(d)])
+      : text;
+  }
+  switch (type) {
+    case "alpha-fa":
+      return toLetters(n, PERSIAN_ALPHABET, "‌");
+    case "abjad":
+      return toLetters(n, ABJAD, "‌");
+    case "lower-alpha":
+      return toLetters(n, LATIN);
+    case "upper-alpha":
+      return toLetters(n, LATIN).toUpperCase();
+    case "lower-roman":
+      return n < 4000 ? toRoman(n).toLowerCase() : String(n);
+    default:
+      return String(n);
+  }
+}
+
+/**
+ * Returns the kind of numbers of a level when none is chosen: numbers in a
+ * right-to-left list, and 1 / a / i in a left-to-right one (as before).
+ *
+ * @param type the chosen kind, if any.
+ * @param level the level, 0 for the first.
+ * @param dir the direction of the list.
+ * @returns the kind of numbers.
+ */
+export function resolveNumberType(
+  type: NumberType | undefined,
+  level: number,
+  dir: "rtl" | "ltr"
+): Exclude<NumberType, "auto"> {
+  if (type && type !== "auto") {
+    return type;
+  }
+  if (dir === "rtl") {
+    return "decimal";
+  }
+  return (["decimal", "lower-alpha", "lower-roman"] as const)[level % 3];
+}
+
+/** Matches the colors that can be given to numbers. */
+const COLOR = /^#[0-9a-f]{6}$/i;
+
+/**
+ * Keeps only valid values of a numbering configuration (it may come from a
+ * pasted document).
+ *
+ * @param value the stored value.
+ * @returns the configuration, or null when there is none.
+ */
+export function toNumberingConfig(value: unknown): NumberingConfig | null {
+  if (!value || typeof value !== "object") {
+    return null;
+  }
+  const input = value as Record<string, unknown>;
+  const config: NumberingConfig = {};
+  if (input.suffix === "." || input.suffix === ")" || input.suffix === "-") {
+    config.suffix = input.suffix;
+  }
+  if (input.full === true) {
+    config.full = true;
+  }
+  if (Array.isArray(input.levels)) {
+    config.levels = input.levels.slice(0, MAX_LEVELS).map((level) => {
+      const out: LevelConfig = {};
+      if (level && typeof level === "object") {
+        const { type, color } = level as Record<string, unknown>;
+        if (
+          typeof type === "string" &&
+          ([...NUMBER_TYPES, "lower-roman"] as string[]).includes(type)
+        ) {
+          out.type = type as NumberType;
+        }
+        if (typeof color === "string" && COLOR.test(color)) {
+          out.color = color;
+        }
+      }
+      return out;
+    });
+  }
+  return Object.keys(config).length ? config : null;
+}
+
+/**
+ * Parses a numbering configuration written in a data attribute.
+ *
+ * @param text the JSON text.
+ * @returns the configuration, or null.
+ */
+export function parseNumberingConfig(text: string | null): NumberingConfig | null {
+  if (!text) {
+    return null;
+  }
+  try {
+    return toNumberingConfig(JSON.parse(text));
+  } catch (_err) {
+    return null;
+  }
+}
+
+/** A numbered list item with its computed number. */
+export type NumberedItem = {
+  /** The position of the list item. */
+  pos: number;
+  /** The position of the numbered list that holds it. */
+  listPos: number;
+  /** The list it is numbered in. */
+  key: string;
+  /** The level, 0 for the first. */
+  level: number;
+  /** The number with its suffix, e.g. "۱.۲)". */
+  label: string;
+  /** The direction of the list. */
+  dir: "rtl" | "ltr";
+  /** The color chosen for the numbers of the level, if any. */
+  color: string | null;
+};
+
+/** A numbered list node with the list it is numbered in. */
+export type NumberedList = {
+  pos: number;
+  key: string;
+  /** The level of its items. */
+  level: number;
+  /** Whether it is a segment (not nested in a numbered item). */
+  topLevel: boolean;
+  /** The longest number of its items, in characters. */
+  longest: number;
+};
+
+/** The numbering of a document. */
+export type Numbering = {
+  items: NumberedItem[];
+  lists: NumberedList[];
+  /** The configuration of each list, from its first segment. */
+  configs: Map<string, NumberingConfig | null>;
+};
+
+type Context = { key: string; level: number; dir: "rtl" | "ltr" } | null;
+
+/**
+ * Computes the number of every item of every numbered list.
+ *
+ * @param doc the document.
+ * @param fallbackDir the direction of a list that has no text yet.
+ * @returns the numbering.
+ */
+export function computeNumbering(
+  doc: ProsemirrorNode,
+  fallbackDir: "rtl" | "ltr" = "ltr"
+): Numbering {
+  const items: NumberedItem[] = [];
+  const lists: NumberedList[] = [];
+  const configs = new Map<string, NumberingConfig | null>();
+  const counters = new Map<string, { counts: number[]; types: NumberType[] }>();
+
+  const visitList = (list: ProsemirrorNode, pos: number, ctx: Context) => {
+    const key = ctx
+      ? ctx.key
+      : (typeof list.attrs.listId === "string" && list.attrs.listId) ||
+        `@${pos}`;
+    const level = ctx ? ctx.level + 1 : clampLevel(list.attrs.level);
+    if (!ctx && !configs.has(key)) {
+      configs.set(key, toNumberingConfig(list.attrs.numbering));
+    }
+    const config = configs.get(key) ?? null;
+    const dir = getListDirection(list) ?? ctx?.dir ?? fallbackDir;
+    // Only the first segment of a list (and a nested list) has its own start
+    // number. A later segment keeps the start written for Markdown in
+    // `order`, which must not restart a level: after Tab it is a stale
+    // number (1.2: an item joined as 5 and moved to the next level showed 4.5
+    // instead of 4.1).
+    const ownStart = !!ctx || !counters.has(key);
+    const state = counters.get(key) ?? { counts: [], types: [] };
+    counters.set(key, state);
+    const record: NumberedList = {
+      pos,
+      key,
+      level,
+      topLevel: !ctx,
+      longest: 0,
+    };
+    lists.push(record);
+
+    const levelConfig = config?.levels?.[level];
+    const legacyType =
+      list.attrs.listStyle === "lower-alpha" ||
+      list.attrs.listStyle === "upper-alpha"
+        ? (list.attrs.listStyle as NumberType)
+        : undefined;
+    const type = resolveNumberType(levelConfig?.type ?? legacyType, level, dir);
+    const suffix =
+      config?.suffix ?? STYLE_SUFFIX[String(list.attrs.listStyle)] ?? ".";
+    const start = ownStart ? Number(list.attrs.order) : 1;
+
+    list.forEach((item, offset) => {
+      const itemPos = pos + 1 + offset;
+      const { counts, types } = state;
+      if (counts.length > level + 1) {
+        counts.length = level + 1;
+      }
+      while (counts.length < level) {
+        counts.push(1);
+      }
+      if (counts.length === level) {
+        counts.push(Number.isFinite(start) && start >= 0 ? start : 1);
+      } else {
+        counts[level] += 1;
+      }
+      types.length = Math.min(types.length, level + 1);
+      types[level] = type;
+
+      const label =
+        (config?.full
+          ? counts
+              .map((count, i) =>
+                formatNumber(
+                  count,
+                  types[i] ??
+                    resolveNumberType(config.levels?.[i]?.type, i, dir),
+                  dir
+                )
+              )
+              .join(".")
+          : formatNumber(counts[level], type, dir)) + suffix;
+      record.longest = Math.max(record.longest, label.length);
+      items.push({
+        pos: itemPos,
+        listPos: pos,
+        key,
+        level,
+        label,
+        dir,
+        color: levelConfig?.color ?? null,
+      });
+      walk(item, itemPos + 1, { key, level, dir });
+    });
+  };
+
+  const walk = (parent: ProsemirrorNode, start: number, ctx: Context) => {
+    parent.forEach((child, offset) => {
+      const pos = start + offset;
+      if (child.type.name === "ordered_list") {
+        visitList(child, pos, ctx);
+      } else if (!child.isTextblock && !child.isLeaf) {
+        walk(child, pos + 1, ctx);
+      }
+    });
+  };
+
+  walk(doc, 0, null);
+  return { items, lists, configs };
+}
+
+/**
+ * Reads a level attribute.
+ *
+ * @param value the stored value.
+ * @returns a level from 0 to MAX_LEVELS - 1.
+ */
+function clampLevel(value: unknown): number {
+  const level = Number(value);
+  return Number.isInteger(level)
+    ? Math.min(Math.max(level, 0), MAX_LEVELS - 1)
+    : 0;
+}
+
+/**
+ * The parts to act on: the picked parts (Ctrl) and the selection.
+ *
+ * @param state the editor state.
+ * @returns the parts, in document order; the selection may be empty.
+ */
+function targetRanges(state: EditorState): SelectedRange[] {
+  const { from, to } = state.selection;
+  const ranges = [...getExtraRanges(state), { from, to }];
+  return ranges.sort((a, b) => a.from - b.from);
+}
+
+/**
+ * Returns the numbered list items the parts touch: the innermost numbered item
+ * around the start of each part, and every numbered item whose first block
+ * the part overlaps.
+ *
+ * @param doc the document.
+ * @param ranges the parts.
+ * @param listType the numbered list type.
+ * @returns the positions of the items, in document order, without repeats.
+ */
+export function findNumberedItems(
+  doc: ProsemirrorNode,
+  ranges: SelectedRange[],
+  listType: NodeType
+): number[] {
+  const found = new Set<number>();
+  for (const range of ranges) {
+    // The innermost list item around the start; it counts only when it is a
+    // numbered one (a bulleted item inside a numbered one is left alone).
+    const $from = doc.resolve(range.from);
+    for (let depth = $from.depth; depth > 0; depth--) {
+      const parent = $from.node(depth - 1);
+      if (LIST_NAMES.has(parent.type.name)) {
+        if (parent.type === listType) {
+          found.add($from.before(depth));
+        }
+        break;
+      }
+    }
+    if (range.to > range.from) {
+      doc.nodesBetween(range.from, range.to, (node, pos, parent) => {
+        if (parent?.type === listType && node.firstChild) {
+          const blockEnd = pos + 1 + node.firstChild.nodeSize;
+          if (range.from < blockEnd && range.to > pos + 1) {
+            found.add(pos);
+          }
+        }
+        return true;
+      });
+    }
+  }
+  return [...found].sort((a, b) => a - b);
+}
+
+/**
+ * Drops items that lie inside another of the items (they move with it).
+ *
+ * @param doc the document.
+ * @param positions the item positions, in document order.
+ * @returns the outermost items.
+ */
+function outermost(doc: ProsemirrorNode, positions: number[]): number[] {
+  const result: number[] = [];
+  for (const pos of positions) {
+    const last = result[result.length - 1];
+    const lastNode = last !== undefined ? doc.nodeAt(last) : null;
+    if (lastNode && pos < last + lastNode.nodeSize) {
+      continue;
+    }
+    result.push(pos);
+  }
+  return result;
+}
+
+/**
+ * Whether a numbered list is nested in a numbered list item.
+ *
+ * @param doc the document.
+ * @param listPos the position of the list.
+ * @param listType the numbered list type.
+ * @returns true when nested.
+ */
+function isNestedList(
+  doc: ProsemirrorNode,
+  listPos: number,
+  listType: NodeType
+): boolean {
+  const $pos = doc.resolve(listPos);
+  for (let depth = $pos.depth; depth > 0; depth--) {
+    if ($pos.node(depth - 1).type === listType) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Runs a command with the cursor (or range) at the given place and adds its
+ * steps to a transaction.
+ *
+ * @param tr the transaction.
+ * @param command the command.
+ * @param from where the selection starts.
+ * @param to where it ends, `from` when absent.
+ * @returns whether anything changed.
+ */
+function runAt(
+  tr: Transaction,
+  command: Command,
+  from: number,
+  to = from
+): boolean {
+  const doc = tr.doc;
+  const selection =
+    to > from
+      ? TextSelection.between(doc.resolve(from), doc.resolve(to))
+      : TextSelection.near(doc.resolve(from));
+  let changed = false;
+  command(State.create({ doc, selection }), (t) => {
+    t.steps.forEach((step) => {
+      if (!tr.maybeStep(step).failed) {
+        changed = true;
+      }
+    });
+  });
+  return changed;
+}
+
+/**
+ * Gives a segment a list id when it has none, so that the parts of it that a
+ * change splits off stay numbered with it.
+ *
+ * @param tr the transaction.
+ * @param listPos the position of the segment.
+ * @returns the list id.
+ */
+function ensureListId(tr: Transaction, listPos: number): string {
+  const list = tr.doc.nodeAt(listPos);
+  if (!list) {
+    return newListId();
+  }
+  if (typeof list.attrs.listId === "string" && list.attrs.listId) {
+    return list.attrs.listId;
+  }
+  const listId = newListId();
+  tr.setNodeMarkup(listPos, undefined, { ...list.attrs, listId });
+  return listId;
+}
+
+/**
+ * Splits a segment so that an item is alone in its own segment, with the
+ * same attributes.
+ *
+ * @param tr the transaction.
+ * @param itemPos the position of the item.
+ * @returns the position of the segment that holds only the item.
+ */
+function isolateItem(tr: Transaction, itemPos: number): number {
+  const $item = tr.doc.resolve(itemPos);
+  const listPos = $item.before();
+  ensureListId(tr, listPos);
+  const list = tr.doc.nodeAt(listPos);
+  if (!list) {
+    return listPos;
+  }
+  const index = $item.index();
+  const item = list.child(index);
+  const typesAfter = [{ type: list.type, attrs: list.attrs }];
+  if (index < list.childCount - 1) {
+    tr.split(itemPos + item.nodeSize, 1, typesAfter);
+  }
+  if (index > 0) {
+    tr.split(itemPos, 1, typesAfter);
+    return itemPos + 1;
+  }
+  return listPos;
+}
+
+/**
+ * Joins neighbouring segments of the same list and level.
+ *
+ * @param tr the transaction.
+ * @param listType the numbered list type.
+ */
+export function joinSegments(tr: Transaction, listType: NodeType) {
+  let joined = true;
+  while (joined) {
+    joined = false;
+    tr.doc.descendants((node, pos) => {
+      if (joined) {
+        return false;
+      }
+      if (node.type !== listType) {
+        return true;
+      }
+      const end = pos + node.nodeSize;
+      const next = tr.doc.resolve(end).nodeAfter;
+      if (
+        next?.type === listType &&
+        node.attrs.listId &&
+        next.attrs.listId === node.attrs.listId &&
+        clampLevel(next.attrs.level) === clampLevel(node.attrs.level) &&
+        canJoin(tr.doc, end)
+      ) {
+        tr.join(end);
+        joined = true;
+        return false;
+      }
+      return true;
+    });
+  }
+}
+
+/**
+ * Keeps the selection and the picked parts on the same text after a change.
+ *
+ * @param state the state before the change.
+ * @param tr the change.
+ */
+function keepSelection(state: EditorState, tr: Transaction) {
+  tr.setSelection(state.selection.map(tr.doc, tr.mapping));
+  const extras = getExtraRanges(state);
+  if (extras.length) {
+    tr.setMeta(multiSelectionKey, {
+      ranges: normalizeRanges(
+        extras.map((r) => ({
+          from: tr.mapping.map(r.from, 1),
+          to: tr.mapping.map(r.to, -1),
+        }))
+      ),
+      gesture: false,
+    } satisfies MultiSelectionMeta);
+  }
+}
+
+/**
+ * Moves the selected numbered items (and the picked ones) one level deeper
+ * or one level up. An item that cannot be nested under the item before it
+ * (the first of a segment) gets a segment of its own one level deeper, so a
+ * paragraph joined to a list after other content can still be 2.1. A whole
+ * segment moves as one.
+ *
+ * @param delta 1 for the next level, -1 for the level before.
+ * @returns the command.
+ */
+export function changeListLevel(delta: number): Command {
+  return (state, dispatch) => {
+    const listType = state.schema.nodes.ordered_list;
+    const itemType = state.schema.nodes.list_item;
+    if (!listType || !itemType) {
+      return false;
+    }
+    const items = outermost(
+      state.doc,
+      findNumberedItems(state.doc, targetRanges(state), listType)
+    );
+    if (!items.length) {
+      return false;
+    }
+
+    const tr = state.tr;
+
+    // Items that are all the items of a segment: the segment moves.
+    const groups = new Map<number, number[]>();
+    for (const pos of items) {
+      const listPos = state.doc.resolve(pos).before();
+      groups.set(listPos, [...(groups.get(listPos) ?? []), pos]);
+    }
+    const single: number[] = [];
+    const lift: number[] = [];
+    for (const [listPos, members] of groups) {
+      const list = state.doc.nodeAt(listPos);
+      if (
+        list &&
+        members.length === list.childCount &&
+        !isNestedList(state.doc, listPos, listType)
+      ) {
+        const level = clampLevel(list.attrs.level);
+        const next = level + delta;
+        if (next >= 0 && next < MAX_LEVELS) {
+          tr.setNodeMarkup(listPos, undefined, { ...list.attrs, level: next });
+          continue;
+        }
+        if (next < 0) {
+          lift.push(...members);
+          continue;
+        }
+      }
+      single.push(...members);
+    }
+
+    const order = delta > 0 ? single : [...single].reverse();
+    for (const original of order) {
+      const pos = tr.mapping.map(original, 1);
+      const $pos = tr.doc.resolve(pos);
+      const list = $pos.parent;
+      const listPos = $pos.before();
+      const item = tr.doc.nodeAt(pos);
+      if (!item || list.type !== listType) {
+        continue;
+      }
+      const nested = isNestedList(tr.doc, listPos, listType);
+      const inside = pos + 1;
+      if (delta > 0) {
+        if ($pos.index() > 0) {
+          runAt(tr, sinkListItem(itemType), inside);
+        } else if (!nested) {
+          const segment = isolateItem(tr, pos);
+          const node = tr.doc.nodeAt(segment);
+          if (node) {
+            tr.setNodeMarkup(segment, undefined, {
+              ...node.attrs,
+              level: Math.min(clampLevel(node.attrs.level) + 1, MAX_LEVELS - 1),
+            });
+          }
+        }
+      } else if (nested) {
+        runAt(tr, liftListItem(itemType), inside);
+      } else if (clampLevel(list.attrs.level) > 0) {
+        const segment = isolateItem(tr, pos);
+        const node = tr.doc.nodeAt(segment);
+        if (node) {
+          tr.setNodeMarkup(segment, undefined, {
