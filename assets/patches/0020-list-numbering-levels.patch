  M shared/editor/components/Styles.ts
  M shared/editor/extensions/MultiSelection.ts
  N shared/editor/lib/listId.ts
  N shared/editor/lib/listNumbering.test.ts
  N shared/editor/lib/listNumbering.ts
  M shared/editor/lib/multiSelection.ts
  M shared/editor/nodes/OrderedList.ts
  M shared/i18n/locales/fa_IR/translation.json

