+    const tr = state.tr;
+    const listId = ensureListId(tr, previous.pos);
+    const base = tr.doc.nodeAt(previous.pos);
+    const attrs = {
+      listId,
+      numbering: base?.attrs.numbering ?? null,
+      listStyle: base?.attrs.listStyle ?? "number",
+    };
