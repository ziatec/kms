+ * attribute, so that Markdown and HTML without the editor show the same
+ * numbers. Only segments on the first level are changed.
+ *
+ * @param state the editor state.
+ * @returns the transaction, or null when nothing differs.
+ */
+export function syncSegmentStarts(state: EditorState): Transaction | null {
+  const listType = state.schema.nodes.ordered_list;
+  if (!listType) {
+    return null;
+  }
+  const numbering = computeNumbering(state.doc);
+  const seen = new Set<string>();
+  const firstNumber = new Map<number, number>();
+  let tr: Transaction | null = null;
