new file mode 100644
index 0000000..bc309f8
--- /dev/null
+++ b/shared/editor/lib/listId.ts
@@ -0,0 +1,16 @@
+// VERSION: 1.0 (2026-10-15) patch 0020-list-numbering-levels
+
+/**
+ * Returns a new id for a numbered list. Lists (segments) that share an id are
+ * numbered as one list, also when other content lies between them.
+ *
+ * @returns the id.
+ */
+export function newListId(): string {
+  const cryptoApi = (globalThis as { crypto?: { randomUUID?: () => string } })
+    .crypto;
+  if (cryptoApi?.randomUUID) {
+    return cryptoApi.randomUUID();
+  }
+  return `l${Date.now().toString(36)}${Math.random().toString(36).slice(2, 10)}`;
+}
