+  // The number of the first item of each segment, counted again here
+  // without the formatting.
+  const counts = new Map<string, number>();
+  for (const item of numbering.items) {
+    if (item.level !== 0) {
+      continue;
+    }
+    const list = numbering.lists.find((l) => l.pos === item.listPos);
+    if (!list?.topLevel) {
+      continue;
+    }
+    const node = state.doc.nodeAt(item.listPos);
+    const value = counts.has(item.key)
+      ? (counts.get(item.key) ?? 0) + 1
+      : Number(node?.attrs.order) || 1;
+    counts.set(item.key, value);
+    if (!firstNumber.has(item.listPos)) {
+      firstNumber.set(item.listPos, value);
+    }
+  }
