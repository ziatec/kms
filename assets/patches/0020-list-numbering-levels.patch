+  return (state, dispatch) => {
+    const listType = state.schema.nodes.ordered_list;
+    if (!listType) {
+      return false;
+    }
+    const segment = findSegmentAt(state.doc, state.selection.from, listType);
+    if (!segment) {
+      return false;
+    }
+    if (!dispatch) {
+      return true;
+    }
+    const oldId = segment.node.attrs.listId;
+    const listId = newListId();
+    const tr = state.tr;
+    state.doc.descendants((node, pos) => {
+      if (node.type === listType) {
+        if (
+          pos === segment.pos ||
+          (oldId && pos > segment.pos && node.attrs.listId === oldId)
