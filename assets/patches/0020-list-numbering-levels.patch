+export function joinPreviousList(): Command {
+  return (state, dispatch) => {
+    const listType = state.schema.nodes.ordered_list;
+    if (!listType) {
+      return false;
+    }
+    const ranges = targetRanges(state);
+    const first = ranges[0].from;
+    const own = findSegmentAt(state.doc, first, listType);
+    const previous = findPreviousSegment(
+      state.doc,
+      own ? own.pos : first,
+      listType
+    );
+    if (!previous) {
+      return false;
+    }
+    if (!dispatch) {
+      return true;
+    }
