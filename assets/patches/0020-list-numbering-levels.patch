+export function setLevelValue(
+  config: NumberingConfig,
+  levels: Set<number>,
+  value: LevelConfig
+): NumberingConfig {
+  const list: LevelConfig[] = [...(config.levels ?? [])];
+  for (const level of levels) {
+    while (list.length <= level) {
+      list.push({});
+    }
+    const next: LevelConfig = { ...list[level], ...value };
+    if (next.type === "auto") {
+      delete next.type;
+    }
+    if (!next.color) {
+      delete next.color;
+    }
+    list[level] = next;
+  }
