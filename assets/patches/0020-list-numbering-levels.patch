+  for (const list of numbering.lists) {
+    if (!list.topLevel || list.level !== 0) {
+      continue;
+    }
+    if (!seen.has(list.key)) {
+      seen.add(list.key);
+      continue;
+    }
+    const node = state.doc.nodeAt(list.pos);
+    const start = firstNumber.get(list.pos);
+    if (node && start !== undefined && node.attrs.order !== start) {
+      tr = tr ?? state.tr;
+      tr.setNodeMarkup(list.pos, undefined, { ...node.attrs, order: start });
+    }
+  }
+  return tr;
