+  const $pos = doc.resolve(pos);
+  for (let depth = 1; depth <= $pos.depth; depth++) {
+    if ($pos.node(depth).type === listType) {
+      return { node: $pos.node(depth), pos: $pos.before(depth) };
+    }
+  }
+  return null;
