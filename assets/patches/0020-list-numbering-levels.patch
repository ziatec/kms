+    for (const range of ranges) {
+      const from = tr.mapping.map(range.from, 1);
+      const to = Math.max(from, tr.mapping.map(range.to, -1));
+      const segment = findSegmentAt(tr.doc, from, listType);
+      if (segment) {
+        if (segment.node.attrs.listId !== listId) {
+          tr.setNodeMarkup(segment.pos, undefined, {
+            ...segment.node.attrs,
+            ...attrs,
+          });
+        }
+        continue;
+      }
+      runAt(tr, wrapInList(listType, { ...attrs, level: 0 }), from, to);
