+export function updateNumbering(
+  update: (config: NumberingConfig, levels: Set<number>) => NumberingConfig,
+  listStyle?: string
+): Command {
+  return (state, dispatch) => {
+    const listType = state.schema.nodes.ordered_list;
+    if (!listType) {
+      return false;
+    }
+    const numbering = computeNumbering(state.doc);
+    const levels = selectedLevels(state, numbering);
+    if (!levels.size) {
+      return false;
+    }
+    if (!dispatch) {
+      return true;
+    }
+    const tr = state.tr;
+    for (const [key, selected] of levels) {
+      const config = update({ ...(numbering.configs.get(key) ?? {}) }, selected);
+      const value = toNumberingConfig(config);
+      for (const list of numbering.lists) {
+        if (list.key !== key) {
+          continue;
+        }
+        const node = tr.doc.nodeAt(list.pos);
+        if (!node) {
+          continue;
+        }
+        const attrs = { ...node.attrs };
+        if (list.topLevel) {
+          attrs.numbering = value;
+        }
+        if (listStyle) {
+          attrs.listStyle = listStyle;
