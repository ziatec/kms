From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dev <dev@local>
Date: Mon, 12 Oct 2026 23:00:00 +0330
Subject: [PATCH 11/18] i18n: Persian translations, fresh locales after updates, English fallback
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VERSION: 2.0 (2026-10-12)  2.0 = merged set of 11 patches (old numbers below)
Root: build/outline-1.11.0 (apply after 0001..0010)

(was 0009 v2.0, the translations of 0010/0011/0013, 0014 v1.2 i18n part, 0018 v1.0)
- Every fa_IR string of the set is here, so feature patches never touch
  shared/i18n/locales/fa_IR/translation.json. English keys come from the
  code (yarn build:i18n writes en_US).
- fa_IR: the 460 upstream strings that were still in English are translated
  (settings, notifications, passkeys, e-mails, editor, ...).
- Locale URL carries a hash of all translation files (?v=..., set at build
  time in vite.config.ts), so browsers fetch new strings after an update
  instead of a 7-day cached copy.
- Fallback language is en-US on client and server (was DEFAULT_LANGUAGE,
  i.e. fa_IR): a string missing in English (UK), German, ... is shown in
  English, not in Persian. Persian users are unchanged.

Calendar switch (was 0019 v1.0): adds the Persian label "Jalali" (شمسی)
for the Gregorian | Jalali switch of the calendar (patch 0004).

Files (4; N = new, M = modified, D = deleted):
  M app/utils/i18n.ts
  M server/utils/i18n.ts
  M shared/i18n/locales/fa_IR/translation.json
  M vite.config.ts

---
---

diff --git a/app/utils/i18n.ts b/app/utils/i18n.ts
index 28bc2b1..d411ae9 100644
--- a/app/utils/i18n.ts
+++ b/app/utils/i18n.ts
@@ -7,6 +7,11 @@ import { isRTLLanguage } from "@shared/utils/rtl";
 import { cdnPath } from "@shared/utils/urls";
 import Logger from "./Logger";
 
+/** Hash of all translation files, set by vite.config.ts (KMS patch 0011). */
+declare const __LOCALES_HASH__: string | undefined;
+const localesVersion =
+  typeof __LOCALES_HASH__ === "string" ? __LOCALES_HASH__ : "";
+
 /**
  * Initializes i18n library, loading all available translations from the
  * API backend.
@@ -34,7 +39,11 @@ export function initI18n(defaultLanguage = "en_US") {
         // this must match the path defined in routes. It's the path that the
         // frontend UI code will hit to load missing translations.
         loadPath: (locale: string[]) =>
-          cdnPath(`/locales/${unicodeBCP47toCLDR(locale[0])}.json`),
+          // KMS patch 0011: the version query makes browsers fetch new
+          // translations after an update instead of a 7-day cached copy.
+          cdnPath(
+            `/locales/${unicodeBCP47toCLDR(locale[0])}.json?v=${localesVersion}`
+          ),
       },
       interpolation: {
         escapeValue: false,
@@ -43,7 +52,9 @@ export function initI18n(defaultLanguage = "en_US") {
         useSuspense: false,
       },
       lng,
-      fallbackLng: lng,
+      // KMS patch 0011: a string missing in the chosen language falls back to
+      // English (the keys are English), not to DEFAULT_LANGUAGE (e.g. fa_IR).
+      fallbackLng: "en-US",
       supportedLngs: languages.map(unicodeCLDRtoBCP47),
       keySeparator: false,
       returnNull: false,
diff --git a/server/utils/i18n.ts b/server/utils/i18n.ts
index b929855..f665df0 100644
--- a/server/utils/i18n.ts
+++ b/server/utils/i18n.ts
@@ -50,7 +50,9 @@ export async function initI18n() {
       escapeValue: false,
     },
     lng,
-    fallbackLng: lng,
+    // KMS patch 0011: a string missing in the chosen language falls back to
+    // English (the keys are English), not to DEFAULT_LANGUAGE (e.g. fa_IR).
+    fallbackLng: "en-US",
     keySeparator: false,
     returnNull: false,
   });
