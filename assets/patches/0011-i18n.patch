+import crypto from "node:crypto";
 import fs from "node:fs";
 import path from "node:path";
 import react from "@vitejs/plugin-react";
@@ -8,6 +9,22 @@ import { defineConfig } from "vite";
 import { VitePWA } from "vite-plugin-pwa";
 import environment from "./server/utils/environment";
 
+/**
+ * Hash of all translation files (KMS patch 0011, VERSION 1.0): added to the
+ * locale URL so that browsers load new translations after an update.
+ */
+function localesHash(): string {
+  const dir = "./shared/i18n/locales";
+  const hash = crypto.createHash("sha256");
+  for (const lng of fs.readdirSync(dir).sort()) {
+    const file = path.join(dir, lng, "translation.json");
+    if (fs.existsSync(file)) {
+      hash.update(lng).update(fs.readFileSync(file));
+    }
+  }
+  return hash.digest("hex").slice(0, 12);
+}
+
 let httpsConfig: ServerOptions["https"] | undefined;
 let host: string | undefined;
 
@@ -32,6 +49,7 @@ export default ({ mode }: ConfigEnv) =>
     // builds of dependencies such as React. Derive the bundled value from the
     // Vite mode instead so `vite build` always bundles production dependencies.
     define: {
+      __LOCALES_HASH__: JSON.stringify(localesHash()),
       "process.env.NODE_ENV": JSON.stringify(
         mode === "development" ? "development" : "production"
       ),
