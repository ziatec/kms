--- /dev/null
+++ b/shared/editor/rules/textDirection.ts
@@ -0,0 +1,54 @@
+import type MarkdownIt from "markdown-it";
+import type StateCore from "markdown-it/lib/rules_core/state_core.mjs";
+import { BidiChar } from "../../utils/bidi";
+
+/**
+ * A markdown-it plugin that turns a direction mark (RLM or LRM) at the start
+ * of a paragraph or heading into an explicit `dir` attribute on the block, so
+ * that the direction chosen in the editor survives a Markdown round trip.
+ *
+ * @param md the markdown-it instance.
+ *
+ * VERSION: 1.1 (2026-10-12) — guard for tokens without text
+ */
+export default function textDirection(md: MarkdownIt): void {
+  md.core.ruler.after("inline", "text_direction", (state: StateCore) => {
+    const tokens = state.tokens;
+
+    for (let i = 0; i < tokens.length - 1; i++) {
+      const open = tokens[i];
+      if (open.type !== "paragraph_open" && open.type !== "heading_open") {
+        continue;
+      }
+
+      const inline = tokens[i + 1];
+      if (inline.type !== "inline") {
+        continue;
+      }
+
+      // Some tokens (e.g. from documents created by the server) have no text.
+      if (typeof inline.content !== "string" || !inline.content) {
+        continue;
+      }
+      const mark = inline.content.charAt(0);
+      if (mark !== BidiChar.RLM && mark !== BidiChar.LRM) {
+        continue;
+      }
+
+      open.attrSet("dir", mark === BidiChar.RLM ? "rtl" : "ltr");
+      inline.content = inline.content.slice(1);
+
+      const first = inline.children?.[0];
+      if (
+        first &&
+        first.type === "text" &&
+        typeof first.content === "string" &&
+        first.content.charAt(0) === mark
+      ) {
+        first.content = first.content.slice(1);
+      }
+    }
+
+    return false;
+  });
+}
