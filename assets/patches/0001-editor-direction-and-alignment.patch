diff --git a/shared/editor/extensions/CodeDirection.ts b/shared/editor/extensions/CodeDirection.ts
new file mode 100644
index 0000000..cbceb87
--- /dev/null
+++ b/shared/editor/extensions/CodeDirection.ts
@@ -0,0 +1,142 @@
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import type { Command } from "prosemirror-state";
+import { Plugin, PluginKey, TextSelection } from "prosemirror-state";
+import { Decoration, DecorationSet } from "prosemirror-view";
+import type { TextDirection } from "../../utils/bidi";
+import {
+  BidiChar,
+  BidiCharLabel,
+  bidiControlRegex,
+  toggleEmbeddedDirection,
+} from "../../utils/bidi";
+import Extension from "../lib/Extension";
+import { isInCode } from "../queries/isInCode";
+import { EditorStyleHelper } from "../styles/EditorStyleHelper";
+import { dirFromAttrs } from "./TextDirection";
+
+const pluginKey = new PluginKey<DecorationSet>("codeDirection");
+
+/**
+ * Returns true if a text node is code: inside a code block or with a code mark.
+ *
+ * @param node the text node.
+ * @param parent the parent block.
+ * @returns true if the text is code.
+ */
+function isCodeText(node: ProsemirrorNode, parent: ProsemirrorNode | null) {
+  return !!parent?.type.spec.code || node.marks.some((m) => m.type.spec.code);
+}
+
+/**
+ * Builds decorations labelling each bidirectional control character in code.
+ * The characters themselves are untouched, so they keep their effect.
+ *
+ * @param doc the document.
+ * @returns the decorations.
+ */
+function buildDecorations(doc: ProsemirrorNode): DecorationSet {
+  const decorations: Decoration[] = [];
+
+  doc.descendants((node, pos, parent) => {
+    if (!node.isText || !node.text || !isCodeText(node, parent)) {
+      return;
+    }
+    for (const match of node.text.matchAll(bidiControlRegex)) {
+      const from = pos + (match.index ?? 0);
+      decorations.push(
+        Decoration.inline(from, from + 1, {
+          class: EditorStyleHelper.bidiControl,
+          "data-bidi": BidiCharLabel[match[0]] ?? "",
+        })
+      );
+    }
+  });
+
+  return DecorationSet.create(doc, decorations);
+}
+
+/**
+ * Code is always laid out left-to-right. To write a right-to-left segment
+ * inside code, such as a Persian comment or string, the selection is wrapped
+ * in Unicode embedding characters: RLE (U+202B) or LRE (U+202A) … PDF
+ * (U+202C). These characters are part of the text, so they also apply when
+ * the code is copied elsewhere, and they are labelled while editing.
+ */
+export default class CodeDirection extends Extension {
+  get name() {
+    return "code_direction";
+  }
+
+  get plugins() {
+    return [
+      new Plugin<DecorationSet>({
+        key: pluginKey,
+        state: {
+          init: (_, state) => buildDecorations(state.doc),
+          apply: (tr, value) =>
+            tr.docChanged ? buildDecorations(tr.doc) : value,
+        },
+        props: {
+          decorations: (state) => pluginKey.getState(state),
+        },
+      }),
+    ];
+  }
+
+  commands() {
+    return {
+      embedTextDirection: (attrs?: unknown) => {
+        const dir = dirFromAttrs(attrs);
+        return dir ? this.embedTextDirection(dir) : () => false;
+      },
+    };
+  }
+
+  /**
+   * Toggles a directional embedding around the selected code. With a bare
+   * cursor an empty embedding is inserted and the cursor placed inside it.
+   *
+   * @param dir the direction to embed.
+   * @returns the command.
+   */
+  private embedTextDirection(dir: TextDirection): Command {
+    return (state, dispatch) => {
+      if (!isInCode(state)) {
+        return false;
+      }
+
+      const { from, to, empty } = state.selection;
+
+      if (empty) {
+        const start = dir === "rtl" ? BidiChar.RLE : BidiChar.LRE;
+        const tr = state.tr.insertText(start + BidiChar.PDF, from);
+        tr.setSelection(TextSelection.create(tr.doc, from + 1));
+        dispatch?.(tr);
+        return true;
+      }
+
+      const replacement = toggleEmbeddedDirection(
+        state.doc.textBetween(from, to),
+        dir
+      );
+
+      if (!replacement) {
+        dispatch?.(state.tr.delete(from, to));
+        return true;
+      }
+
+      // Keep the marks of the selected text, e.g. inline code.
+      const marks = state.doc.nodeAt(from)?.marks ?? [];
+      const tr = state.tr.replaceWith(
+        from,
+        to,
+        state.schema.text(replacement, marks)
+      );
+      tr.setSelection(
+        TextSelection.create(tr.doc, from, from + replacement.length)
+      );
+      dispatch?.(tr);
+      return true;
+    };
+  }
+}
diff --git a/shared/editor/extensions/TextAlignment.ts b/shared/editor/extensions/TextAlignment.ts
new file mode 100644
index 0000000..e377b88
--- /dev/null
+++ b/shared/editor/extensions/TextAlignment.ts
@@ -0,0 +1,76 @@
+import type { Command } from "prosemirror-state";
+import { Plugin } from "prosemirror-state";
+import Extension from "../lib/Extension";
+import { carryBlockAttr } from "../lib/carryBlockAttr";
+import type { TextAlign } from "../queries/getTextAlignment";
+import { toTextAlign } from "../queries/getTextAlignment";
+import {
+  directionalNodeNames,
+  forEachDirectionalBlock,
+} from "../queries/getTextDirection";
+import { isInCode } from "../queries/isInCode";
+
+/**
+ * An editor extension for the alignment of text blocks: left, center, right
+ * or justified. It is independent of the text direction, so a block can be
+ * both right-to-left and justified, or right-to-left and left-aligned.
+ */
+export default class TextAlignment extends Extension {
+  get name() {
+    return "text_alignment";
+  }
+
+  get plugins() {
+    return [
+      new Plugin({
+        // A new block created by Enter continues with the same alignment.
+        appendTransaction: (transactions, oldState, newState) =>
+          carryBlockAttr(
+            "align",
+            directionalNodeNames,
+            transactions,
+            oldState,
+            newState
+          ),
+      }),
+    ];
+  }
+
+  commands() {
+    return {
+      setTextAlignment: (attrs?: unknown) =>
+        this.setTextAlignment(
+          attrs && typeof attrs === "object" && "align" in attrs
+            ? toTextAlign(attrs.align)
+            : null
+        ),
+    };
+  }
+
+  /**
+   * Sets an explicit alignment on every text block in the selection.
+   *
+   * @param align the alignment, or null for the default.
+   * @returns the command.
+   */
+  private setTextAlignment(align: TextAlign | null): Command {
+    return (state, dispatch) => {
+      if (isInCode(state)) {
+        return false;
+      }
+
+      const tr = state.tr;
+      forEachDirectionalBlock(state, (node, pos) => {
+        if ((node.attrs.align ?? null) !== align) {
+          tr.setNodeMarkup(pos, undefined, { ...node.attrs, align });
+        }
+      });
+
+      if (!tr.docChanged) {
+        return false;
+      }
+      dispatch?.(tr);
+      return true;
+    };
+  }
+}
