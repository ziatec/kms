@@ -0,0 +1,115 @@
+/**
+ * Helpers for bidirectional (RTL/LTR) text handling.
+ */
+
+/** An explicit text direction for a block. `null` means automatic. */
+export type TextDirection = "rtl" | "ltr";
+
+/** Unicode bidirectional control characters. */
+export const BidiChar = {
+  /** LEFT-TO-RIGHT MARK */
+  LRM: "\u200E",
+  /** RIGHT-TO-LEFT MARK */
+  RLM: "\u200F",
+  /** LEFT-TO-RIGHT EMBEDDING */
+  LRE: "\u202A",
+  /** RIGHT-TO-LEFT EMBEDDING */
+  RLE: "\u202B",
+  /** POP DIRECTIONAL FORMATTING */
+  PDF: "\u202C",
+  /** LEFT-TO-RIGHT OVERRIDE */
+  LRO: "\u202D",
+  /** RIGHT-TO-LEFT OVERRIDE */
+  RLO: "\u202E",
+  /** LEFT-TO-RIGHT ISOLATE */
+  LRI: "\u2066",
+  /** RIGHT-TO-LEFT ISOLATE */
+  RLI: "\u2067",
+  /** FIRST STRONG ISOLATE */
+  FSI: "\u2068",
+  /** POP DIRECTIONAL ISOLATE */
+  PDI: "\u2069",
+} as const;
+
+/** Short labels used when making control characters visible in code. */
+export const BidiCharLabel: Record<string, string> = {
+  [BidiChar.LRM]: "LRM",
+  [BidiChar.RLM]: "RLM",
+  [BidiChar.LRE]: "LRE",
+  [BidiChar.RLE]: "RLE",
+  [BidiChar.PDF]: "PDF",
+  [BidiChar.LRO]: "LRO",
+  [BidiChar.RLO]: "RLO",
+  [BidiChar.LRI]: "LRI",
+  [BidiChar.RLI]: "RLI",
+  [BidiChar.FSI]: "FSI",
+  [BidiChar.PDI]: "PDI",
+};
+
+/** Matches any bidirectional control character. */
+export const bidiControlRegex = /[\u200E\u200F\u202A-\u202E\u2066-\u2069]/g;
+
+/**
+ * Restricts an unknown value to a valid text direction.
+ *
+ * @param value the value to check, e.g. a DOM attribute.
+ * @returns "rtl", "ltr" or null when the value is not an explicit direction.
+ */
+export function toTextDirection(value: unknown): TextDirection | null {
+  return value === "rtl" || value === "ltr" ? value : null;
+}
+
+/**
+ * Wraps text in a directional embedding (RLE/LRE … PDF), so that it is laid
+ * out in the given direction inside text of the opposite direction, such as
+ * a Persian comment inside a line of code.
+ *
+ * @param text the text to wrap.
+ * @param dir the direction to embed.
+ * @returns the wrapped text.
+ */
+export function embedDirection(text: string, dir: TextDirection): string {
+  const start = dir === "rtl" ? BidiChar.RLE : BidiChar.LRE;
+  return `${start}${text}${BidiChar.PDF}`;
+}
+
+/**
+ * Returns the direction of an embedding that wraps the whole text.
+ *
+ * @param text the text to check.
+ * @returns the embedded direction, or null if the text is not wrapped.
+ */
+export function getEmbeddedDirection(text: string): TextDirection | null {
+  if (text.length < 2 || !text.endsWith(BidiChar.PDF)) {
+    return null;
+  }
+  const first = text.charAt(0);
+  return first === BidiChar.RLE ? "rtl" : first === BidiChar.LRE ? "ltr" : null;
+}
+
+/**
+ * Removes a directional embedding that wraps the whole text.
+ *
+ * @param text the text to unwrap.
+ * @returns the text without the surrounding embedding, or the text unchanged.
+ */
+export function unembedDirection(text: string): string {
+  return getEmbeddedDirection(text) ? text.slice(1, -1) : text;
+}
+
+/**
+ * Toggles a directional embedding around text: adds it, switches an existing
+ * embedding of the other direction, or removes one of the same direction.
+ *
+ * @param text the text to change.
+ * @param dir the direction to toggle.
+ * @returns the changed text.
+ */
+export function toggleEmbeddedDirection(
+  text: string,
+  dir: TextDirection
+): string {
+  const current = getEmbeddedDirection(text);
+  const inner = unembedDirection(text);
+  return current === dir ? inner : embedDirection(inner, dir);
+}
