@@ -0,0 +1,55 @@
+import type { EditorState } from "prosemirror-state";
+import { forEachDirectionalBlock } from "./getTextDirection";
+
+/** An explicit text alignment for a block. `null` means the default. */
+export type TextAlign = "left" | "center" | "right" | "justify";
+
+const textAligns: readonly string[] = ["left", "center", "right", "justify"];
+
+/**
+ * Restricts an unknown value to a valid text alignment.
+ *
+ * @param value the value to check, e.g. a DOM attribute.
+ * @returns the alignment, or null when the value is not an explicit alignment.
+ */
+export function toTextAlign(value: unknown): TextAlign | null {
+  return typeof value === "string" && textAligns.includes(value)
+    ? (value as TextAlign)
+    : null;
+}
+
+/**
+ * Returns the explicit alignment shared by every text block in the selection.
+ * Alignment is independent of the text direction.
+ *
+ * @param state the editor state.
+ * @returns the alignment when all selected blocks have it, null when they all
+ * use the default, or "mixed" otherwise.
+ */
+export function getTextAlignment(
+  state: EditorState
+): TextAlign | null | "mixed" {
+  let result: TextAlign | null | "mixed" | undefined;
+
+  forEachDirectionalBlock(state, (node) => {
+    const align: TextAlign | null = node.attrs.align ?? null;
+    if (result === undefined) {
+      result = align;
+    } else if (result !== align) {
+      result = "mixed";
+    }
+  });
+
+  return result === undefined ? null : result;
+}
+
+/**
+ * Returns a predicate testing that the selected blocks all have the given
+ * alignment, for use as a menu item's `active` state.
+ *
+ * @param align the alignment to test, or null for the default.
+ * @returns a predicate over the editor state.
+ */
+export function isTextAlignActive(align: TextAlign | null) {
+  return (state: EditorState): boolean => getTextAlignment(state) === align;
+}
