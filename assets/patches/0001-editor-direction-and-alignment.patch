+++ b/shared/editor/queries/getTextDirection.ts
@@ -0,0 +1,63 @@
+import type { Node as ProsemirrorNode } from "prosemirror-model";
+import type { EditorState } from "prosemirror-state";
+import type { TextDirection } from "../../utils/bidi";
+
+/** Names of the nodes that carry an explicit `dir` attribute. */
+export const directionalNodeNames = new Set(["paragraph", "heading"]);
+
+/**
+ * Calls the callback for every block in the selection that can carry an
+ * explicit direction, including the block holding a bare cursor.
+ *
+ * @param state the editor state.
+ * @param callback called with each block and its position.
+ */
+export function forEachDirectionalBlock(
+  state: EditorState,
+  callback: (node: ProsemirrorNode, pos: number) => void
+): void {
+  for (const range of state.selection.ranges) {
+    state.doc.nodesBetween(range.$from.pos, range.$to.pos, (node, pos) => {
+      if (directionalNodeNames.has(node.type.name)) {
+        callback(node, pos);
+        return false;
+      }
+      return true;
+    });
+  }
+}
+
+/**
+ * Returns the explicit direction shared by every block in the selection.
+ *
+ * @param state the editor state.
+ * @returns "rtl" or "ltr" when all selected blocks have that direction, null
+ * when they are all automatic, or "mixed" otherwise.
+ */
+export function getTextDirection(
+  state: EditorState
+): TextDirection | null | "mixed" {
+  let result: TextDirection | null | "mixed" | undefined;
+
+  forEachDirectionalBlock(state, (node) => {
+    const dir: TextDirection | null = node.attrs.dir ?? null;
+    if (result === undefined) {
+      result = dir;
+    } else if (result !== dir) {
+      result = "mixed";
+    }
+  });
+
+  return result === undefined ? null : result;
+}
+
+/**
+ * Returns a function that tests whether the selected blocks all have the
+ * given explicit direction, for use as a menu item's `active` state.
+ *
+ * @param dir the direction to test, or null for automatic.
+ * @returns a predicate over the editor state.
+ */
+export function isTextDirectionActive(dir: TextDirection | null) {
+  return (state: EditorState): boolean => getTextDirection(state) === dir;
+}
