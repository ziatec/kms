+} from "../queries/getTextDirection";
+import { isInCode } from "../queries/isInCode";
+import textDirectionRule from "../rules/textDirection";
+
+/**
+ * Reads the direction from command attributes.
+ *
+ * @param attrs the attributes passed to the command, e.g. `{ dir: "rtl" }`.
+ * @returns the direction, or null for automatic.
+ */
+export function dirFromAttrs(attrs: unknown): Direction | null {
+  return attrs && typeof attrs === "object" && "dir" in attrs
+    ? toTextDirection(attrs.dir)
+    : null;
+}
+
+/**
+ * An editor extension for right-to-left and mixed-direction writing. Text
+ * blocks can be given an explicit direction, so that a Persian sentence that
+ * starts with a Latin word is still laid out right-to-left, instead of the
+ * direction being guessed from the first strong character of each line.
+ */
+export default class TextDirection extends Extension {
+  get name() {
+    return "text_direction";
+  }
+
+  get rulePlugins(): PluginSimple[] {
+    return [textDirectionRule];
+  }
+
+  get plugins() {
+    return [
+      new Plugin({
+        appendTransaction: (transactions, oldState, newState) =>
+          carryBlockAttr(
+            "dir",
+            directionalNodeNames,
+            transactions,
+            oldState,
+            newState
+          ),
+      }),
+    ];
+  }
+
+  commands() {
+    return {
+      setTextDirection: (attrs?: unknown) =>
+        this.setTextDirection(dirFromAttrs(attrs)),
+    };
+  }
+
+  /**
+   * Sets an explicit direction on every text block in the selection.
+   *
+   * @param dir the direction, or null for automatic detection.
+   * @returns the command.
+   */
+  private setTextDirection(dir: Direction | null): Command {
+    return (state, dispatch) => {
+      if (isInCode(state)) {
+        return false;
+      }
+
+      const tr = state.tr;
+      forEachDirectionalBlock(state, (node, pos) => {
+        if ((node.attrs.dir ?? null) !== dir) {
+          tr.setNodeMarkup(pos, undefined, { ...node.attrs, dir });
+        }
+      });
+
+      if (!tr.docChanged) {
+        return false;
+      }
+      dispatch?.(tr);
+      return true;
+    };
+  }
+}
diff --git a/shared/editor/lib/carryBlockAttr.ts b/shared/editor/lib/carryBlockAttr.ts
new file mode 100644
index 0000000..7965162
--- /dev/null
+++ b/shared/editor/lib/carryBlockAttr.ts
@@ -0,0 +1,60 @@
+import type { EditorState, Transaction } from "prosemirror-state";
+
+/**
+ * Carries a block attribute, such as the text direction, from the block that
+ * held the cursor to a new empty block created by the transactions, e.g. when
+ * Enter is pressed at the end of a right-to-left paragraph. Meant to be called
+ * from a plugin's `appendTransaction`.
+ *
+ * @param attr the name of the attribute to carry.
+ * @param nodeNames the names of the nodes that carry the attribute.
+ * @param transactions the applied transactions.
+ * @param oldState the state before the transactions.
+ * @param newState the state after the transactions.
+ * @returns a transaction setting the attribute on the new block, or undefined.
+ */
+export function carryBlockAttr(
+  attr: string,
+  nodeNames: ReadonlySet<string>,
+  transactions: readonly Transaction[],
+  oldState: EditorState,
+  newState: EditorState
+): Transaction | undefined {
+  if (!transactions.some((tr) => tr.docChanged)) {
+    return undefined;
+  }
+
+  const $old = oldState.selection.$from;
+  const $new = newState.selection.$from;
+  const value = $old.parent.attrs[attr];
+  const block = $new.parent;
+
+  if (
+    !value ||
+    $old.depth === 0 ||
+    $new.depth === 0 ||
+    !newState.selection.empty ||
+    !nodeNames.has($old.parent.type.name) ||
+    !nodeNames.has(block.type.name) ||
+    block.content.size > 0 ||
+    block.attrs[attr]
+  ) {
+    return undefined;
+  }
+
+  // Only a new block: the block that held the cursor must not be the one that
+  // is now empty, e.g. after its attribute was cleared or its text deleted.
+  let mapped = $old.before();
+  for (const tr of transactions) {
+    mapped = tr.mapping.map(mapped);
+  }
+  const start = $new.before();
+  if (mapped === start) {
+    return undefined;
+  }
+
+  return newState.tr.setNodeMarkup(start, undefined, {
+    ...block.attrs,
+    [attr]: value,
+  });
+}
