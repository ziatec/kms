+  const [paragraph] = findNodes(ast?.toJSON(), "paragraph");
+
+  expect(paragraph?.attrs?.dir).toBe("rtl");
+  expect(paragraph?.content?.[0].text).toBe("Outline یک ویکی است");
+});
+
+it("turns a leading LRM into a left-to-right heading", () => {
+  const ast = parser.parse(`# ${LRM}سلام world`);
+  const [heading] = findNodes(ast?.toJSON(), "heading");
+
+  expect(heading?.attrs?.dir).toBe("ltr");
+});
+
+it("leaves paragraphs without a mark automatic", () => {
+  const ast = parser.parse("Outline یک ویکی است");
+  const [paragraph] = findNodes(ast?.toJSON(), "paragraph");
+
+  expect(paragraph?.attrs?.dir ?? null).toBeNull();
+});
+
+it("round-trips an explicit direction through Markdown", () => {
+  const markdown = `${RLM}Outline یک ویکی است`;
+  const output = serializer.serialize(parser.parse(markdown));
+
+  expect(output.startsWith(RLM)).toBe(true);
+  const [paragraph] = findNodes(parser.parse(output)?.toJSON(), "paragraph");
+  expect(paragraph?.attrs?.dir).toBe("rtl");
+});
+
+it("parses the onboarding documents without errors", () => {
+  // eslint-disable-next-line @typescript-eslint/no-var-requires
