@@ -0,0 +1,42 @@
+import type { TextAlign } from "@shared/editor/queries/getTextAlignment";
+
+type Props = {
+  /** The alignment shown by the icon. */
+  align: TextAlign;
+  /** The size of the icon, 24px is default to match standard icons. */
+  size?: number;
+  /** The color of the icon, defaults to the current text color. */
+  color?: string;
+};
+
+const paths: Record<TextAlign, string> = {
+  left: "M4 6h16M4 10h10M4 14h16M4 18h10",
+  center: "M4 6h16M7 10h10M4 14h16M7 18h10",
+  right: "M4 6h16M10 10h10M4 14h16M10 18h10",
+  justify: "M4 6h16M4 10h16M4 14h16M4 18h16",
+};
+
+/**
+ * An icon of four lines for left, centered, right or justified text.
+ */
+export default function TextAlignIcon({
+  align,
+  size = 24,
+  color = "currentColor",
+}: Props) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke={color}
+      strokeWidth="1.6"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+    >
+      <path d={paths[align]} />
+    </svg>
+  );
+}
