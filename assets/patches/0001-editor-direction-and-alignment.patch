+type Props = {
+  /** The direction shown by the icon; "auto" shows both arrows. */
+  dir: "rtl" | "ltr" | "auto";
+  /** Draws brackets instead of a paragraph mark, for an embedding in code. */
+  embedded?: boolean;
+  /** The size of the icon, 24px is default to match standard icons. */
+  size?: number;
+  /** The color of the icon, defaults to the current text color. */
+  color?: string;
+};
+
+/**
+ * An icon showing a paragraph mark with an arrow for the text direction.
+ */
+export default function TextDirectionIcon({
+  dir,
+  embedded,
+  size = 24,
+  color = "currentColor",
+}: Props) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke={color}
+      strokeWidth="1.6"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+    >
+      {embedded ? (
+        <>
+          <path d="M8 4H6v9h2" />
+          <path d="M16 4h2v9h-2" />
+          <path d="M10 6.5h4M10 10.5h4" />
+        </>
+      ) : (
+        <>
+          <path d="M10 4v10M14 4v10" />
+          <path d="M16 4h-6a3 3 0 0 0 0 6" />
+        </>
+      )}
+      <path d="M5 18h14" />
+      {dir !== "rtl" && <path d="M16.5 15.5 19 18l-2.5 2.5" />}
+      {dir !== "ltr" && <path d="M7.5 15.5 5 18l2.5 2.5" />}
+    </svg>
+  );
+}
