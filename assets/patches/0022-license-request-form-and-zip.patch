--- /dev/null
+++ b/server/license/zip.ts
@@ -0,0 +1,30 @@
+/**
+ * A tiny helper to put the license request into a .zip file.
+ *
+ * The request text is already encrypted for the vendor and signed by this
+ * server, so the entry is STORED (not compressed): the armored block stays
+ * verbatim in the zip bytes, so the vendor tool can read it even without a
+ * zip library. The zip is only a convenient, uniquely named container.
+ *
+ * VERSION: 1.0 (2026-10-16) — KMS patch 0022
+ */
+import { ZipFile } from "yazl";
+
+/**
+ * Build a zip with a single stored (uncompressed) text entry.
+ *
+ * @param entryName The name of the file inside the zip.
+ * @param text The file contents.
+ * @returns The zip as a Buffer.
+ */
+export function storeTextZip(entryName: string, text: string): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    const zip = new ZipFile();
+    const chunks: Buffer[] = [];
+    zip.outputStream.on("data", (c: Buffer) => chunks.push(c));
+    zip.outputStream.on("error", reject);
+    zip.outputStream.on("end", () => resolve(Buffer.concat(chunks)));
+    zip.addBuffer(Buffer.from(text, "utf8"), entryName, { compress: false });
+    zip.end();
+  });
+}
