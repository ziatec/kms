+/** A new random token and the file name that carries it. */
+export function newZipName() {
+  const bytes = randomBytes(10);
+  let bits = 0;
+  let value = 0;
+  let token = "";
+  for (const b of bytes) {
+    value = (value << 8) | b;
+    bits += 8;
+    while (bits >= 5) {
