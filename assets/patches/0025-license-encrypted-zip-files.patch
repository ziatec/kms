+/** The zip password for a file name (or a bare token). */
+export function zipPassword(fileNameOrToken: string) {
+  const token = tokenOf(fileNameOrToken) ?? (/^[A-Z2-7]{16}$/i.test(fileNameOrToken) ? fileNameOrToken.toUpperCase() : null);
+  if (!token) {
+    throw new ZipError(
