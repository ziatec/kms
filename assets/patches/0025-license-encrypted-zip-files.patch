+/** AES-CTR with WinZip's little-endian counter starting at 1. */
+function aesCtr(key: Buffer, data: Buffer) {
+  const ecb = createCipheriv(`aes-${key.length * 8}-ecb`, key, null);
+  ecb.setAutoPadding(false);
+  const out = Buffer.alloc(data.length);
+  const counter = Buffer.alloc(16);
+  for (let off = 0, n = 1; off < data.length; off += 16, n++) {
+    counter.fill(0);
+    let v = n;
+    for (let i = 0; i < 8 && v > 0; i++) {
+      counter[i] = v & 0xff;
+      v = Math.floor(v / 256);
+    }
+    const ks = ecb.update(counter);
+    const end = Math.min(16, data.length - off);
+    for (let i = 0; i < end; i++) {
+      out[off + i] = data[off + i] ^ ks[i];
+    }
+  }
+  return out;
+}
+
+function deriveKeys(password: string, salt: Buffer, strength: number) {
+  const len = KEY_LEN[strength];
+  const dk = pbkdf2Sync(Buffer.from(password, "utf8"), salt, 1000, 2 * len + 2, "sha1");
+  return { enc: dk.subarray(0, len), mac: dk.subarray(len, 2 * len), check: dk.subarray(2 * len) };
+}
+
+function dosDateTime(d: Date) {
+  const time = (d.getHours() << 11) | (d.getMinutes() << 5) | Math.floor(d.getSeconds() / 2);
+  const date = ((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate();
+  return { time, date };
+}
 
