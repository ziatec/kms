+export function readZip(zip: Buffer, password: string | null) {
+  if (zip.length < 22 || zip.readUInt32LE(0) !== 0x04034b50) {
+    throw new ZipError("not a zip file");
+  }
+  let eocd = -1;
+  for (let i = zip.length - 22; i >= Math.max(0, zip.length - 22 - 65535); i--) {
+    if (zip.readUInt32LE(i) === 0x06054b50) {
+      eocd = i;
+      break;
+    }
+  }
+  if (eocd < 0) {
+    throw new ZipError("damaged zip file (no central directory)");
+  }
+  const count = zip.readUInt16LE(eocd + 10);
+  let p = zip.readUInt32LE(eocd + 16);
+  for (let n = 0; n < count; n++) {
+    if (zip.readUInt32LE(p) !== 0x02014b50) {
+      throw new ZipError("damaged zip file");
+    }
+    const flags = zip.readUInt16LE(p + 8);
+    let method = zip.readUInt16LE(p + 10);
+    const compSize = zip.readUInt32LE(p + 20);
+    const nameLen = zip.readUInt16LE(p + 28);
+    const extraLen = zip.readUInt16LE(p + 30);
+    const commentLen = zip.readUInt16LE(p + 32);
+    const localOffset = zip.readUInt32LE(p + 42);
+    const name = zip.subarray(p + 46, p + 46 + nameLen).toString(flags & 0x0800 ? "utf8" : "latin1");
+    const extra = zip.subarray(p + 46 + nameLen, p + 46 + nameLen + extraLen);
+    p += 46 + nameLen + extraLen + commentLen;
+    if (name.endsWith("/")) {
+      continue;
+    }
+    const lNameLen = zip.readUInt16LE(localOffset + 26);
+    const lExtraLen = zip.readUInt16LE(localOffset + 28);
+    const start = localOffset + 30 + lNameLen + lExtraLen;
+    let data = zip.subarray(start, start + compSize);
+    if (flags & 0x0001) {
+      if (method !== 99) {
+        throw new ZipError("this zip uses the old ZipCrypto encryption; use AES-256");
+      }
+      let strength = 0;
+      for (let e = 0; e + 4 <= extra.length; ) {
+        const id = extra.readUInt16LE(e);
+        const size = extra.readUInt16LE(e + 2);
+        if (id === 0x9901) {
+          strength = extra.readUInt8(e + 8);
+          method = extra.readUInt16LE(e + 9);
+        }
+        e += 4 + size;
+      }
+      const len = KEY_LEN[strength];
+      if (!len) {
+        throw new ZipError("unsupported zip encryption");
+      }
+      if (password === null) {
+        throw new ZipError(
+          "file name must keep its KMS-XXXXXXXXXXXXXXXX part (the password comes from it)"
+        );
+      }
+      const salt = data.subarray(0, len / 2);
+      const keys = deriveKeys(password, salt, strength);
+      const check = data.subarray(len / 2, len / 2 + 2);
+      if (!check.equals(keys.check)) {
+        throw new ZipError("wrong zip password: was the file renamed?");
+      }
+      const ct = data.subarray(len / 2 + 2, data.length - 10);
+      const mac = createHmac("sha1", keys.mac).update(ct).digest().subarray(0, 10);
+      if (!timingSafeEqual(mac, data.subarray(data.length - 10))) {
+        throw new ZipError("the zip file is damaged or was changed");
+      }
+      data = aesCtr(keys.enc, ct);
+    }
+    if (method === 8) {
+      data = inflateRawSync(data);
+    } else if (method !== 0) {
+      throw new ZipError(`unsupported zip compression (${method})`);
+    }
+    return { name, data: Buffer.from(data) };
+  }
+  throw new ZipError("the zip file is empty");
 }
