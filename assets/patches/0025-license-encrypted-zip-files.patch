+export function writeEncryptedZip(entryName: string, data: Buffer | string, password: string) {
+  const plain = Buffer.isBuffer(data) ? data : Buffer.from(data, "utf8");
+  const salt = randomBytes(16);
+  const keys = deriveKeys(password, salt, 3);
+  const ct = aesCtr(keys.enc, deflateRawSync(plain));
+  const auth = createHmac("sha1", keys.mac).update(ct).digest().subarray(0, 10);
+  const body = Buffer.concat([salt, keys.check, ct, auth]);
+  const name = Buffer.from(entryName, "utf8");
+  // AES extra field: AE-2, "AE", strength 3 (256), real method 8 (deflate)
+  const extra = Buffer.alloc(11);
+  extra.writeUInt16LE(0x9901, 0);
+  extra.writeUInt16LE(7, 2);
+  extra.writeUInt16LE(2, 4);
+  extra.write("AE", 6, "latin1");
+  extra.writeUInt8(3, 8);
+  extra.writeUInt16LE(8, 9);
+  const { time, date } = dosDateTime(new Date());
+  const flags = 0x0001 | 0x0800; // encrypted, UTF-8 name
+
+  const local = Buffer.alloc(30);
+  local.writeUInt32LE(0x04034b50, 0);
+  local.writeUInt16LE(51, 4);
+  local.writeUInt16LE(flags, 6);
+  local.writeUInt16LE(99, 8);
+  local.writeUInt16LE(time, 10);
+  local.writeUInt16LE(date, 12);
+  local.writeUInt32LE(0, 14); // CRC is 0 in AE-2
+  local.writeUInt32LE(body.length, 18);
+  local.writeUInt32LE(plain.length, 22);
+  local.writeUInt16LE(name.length, 26);
+  local.writeUInt16LE(extra.length, 28);
+
+  const central = Buffer.alloc(46);
+  central.writeUInt32LE(0x02014b50, 0);
+  central.writeUInt16LE(0x033f, 4); // made by: Unix, 6.3
+  central.writeUInt16LE(51, 6);
+  central.writeUInt16LE(flags, 8);
+  central.writeUInt16LE(99, 10);
+  central.writeUInt16LE(time, 12);
+  central.writeUInt16LE(date, 14);
+  central.writeUInt32LE(0, 16);
+  central.writeUInt32LE(body.length, 20);
+  central.writeUInt32LE(plain.length, 24);
+  central.writeUInt16LE(name.length, 28);
+  central.writeUInt16LE(extra.length, 30);
+  central.writeUInt32LE((0o100644 << 16) >>> 0, 38);
+  central.writeUInt32LE(0, 42);
