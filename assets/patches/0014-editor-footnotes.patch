diff --git a/app/editor/extensions/Footnotes.tsx b/app/editor/extensions/Footnotes.tsx
new file mode 100644
index 0000000..baf9d60
--- /dev/null
+++ b/app/editor/extensions/Footnotes.tsx
@@ -0,0 +1,144 @@
+/**
+ * Shows the footnote tooltip while the pointer is over a footnote's text, its
+ * reference number or its entry in the list at the end of the document.
+ *
+ * VERSION: 1.0 (2026-10-14) — KMS patch 0014
+ */
+import { action, observable } from "mobx";
+import { Plugin } from "prosemirror-state";
+import type { WidgetProps } from "@shared/editor/lib/Extension";
+import Extension from "@shared/editor/lib/Extension";
+import FootnoteTooltip from "../components/FootnoteTooltip";
+
+const SHOW_DELAY = 120;
+const HIDE_DELAY = 250;
+const SELECTOR = "[data-footnote-id]";
+
+export default class Footnotes extends Extension {
+  state: { element: HTMLElement | null; id: string | null } = observable({
+    element: null,
+    id: null,
+  });
+
+  get name() {
+    return "footnote-tooltip";
+  }
+
+  get allowInReadOnly() {
+    return true;
+  }
+
+  get plugins() {
+    const findTarget = (node: EventTarget | null): HTMLElement | null => {
+      const element =
+        node instanceof Element ? node.closest<HTMLElement>(SELECTOR) : null;
+      return element && this.editor?.view?.dom.contains(element)
+        ? element
+        : null;
+    };
+
+    return [
+      new Plugin({
+        props: {
+          handleDOMEvents: {
+            mouseover: (_view, event) => {
+              const target = findTarget(event.target);
+              if (!target) {
+                return false;
+              }
+              const id = target.getAttribute("data-footnote-id");
+              if (!id || id === this.suppressedId) {
+                return false;
+              }
+              this.cancelHide();
+              if (this.state.id === id) {
+                return false;
+              }
+              this.cancelShow();
+              this.showTimer = setTimeout(
+                () => this.show(target, id),
+                SHOW_DELAY
+              );
+              return false;
+            },
+            mouseout: (_view, event) => {
+              const target = findTarget(event.target);
+              if (!target) {
+                return false;
+              }
+              const id = target.getAttribute("data-footnote-id");
+              const next = findTarget(event.relatedTarget);
+              if (next?.getAttribute("data-footnote-id") === id) {
+                return false;
+              }
+              if (id === this.suppressedId) {
+                this.suppressedId = null;
+              }
+              this.cancelShow();
+              this.scheduleHide();
+              return false;
+            },
+          },
+        },
+      }),
+    ];
+  }
+
+  widget = ({ readOnly }: WidgetProps) => (
+    <FootnoteTooltip
+      element={this.state.element}
+      id={this.state.id}
+      view={this.editor.view}
+      readOnly={readOnly}
+      onClose={this.close}
+      onPointerEnter={this.cancelHide}
+      onPointerLeave={this.scheduleHide}
+    />
+  );
+
+  private showTimer: ReturnType<typeof setTimeout> | undefined;
+
+  private hideTimer: ReturnType<typeof setTimeout> | undefined;
+
+  /** A footnote closed with its close button stays closed until the pointer leaves it. */
+  private suppressedId: string | null = null;
+
+  private show = action((element: HTMLElement, id: string) => {
+    this.state.element = element;
+    this.state.id = id;
+  });
+
+  private hide = action(() => {
+    this.state.element = null;
+    this.state.id = null;
+  });
+
+  private close = () => {
+    this.cancelShow();
+    this.cancelHide();
+    this.suppressedId = this.state.id;
+    this.hide();
+  };
+
+  private cancelShow = () => {
+    if (this.showTimer) {
+      clearTimeout(this.showTimer);
+      this.showTimer = undefined;
+    }
+  };
+
+  private cancelHide = () => {
+    if (this.hideTimer) {
+      clearTimeout(this.hideTimer);
+      this.hideTimer = undefined;
+    }
+  };
+
+  private scheduleHide = () => {
+    this.cancelHide();
+    this.hideTimer = setTimeout(() => {
+      this.suppressedId = null;
+      this.hide();
+    }, HIDE_DELAY);
+  };
+}
