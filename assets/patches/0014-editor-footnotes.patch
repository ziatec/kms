diff --git a/app/editor/components/FootnoteDialog.tsx b/app/editor/components/FootnoteDialog.tsx
new file mode 100644
index 0000000..d332b3c
--- /dev/null
+++ b/app/editor/components/FootnoteDialog.tsx
@@ -0,0 +1,265 @@
+/**
+ * Dialog to write or edit a footnote, and the helper that opens it.
+ *
+ * VERSION: 2.2 (2026-10-15) — KMS patch 0014
+ */
+import { t as translate } from "i18next";
+import type { EditorView } from "prosemirror-view";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import styled from "styled-components";
+import type { FootnoteKind } from "@shared/editor/marks/Footnote";
+import {
+  addFootnote,
+  findFootnote,
+  footnoteLetter,
+  localizeFootnoteLabel,
+  removeFootnote,
+  updateFootnote,
+} from "@shared/editor/marks/Footnote";
+import { getMixedTextDirection, isRTL } from "@shared/utils/rtl";
+import Button from "~/components/Button";
+import Flex from "~/components/Flex";
+import Input from "~/components/Input";
+import stores from "~/stores";
+
+/** The values entered in the dialog. */
+export interface FootnoteValues {
+  /** Custom label, empty for automatic numbering. */
+  label: string;
+  /** The note text. */
+  note: string;
+  /** Automatic numbering with numbers or with letters. */
+  kind: FootnoteKind;
+}
+
+/** The choices of the footnote type: automatic numbers or letters, or a label. */
+type Mode = FootnoteKind | "custom";
+
+type Props = {
+  /** The values shown when the dialog opens. */
+  initialValues: FootnoteValues;
+  /** The direction of the text the footnote belongs to. */
+  dir: "rtl" | "ltr";
+  /** Called with the entered values. */
+  onSubmit: (values: FootnoteValues) => void;
+  /** Called to delete the footnote; absent for a new footnote. */
+  onDelete?: () => void;
+};
+
+/**
+ * Opens the footnote dialog: for the footnote with the given id, for the
+ * footnote around the cursor, or for a new footnote on the selected text.
+ *
+ * @param view the editor view.
+ * @param id the id of an existing footnote to edit.
+ */
+export function openFootnoteDialog(view: EditorView, id?: string): void {
+  const { state } = view;
+  const type = state.schema.marks.footnote;
+  if (!type) {
+    return;
+  }
+
+  const existingId =
+    id ??
+    (
+      type.isInSet(state.selection.$from.marks()) ??
+      type.isInSet(state.selection.$to.marks()) ??
+      (state.selection.$from.nodeAfter
+        ? type.isInSet(state.selection.$from.nodeAfter.marks)
+        : undefined)
+    )?.attrs.id;
+  const entry = existingId
+    ? findFootnote(state, String(existingId))
+    : undefined;
+
+  const { from, to, $from } = state.selection;
+  const blockDir = $from.parent.attrs.dir;
+  const dir: "rtl" | "ltr" = entry
+    ? entry.dir
+    : blockDir === "rtl" || blockDir === "ltr"
+      ? blockDir
+      : isRTL($from.parent.textContent)
+        ? "rtl"
+        : "ltr";
+
+  const close = () => {
+    stores.dialogs.closeAllModals();
+    view.focus();
+  };
+
+  stores.dialogs.openModal({
+    title: entry ? translate("Edit footnote") : translate("Footnote"),
+    content: (
+      <FootnoteDialog
+        dir={dir}
+        initialValues={{
+          label: entry?.label ?? "",
+          note: entry?.note ?? "",
+          kind: entry?.kind ?? "number",
+        }}
+        onSubmit={(values) => {
+          if (entry) {
+            updateFootnote(entry.id, values)(view.state, view.dispatch);
+          } else {
+            addFootnote({ from, to }, values)(view.state, view.dispatch);
+          }
+          close();
+        }}
+        onDelete={
+          entry
+            ? () => {
+                removeFootnote(entry.id)(view.state, view.dispatch);
+                close();
+              }
+            : undefined
+        }
+      />
+    ),
+  });
+}
+
+/**
+ * The footnote form: the note text and its type, automatic numbers (1, 2, 3),
+ * automatic letters (الف، ب، پ or a, b, c) or a custom label.
+ */
+function FootnoteDialog({ initialValues, dir, onSubmit, onDelete }: Props) {
+  const { t } = useTranslation();
+  const [mode, setMode] = React.useState<Mode>(
+    initialValues.label ? "custom" : initialValues.kind
+  );
+  const [label, setLabel] = React.useState(initialValues.label);
+  const [note, setNote] = React.useState(initialValues.note);
+  const canSave =
+    note.trim().length > 0 && (mode !== "custom" || label.trim().length > 0);
+
+  const handleSubmit = React.useCallback(
+    (ev: React.SyntheticEvent) => {
+      ev.preventDefault();
+      if (!canSave) {
+        return;
+      }
+      onSubmit({
+        label: mode === "custom" ? label.trim() : "",
+        note: note.trim(),
+        kind: mode === "letter" ? "letter" : "number",
+      });
+    },
+    [canSave, label, mode, note, onSubmit]
+  );
+
+  const sample = (kind: FootnoteKind) =>
+    [1, 2, 3]
+      .map((n) =>
+        kind === "letter"
+          ? footnoteLetter(n, dir)
+          : localizeFootnoteLabel(String(n), dir)
+      )
+      .join(dir === "rtl" ? "، " : ", ");
+
+  const modes: { value: Mode; label: string }[] = [
+    { value: "number", label: `${t("Automatic numbers")} (${sample("number")})` },
+    { value: "letter", label: `${t("Automatic letters")} (${sample("letter")})` },
+    { value: "custom", label: t("Custom label") },
+  ];
+
+  return (
+    <form onSubmit={handleSubmit} dir={dir}>
+      <Flex column>
+        <Input
+          type="textarea"
+          label={t("Footnote text")}
+          value={note}
+          onChange={(ev) => setNote(ev.target.value)}
+          onRequestSubmit={handleSubmit}
+          dir={getMixedTextDirection(note, dir)}
+          autoFocus
+          autoSize
+          minHeight="4lh"
+          maxHeight="16lh"
+          flex
+        />
+        <TypeLabel>{t("Footnote type")}</TypeLabel>
+        <TypeSwitch role="radiogroup" aria-label={t("Footnote type")}>
+          {modes.map((option) => (
+            <button
+              key={option.value}
+              type="button"
+              role="radio"
+              aria-checked={mode === option.value}
+              onClick={() => setMode(option.value)}
+            >
+              {option.label}
+            </button>
+          ))}
+        </TypeSwitch>
+        {mode === "custom" && (
+          <>
+            <Input
+              type="text"
+              label={t("Footnote number")}
+              value={label}
+              onChange={(ev) => setLabel(ev.target.value)}
+              maxLength={12}
+              dir="auto"
+              flex
+            />
+            <Hint>{t("A number, letter or short text.")}</Hint>
+          </>
+        )}
+      </Flex>
+      <Flex justify="space-between" gap={8}>
+        {onDelete ? (
+          <Button type="button" onClick={onDelete} danger neutral>
+            {t("Delete footnote")}
+          </Button>
+        ) : (
+          <span />
+        )}
+        <Button type="submit" disabled={!canSave}>
+          {t("Save")}
+        </Button>
+      </Flex>
+    </form>
+  );
+}
+
+const TypeLabel = styled.div`
+  font-size: 13px;
+  font-weight: 500;
+  margin-bottom: 4px;
+  color: ${(props) => props.theme.textSecondary};
+`;
+
+const TypeSwitch = styled.div`
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  margin-bottom: 16px;
+
+  button {
+    flex: 1 1 auto;
+    border: 1px solid ${(props) => props.theme.inputBorder};
+    border-radius: 6px;
+    padding: 6px 10px;
+    background: none;
+    font-family: inherit;
+    font-size: 13px;
+    color: ${(props) => props.theme.text};
+    cursor: var(--pointer);
+
+    &[aria-checked="true"] {
+      background: ${(props) => props.theme.accent};
+      border-color: ${(props) => props.theme.accent};
+      color: ${(props) => props.theme.accentText};
+      font-weight: 600;
+    }
+  }
+`;
+
+const Hint = styled.p`
+  margin: -8px 0 16px;
+  font-size: 13px;
+  color: ${(props) => props.theme.textTertiary};
+`;
diff --git a/app/editor/components/FootnoteTooltip.tsx b/app/editor/components/FootnoteTooltip.tsx
new file mode 100644
index 0000000..1d28b30
--- /dev/null
+++ b/app/editor/components/FootnoteTooltip.tsx
@@ -0,0 +1,231 @@
+/**
+ * Tooltip shown while the pointer is over a footnote: the note text with
+ * edit, delete and close buttons. The buttons follow the interface language:
+ * in Persian edit is right of the text, close top left and delete bottom
+ * left; in English edit is left, close top right and delete bottom right.
+ *
+ * VERSION: 2.2 (2026-10-15) — KMS patch 0014
+ */
+import { observer } from "mobx-react";
+import { CloseIcon, EditIcon, TrashIcon } from "outline-icons";
+import type { EditorView } from "prosemirror-view";
+import * as React from "react";
+import { useTranslation } from "react-i18next";
+import { Portal } from "~/components/Portal";
+import styled from "styled-components";
+import { depths } from "@shared/styles";
+import { findFootnote, removeFootnote } from "@shared/editor/marks/Footnote";
+import { getMixedTextDirection } from "@shared/utils/rtl";
+import useEventListener from "~/hooks/useEventListener";
+import useKeyDown from "~/hooks/useKeyDown";
+import { openFootnoteDialog } from "./FootnoteDialog";
+
+type Props = {
+  /** The hovered footnote element, or null when closed. */
+  element: HTMLElement | null;
+  /** The id of the hovered footnote. */
+  id: string | null;
+  /** The editor view; absent until the editor has mounted. */
+  view?: EditorView;
+  /** Whether the document is read-only; hides the edit and delete buttons. */
+  readOnly?: boolean;
+  /** Closes the tooltip. */
+  onClose: () => void;
+  /** The pointer entered the tooltip. */
+  onPointerEnter: () => void;
+  /** The pointer left the tooltip. */
+  onPointerLeave: () => void;
+};
+
+const MARGIN = 8;
+
+/**
+ * Floating card for the hovered footnote.
+ */
+function FootnoteTooltip({
+  element,
+  id,
+  view,
+  readOnly,
+  onClose,
+  onPointerEnter,
+  onPointerLeave,
+}: Props) {
+  const { t, i18n } = useTranslation();
+  const uiDir = i18n.dir() === "rtl" ? "rtl" : "ltr";
+  const cardRef = React.useRef<HTMLDivElement>(null);
+  const [position, setPosition] = React.useState<{
+    top: number;
+    left: number;
+  } | null>(null);
+
+  const entry =
+    id && element && view ? findFootnote(view.state, id) : undefined;
+  const open = !!entry && !!element?.isConnected;
+
+  useKeyDown("Escape", () => open && onClose());
+  useEventListener("scroll", () => open && onClose(), window, {
+    capture: true,
+  });
+
+  React.useLayoutEffect(() => {
+    if (!open || !element || !cardRef.current) {
+      setPosition(null);
+      return;
+    }
+    const rects = element.getClientRects();
+    const anchor = rects.length
+      ? rects[rects.length - 1]
+      : element.getBoundingClientRect();
+    const card = cardRef.current.getBoundingClientRect();
+    const rtl = entry?.dir === "rtl";
+
+    let top = anchor.bottom + MARGIN;
+    if (top + card.height > window.innerHeight - MARGIN) {
+      top = Math.max(MARGIN, anchor.top - card.height - MARGIN);
+    }
+    let left = rtl ? anchor.right - card.width : anchor.left;
+    left = Math.min(left, window.innerWidth - card.width - MARGIN);
+    left = Math.max(MARGIN, left);
+    setPosition({ top, left });
+  }, [open, element, entry?.dir, entry?.note]);
+
+  if (!open || !entry || !view) {
+    return null;
+  }
+
+  const handleEdit = () => {
+    onClose();
+    openFootnoteDialog(view, entry.id);
+  };
+
+  const handleDelete = () => {
+    onClose();
+    removeFootnote(entry.id)(view.state, view.dispatch);
+  };
+
+  return (
+    <Portal toBody>
+      <Card
+        ref={cardRef}
+        role="tooltip"
+        dir={uiDir}
+        style={
+          position
+            ? { top: position.top, left: position.left }
+            : { top: -9999, left: -9999, visibility: "hidden" }
+        }
+        onMouseEnter={onPointerEnter}
+        onMouseLeave={onPointerLeave}
+      >
+        <Layout>
+          {!readOnly && (
+            <IconButton
+              type="button"
+              onClick={handleEdit}
+              title={t("Edit footnote")}
+              aria-label={t("Edit footnote")}
+              style={{ gridColumn: 1, gridRow: 1 }}
+            >
+              <EditIcon size={18} />
+            </IconButton>
+          )}
+          <Note
+            dir={getMixedTextDirection(entry.note, entry.dir)}
+            style={{ gridColumn: readOnly ? "1 / 3" : 2, gridRow: 1 }}
+          >
+            {entry.note}
+          </Note>
+          <IconButton
+            type="button"
+            onClick={onClose}
+            title={t("Close")}
+            aria-label={t("Close")}
+            style={{ gridColumn: 3, gridRow: 1 }}
+          >
+            <CloseIcon size={18} />
+          </IconButton>
+          {!readOnly && (
+            <IconButton
+              type="button"
+              onClick={handleDelete}
+              title={t("Delete footnote")}
+              aria-label={t("Delete footnote")}
+              style={{ gridColumn: 3, gridRow: 2 }}
+            >
+              <TrashIcon size={18} />
+            </IconButton>
+          )}
+        </Layout>
+      </Card>
+    </Portal>
+  );
+}
+
+const Card = styled.div`
+  position: fixed;
+  z-index: ${depths.hoverPreview};
+  max-width: min(360px, calc(100vw - 16px));
+  min-width: 180px;
+  padding: 8px 10px 10px;
+  border-radius: 8px;
+  /* KMS patch 0021: cream card in the light theme, gray in the dark one */
+  background: ${(props) => (props.theme.isDark ? "#3A3D44" : "#FFF8E6")};
+  color: ${(props) => props.theme.text};
+  border: 1px solid
+    ${(props) =>
+      props.theme.isDark ? "rgba(255, 255, 255, 0.12)" : "rgba(0, 0, 0, 0.1)"};
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
+  font-size: 14px;
+  line-height: 1.6;
+
+  @media print {
+    display: none;
+  }
+`;
+
+/* Edit | note | close on the first row, delete under close; the columns
+   follow the direction of the card (the interface language). */
+const Layout = styled.div`
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: start;
+  column-gap: 6px;
+  row-gap: 2px;
+`;
+
+const IconButton = styled.button`
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 24px;
+  height: 24px;
+  padding: 0;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+  opacity: 0.75;
+
+  svg {
+    fill: currentColor;
+  }
+
+  &:hover {
+    opacity: 1;
+    background: rgba(127, 127, 127, 0.25);
+  }
+`;
+
+const Note = styled.div`
+  unicode-bidi: isolate;
+  padding-top: 1px;
+  min-width: 0;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  max-height: 40vh;
+  overflow-y: auto;
+`;
+
+export default observer(FootnoteTooltip);
