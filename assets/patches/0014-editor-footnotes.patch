+export function getMixedTextDirection(
+  text: string,
+  fallback: "rtl" | "ltr"
+): "rtl" | "ltr" {
+  const hasRtl = anyRtlChar.test(text);
+  const hasLtr = anyLtrChar.test(text);
+  if (hasRtl && !hasLtr) {
+    return "rtl";
+  }
+  if (hasLtr && !hasRtl) {
+    return "ltr";
+  }
+  return fallback;
+}
