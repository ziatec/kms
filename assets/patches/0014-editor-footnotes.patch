@@ -0,0 +1,688 @@
+/**
+ * Footnote mark: a note attached to a piece of selected text.
+ *
+ * VERSION: 2.3 (2026-10-16) — KMS patch 0014
+ *
+ * The marked text gets a superscript reference right after it and the note is
+ * listed again in a "Footnotes" section at the end of the document. Both are
+ * decorations, so the document itself holds only the mark with its id, its
+ * optional custom label and the note text. Footnotes without a custom label
+ * are numbered automatically in document order, with numbers or with letters
+ * (kind): numbers and letters are two sequences, each without gaps, so
+ * deleting a footnote renumbers the ones after it. Numbers and labels use
+ * Persian digits (and Persian letters) in a right-to-left block and Latin
+ * ones in a left-to-right one.
+ */
+import type {
+  MarkSpec,
+  MarkType,
+  Node as ProsemirrorNode,
+  Mark as ProsemirrorMark,
+} from "prosemirror-model";
+import { Fragment, Slice } from "prosemirror-model";
+import type { Command, EditorState, Transaction } from "prosemirror-state";
+import { Plugin, PluginKey } from "prosemirror-state";
+import type { EditorView } from "prosemirror-view";
+import { Decoration, DecorationSet } from "prosemirror-view";
+import { v4 as uuidv4 } from "uuid";
+import { toPersianDigits } from "../../utils/calendar";
+import { getMixedTextDirection, isRTL } from "../../utils/rtl";
+import type { TextDirection } from "../../utils/bidi";
+import type { MarkdownSerializerState } from "../lib/markdown/serializer";
+import { isInCode } from "../queries/isInCode";
+import Mark from "./Mark";
+
+/** The attributes of a footnote mark. */
+export interface FootnoteAttrs {
+  /** Identifies the footnote; every run of text with this id is one footnote. */
+  id: string;
+  /** A custom reference label (number, letter or text); null numbers it automatically. */
+  label: string | null;
+  /** How it is numbered automatically: with numbers or with letters. */
+  kind: FootnoteKind;
+  /** The text of the note. */
+  note: string;
+}
+
+/** Automatic numbering of a footnote: 1, 2, 3 or a, b, c (الف، ب، پ). */
+export type FootnoteKind = "number" | "letter";
+
+/** The Persian letters used for lettered footnotes. */
+const PERSIAN_LETTERS = [
+  "الف",
+  "ب",
+  "پ",
+  "ت",
+  "ث",
+  "ج",
+  "چ",
+  "ح",
+  "خ",
+  "د",
+  "ذ",
+  "ر",
+  "ز",
+  "ژ",
+  "س",
+  "ش",
+  "ص",
+  "ض",
+  "ط",
+  "ظ",
+  "ع",
+  "غ",
+  "ف",
+  "ق",
+  "ک",
+  "گ",
+  "ل",
+  "م",
+  "ن",
+  "و",
+  "هـ",
+  "ی",
+];
+
+/**
+ * Writes the n-th letter: after the last letter two letters follow.
+ *
+ * @param n the number, 1 or more.
+ * @param dir the direction: Persian letters when right to left.
+ * @returns the letters.
+ */
+export function footnoteLetter(n: number, dir: TextDirection): string {
+  const letters =
+    dir === "rtl" ? PERSIAN_LETTERS : "abcdefghijklmnopqrstuvwxyz".split("");
+  const parts: string[] = [];
+  let rest = n;
+  while (rest > 0) {
+    parts.unshift(letters[(rest - 1) % letters.length]);
+    rest = Math.floor((rest - 1) / letters.length);
+  }
+  return parts.join(dir === "rtl" ? "\u200c" : "");
+}
+
+/**
+ * Reads the kind of automatic numbering.
+ *
+ * @param value the stored value.
+ * @returns "letter" or "number".
+ */
+export function toFootnoteKind(value: unknown): FootnoteKind {
+  return value === "letter" ? "letter" : "number";
+}
+
+/** A footnote found in the document, in document order. */
+export interface FootnoteEntry extends FootnoteAttrs {
+  /** The automatic number, or null when the footnote has a custom label. */
+  number: number | null;
+  /** The reference as shown, with digits for the direction. */
+  display: string;
+  /** The direction of the block holding the footnote. */
+  dir: TextDirection;
+  /** The position just after the last marked character. */
+  end: number;
+  /** The position of the first marked character. */
+  start: number;
+}
+
+/** Key of the plugin that draws the references and the footnote list. */
+export const footnotePluginKey = new PluginKey<DecorationSet>("footnotes");
+
+/** Class names shared with the app's tooltip and the editor styles. */
+export const FootnoteClass = {
+  text: "footnote",
+  ref: "footnote-ref",
+  list: "footnotes",
+  item: "footnote-item",
+  backref: "footnote-backref",
+} as const;
+
+/**
+ * Returns the label with its digits written for the direction.
+ *
+ * @param value the label or number.
+ * @param dir the direction of the surrounding text.
+ * @returns the localized label.
+ */
+export function localizeFootnoteLabel(
+  value: string,
+  dir: TextDirection
+): string {
+  if (dir === "rtl") {
+    return toPersianDigits(value);
+  }
+  return value
+    .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
+    .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660));
+}
+
+/**
+ * Lists the footnotes of a document in the order they first appear.
+ *
+ * @param doc the document.
+ * @param type the footnote mark type.
+ * @returns the footnotes.
+ */
+export function getFootnotes(
+  doc: ProsemirrorNode,
+  type: MarkType
+): FootnoteEntry[] {
+  const byId = new Map<string, FootnoteEntry>();
+  const entries: FootnoteEntry[] = [];
+
+  doc.descendants((node, pos, parent) => {
+    if (!node.isText) {
+      return true;
+    }
+    const mark = type.isInSet(node.marks);
+    if (!mark || !mark.attrs.id) {
+      return false;
+    }
+    const id = String(mark.attrs.id);
+    const end = pos + node.nodeSize;
+    const existing = byId.get(id);
+    if (existing) {
+      existing.end = Math.max(existing.end, end);
+      return false;
+    }
+    const explicit = parent?.attrs.dir;
+    const dir: TextDirection =
+      explicit === "rtl" || explicit === "ltr"
+        ? explicit
+        : isRTL(parent?.textContent ?? "")
+          ? "rtl"
+          : "ltr";
+    const label =
+      typeof mark.attrs.label === "string" && mark.attrs.label.trim()
+        ? mark.attrs.label.trim()
+        : null;
+    const entry: FootnoteEntry = {
+      id,
+      label,
+      kind: toFootnoteKind(mark.attrs.kind),
+      note: String(mark.attrs.note ?? ""),
+      number: null,
+      display: "",
+      dir,
+      start: pos,
+      end,
+    };
+    byId.set(id, entry);
+    entries.push(entry);
+    return false;
+  });
+
+  // Numbers and letters are two sequences; footnotes with a custom label
+  // are not counted.
+  let numbers = 0;
+  let letters = 0;
+  for (const entry of entries) {
+    if (entry.label !== null) {
+      entry.display = localizeFootnoteLabel(entry.label, entry.dir);
+      continue;
+    }
+    if (entry.kind === "letter") {
+      letters += 1;
+      entry.number = letters;
+      entry.display = footnoteLetter(letters, entry.dir);
+    } else {
+      numbers += 1;
+      entry.number = numbers;
+      entry.display = localizeFootnoteLabel(String(numbers), entry.dir);
+    }
+  }
+  return entries;
+}
+
+/**
+ * Finds one footnote by id.
+ *
+ * @param state the editor state.
+ * @param id the footnote id.
+ * @returns the footnote, or undefined.
+ */
+export function findFootnote(
+  state: EditorState,
+  id: string
+): FootnoteEntry | undefined {
+  const type = state.schema.marks.footnote;
+  if (!type) {
+    return undefined;
+  }
+  return getFootnotes(state.doc, type).find((entry) => entry.id === id);
+}
+
+/**
+ * Attaches a new footnote to a range of text.
+ *
+ * @param range the range to mark, the selection when omitted.
+ * @param attrs the label and note.
+ * @returns the command.
+ */
+export function addFootnote(
+  range: { from: number; to: number } | null,
+  attrs: { label?: string | null; note: string; kind?: FootnoteKind }
+): Command {
+  return (state, dispatch) => {
+    const type = state.schema.marks.footnote;
+    if (!type || isInCode(state)) {
+      return false;
+    }
+    const from = range ? range.from : state.selection.from;
+    const to = range ? range.to : state.selection.to;
+    const max = state.doc.content.size;
+    if (from >= to || from < 0 || to > max) {
+      return false;
+    }
+    const mark = type.create({
+      id: uuidv4(),
+      label: attrs.label?.trim() || null,
+      note: attrs.note,
+      kind: toFootnoteKind(attrs.kind),
+    });
+    dispatch?.(state.tr.removeMark(from, to, type).addMark(from, to, mark));
+    return true;
+  };
+}
+
+/**
+ * Changes the label or note of a footnote.
+ *
+ * @param id the footnote id.
+ * @param attrs the new label and note.
+ * @returns the command.
+ */
+export function updateFootnote(
+  id: string,
+  attrs: { label?: string | null; note: string; kind?: FootnoteKind }
+): Command {
+  return (state, dispatch) =>
+    replaceFootnoteMarks(state, id, dispatch, (type, mark) =>
+      type.create({
+        ...mark.attrs,
+        label: attrs.label?.trim() || null,
+        note: attrs.note,
+        kind: toFootnoteKind(attrs.kind ?? mark.attrs.kind),
+      })
+    );
+}
+
+/**
+ * Removes a footnote; the text it was attached to stays.
+ *
+ * @param id the footnote id.
+ * @returns the command.
+ */
+export function removeFootnote(id: string): Command {
+  return (state, dispatch) =>
+    replaceFootnoteMarks(state, id, dispatch, () => null);
+}
+
+export default class Footnote extends Mark {
+  get name() {
+    return "footnote";
+  }
+
+  get schema(): MarkSpec {
+    return {
+      attrs: {
+        id: { default: "", validate: "string" },
+        label: { default: null },
+        kind: { default: "number" },
+        note: { default: "", validate: "string" },
+      },
+      inclusive: false,
+      excludes: "footnote",
+      parseDOM: [
+        {
+          tag: "span[data-footnote]",
+          getAttrs: (dom: HTMLElement) => ({
+            id: dom.getAttribute("data-footnote-id") || uuidv4(),
+            label: dom.getAttribute("data-footnote-label") || null,
+            kind: toFootnoteKind(dom.getAttribute("data-footnote-kind")),
+            note: dom.getAttribute("data-footnote-note") || "",
+          }),
+        },
+      ],
+      toDOM: (mark) => [
+        "span",
+        {
+          class: FootnoteClass.text,
+          "data-footnote": "",
+          "data-footnote-id": String(mark.attrs.id),
+          "data-footnote-label": mark.attrs.label ?? "",
+          "data-footnote-kind": toFootnoteKind(mark.attrs.kind),
+          "data-footnote-note": String(mark.attrs.note ?? ""),
+        },
+        0,
+      ],
+    };
+  }
+
+  commands() {
+    return {
+      footnote: (attrs?: unknown) => {
+        const input = (attrs ?? {}) as {
+          label?: string;
+          note?: string;
+          kind?: string;
+        };
+        return addFootnote(null, {
+          label: input.label ?? null,
+          note: input.note ?? "",
+          kind: toFootnoteKind(input.kind),
+        });
+      },
+      updateFootnote: (attrs?: unknown) => {
+        const input = (attrs ?? {}) as {
+          id?: string;
+          label?: string;
+          note?: string;
+          kind?: string;
+        };
+        return updateFootnote(input.id ?? "", {
+          label: input.label ?? null,
+          note: input.note ?? "",
+          kind: input.kind ? toFootnoteKind(input.kind) : undefined,
+        });
+      },
+      removeFootnote: (attrs?: unknown) =>
+        removeFootnote(String((attrs as { id?: string } | undefined)?.id)),
+    };
+  }
+
+  get plugins() {
+    const type = (state: EditorState) => state.schema.marks.footnote;
+
+    return [
+      new Plugin<DecorationSet>({
+        key: footnotePluginKey,
+        state: {
+          init: (_, state) => buildDecorations(state.doc, type(state)),
+          apply: (tr, old, _oldState, newState) =>
+            tr.docChanged ? buildDecorations(tr.doc, type(newState)) : old,
+        },
+        props: {
+          decorations: (state) => footnotePluginKey.getState(state),
+          // Text copied within the document keeps its data attributes; a
+          // pasted footnote gets a new id so it does not merge with the
+          // original.
+          transformPasted: (slice, view) =>
+            renewFootnoteIds(slice, type(view.state)),
+          handleDOMEvents: {
+            mousedown: (_view, event) => {
+              const target = event.target as HTMLElement | null;
+              return !!target?.closest(
+                `.${FootnoteClass.ref}, .${FootnoteClass.list}`
+              );
+            },
+          },
+        },
+        // The click is listened to on the editor element itself, not through
+        // handleDOMEvents: another plugin earlier in the list (the Mermaid
+        // diagrams of code blocks) returns true for every click, and then
+        // ProseMirror does not ask this plugin (KMS patch 0014 v2.1).
+        view: (view) => {
+          const onClick = (event: MouseEvent) =>
+            handleFootnoteClick(view, event);
+          const dom = view.dom;
+          dom.addEventListener("click", onClick);
+          return {
+            destroy: () => dom.removeEventListener("click", onClick),
+          };
+        },
+      }),
+    ];
+  }
+
+  toMarkdown() {
+    // Pandoc-style inline footnote after the text: text^[note].
+    return {
+      open: "",
+      close: (_state: MarkdownSerializerState, mark: ProsemirrorMark) =>
+        mark.attrs.note
+          ? `^[${String(mark.attrs.note).replace(/[[\]\\]/g, "\\$&")}]`
+          : "",
+      mixable: true,
+      expelEnclosingWhitespace: true,
+    };
+  }
+}
+
+/**
+ * Replaces every footnote mark with the id by the result of `make`, or removes
+ * it when `make` returns null.
+ */
+function replaceFootnoteMarks(
+  state: EditorState,
+  id: string,
+  dispatch: ((tr: Transaction) => void) | undefined,
+  make: (type: MarkType, mark: ProsemirrorMark) => ProsemirrorMark | null
+): boolean {
+  const type = state.schema.marks.footnote;
+  if (!type || !id) {
+    return false;
+  }
+  const tr = state.tr;
+  let found = false;
+  state.doc.descendants((node, pos) => {
+    if (!node.isText) {
+      return true;
+    }
+    const mark = type.isInSet(node.marks);
+    if (mark && mark.attrs.id === id) {
+      found = true;
+      const from = pos;
+      const to = pos + node.nodeSize;
+      tr.removeMark(from, to, type);
+      const next = make(type, mark);
+      if (next) {
+        tr.addMark(from, to, next);
+      }
+    }
+    return false;
+  });
+  if (!found) {
+    return false;
+  }
+  dispatch?.(tr);
+  return true;
+}
+
+/** Builds the reference and list decorations. */
+function buildDecorations(
+  doc: ProsemirrorNode,
+  type: MarkType | undefined
+): DecorationSet {
+  if (!type) {
+    return DecorationSet.empty;
+  }
+  const entries = getFootnotes(doc, type);
+  if (!entries.length) {
+    return DecorationSet.empty;
+  }
+
+  const decorations = entries.map((entry) =>
+    Decoration.widget(entry.end, () => renderReference(entry), {
+      side: -1,
+      ignoreSelection: true,
+      key: `fnref:${entry.id}:${entry.display}:${entry.dir}`,
+    })
+  );
+
+  const listKey = entries
+    .map((e) => `${e.id}|${e.display}|${e.dir}|${e.note}`)
+    .join("\u0000");
+  decorations.push(
+    Decoration.widget(doc.content.size, () => renderList(entries), {
+      side: 1,
+      ignoreSelection: true,
+      key: `fnlist:${hash(listKey)}`,
+    })
+  );
+
+  return DecorationSet.create(doc, decorations);
+}
+
+/** The superscript reference after the marked text. */
+function renderReference(entry: FootnoteEntry): HTMLElement {
+  const sup = document.createElement("sup");
+  sup.className = FootnoteClass.ref;
+  sup.contentEditable = "false";
+  sup.dir = entry.dir;
+  sup.id = `fnref-${entry.id}`;
+  sup.setAttribute("data-footnote-id", entry.id);
+  sup.setAttribute("role", "doc-noteref");
+  sup.textContent = entry.display;
+  return sup;
+}
+
+/** The list of footnotes at the end of the document. */
+function renderList(entries: FootnoteEntry[]): HTMLElement {
+  const rtlCount = entries.filter((e) => e.dir === "rtl").length;
+  const dir: TextDirection =
+    rtlCount * 2 > entries.length
+      ? "rtl"
+      : rtlCount * 2 < entries.length
+        ? "ltr"
+        : entries[0].dir;
+
+  const section = document.createElement("section");
+  section.className = FootnoteClass.list;
+  section.contentEditable = "false";
+  section.dir = dir;
+  section.setAttribute("role", "doc-endnotes");
+
+  const title = document.createElement("div");
+  title.className = "footnotes-title";
+  title.textContent = dir === "rtl" ? "پانویس‌ها" : "Footnotes";
+  section.appendChild(title);
+
+  const list = document.createElement("ol");
+  for (const entry of entries) {
+    const item = document.createElement("li");
+    item.className = FootnoteClass.item;
+    item.id = `fn-${entry.id}`;
+    item.dir = entry.dir;
+    item.setAttribute("data-footnote-id", entry.id);
+
+    const back = document.createElement("span");
+    back.className = FootnoteClass.backref;
+    back.setAttribute("data-footnote-id", entry.id);
+    back.setAttribute("role", "doc-backlink");
+    back.textContent = entry.display;
+
+    const note = document.createElement("span");
+    note.className = "footnote-note";
+    // KMS patch 0022: not "auto" (first strong letter): a Persian note that
+    // starts with a Latin word must still be laid out right-to-left.
+    note.dir = getMixedTextDirection(entry.note, entry.dir);
+    note.style.unicodeBidi = "isolate";
+    note.textContent = entry.note;
+
+    item.append(back, note);
+    list.appendChild(item);
+  }
+  section.appendChild(list);
+  return section;
+}
+
+/** Jumps between a reference and its entry in the list. */
+function handleFootnoteClick(view: EditorView, event: MouseEvent): boolean {
+  const target = event.target as HTMLElement | null;
+  const ref = target?.closest(`.${FootnoteClass.ref}`);
+  const back = target?.closest(`.${FootnoteClass.backref}`);
+  // KMS patch 0021: a click anywhere on an entry of the list at the end (not
+  // only on its number) jumps to the footnote in the text, unless the click
+  // ends a text selection made inside the entry.
+  const item = target?.closest(`.${FootnoteClass.item}`);
+  if (item && !ref && !back) {
+    const selection = view.dom.ownerDocument.getSelection();
+    if (
+      selection &&
+      !selection.isCollapsed &&
+      item.contains(selection.anchorNode)
+    ) {
+      return false;
+    }
+  }
+  const element = ref ?? back ?? item;
+  if (!element) {
+    return false;
+  }
+  const id = element.getAttribute("data-footnote-id");
+  const selector = ref ? `#fn-${id}` : `#fnref-${id}`;
+  const dest = view.dom.querySelector(selector);
+  if (dest instanceof HTMLElement) {
+    event.preventDefault();
+    dest.scrollIntoView({ behavior: "smooth", block: "center" });
+    // KMS patch 0014 v2.3: going to the text, the whole footnoted text pulses
+    // (highlight that beats three times) and its number grows and shrinks
+    // with it; going to the list, the entry flashes as before. Long enough
+    // to be seen after the scroll.
+    const targets: HTMLElement[] = [dest];
+    if (!ref && id) {
+      view.dom
+        .querySelectorAll<HTMLElement>(
+          `.${FootnoteClass.text}[data-footnote-id="${CSS.escape(id)}"]`
+        )
+        .forEach((span) => targets.push(span));
+    }
+    const className = ref ? "footnote-flash" : "footnote-pulse";
+    for (const target of targets) {
+      target.classList.remove(className);
+      void target.offsetWidth; // restarts the animation on a second click
+      target.classList.add(className);
+    }
+    window.setTimeout(
+      () => targets.forEach((target) => target.classList.remove(className)),
+      3200
+    );
+    return true;
+  }
+  return false;
+}
+
+/** Gives pasted footnotes new ids, keeping runs that shared an id together. */
+function renewFootnoteIds(slice: Slice, type: MarkType | undefined): Slice {
+  if (!type) {
+    return slice;
+  }
+  const ids = new Map<string, string>();
+  const mapFragment = (fragment: Fragment): Fragment => {
+    const nodes: ProsemirrorNode[] = [];
+    fragment.forEach((node) => {
+      if (node.isText) {
+        const mark = type.isInSet(node.marks);
+        if (mark) {
+          const oldId = String(mark.attrs.id);
+          const newId = ids.get(oldId) ?? uuidv4();
+          ids.set(oldId, newId);
+          nodes.push(
+            node.mark(
+              type
+                .create({ ...mark.attrs, id: newId })
+                .addToSet(mark.removeFromSet(node.marks))
+            )
+          );
+          return;
+        }
+        nodes.push(node);
+        return;
+      }
+      nodes.push(node.copy(mapFragment(node.content)));
+    });
+    return Fragment.fromArray(nodes);
+  };
+  return new Slice(mapFragment(slice.content), slice.openStart, slice.openEnd);
+}
+
+/** A short, stable hash for decoration keys. */
+function hash(value: string): string {
+  let h = 0;
+  for (let i = 0; i < value.length; i++) {
+    h = (Math.imul(31, h) + value.charCodeAt(i)) | 0;
+  }
+  return (h >>> 0).toString(36);
+}
