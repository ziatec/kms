  M app/editor/components/FloatingToolbar.tsx
  M shared/editor/components/Styles.ts
  N shared/editor/extensions/MultiSelection.ts
  M shared/editor/lib/ExtensionManager.ts
  N shared/editor/lib/multiSelection.test.ts
  N shared/editor/lib/multiSelection.ts
  M shared/editor/nodes/index.ts

