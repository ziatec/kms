index 0000000..f7faf8b
--- /dev/null
+++ b/shared/editor/extensions/MultiSelection.ts
@@ -0,0 +1,407 @@
+// VERSION: 1.5 (2026-10-15) patch 0017-multi-selection
+import type { Command } from "prosemirror-state";
+import { Plugin, TextSelection } from "prosemirror-state";
+import type { EditorView } from "prosemirror-view";
+import { Decoration, DecorationSet } from "prosemirror-view";
+import { isMac } from "../../utils/browser";
+import { isModKey } from "../../utils/keyboard";
+import Extension from "../lib/Extension";
+import type {
+  MultiSelectionMeta,
+  MultiSelectionState,
+  SelectedRange,
+} from "../lib/multiSelection";
+import {
+  getExtraRanges,
+  mapRanges,
+  multiSelectionKey,
+  normalizeRanges,
+  rangeOfSelection,
+} from "../lib/multiSelection";
+
+const EMPTY: MultiSelectionState = { ranges: [], gesture: false, held: false };
+
+/** The key that picks parts: Cmd on Mac, Ctrl elsewhere. */
+const MOD_KEY = isMac ? "Meta" : "Control";
+
+/** Views that listen for the release of Ctrl/Cmd. */
+const watching = new WeakSet<EditorView>();
+
+/**
+ * Hides the formatting toolbar until Ctrl/Cmd is released, so it does not
+ * cover the text still to be picked.
+ *
+ * @param view the editor view.
+ */
+function holdUntilRelease(view: EditorView) {
+  if (watching.has(view)) {
+    return;
+  }
+  watching.add(view);
+  const ownerWindow = view.dom.ownerDocument.defaultView ?? window;
+  const release = () => {
+    watching.delete(view);
+    ownerWindow.removeEventListener("keyup", onKeyUp, true);
+    ownerWindow.removeEventListener("mousemove", onMove, true);
+    ownerWindow.removeEventListener("blur", release);
+    if (!view.isDestroyed && multiSelectionKey.getState(view.state)?.held) {
+      // The toolbar only renders again when the selection object changes, so
+      // the same selection is set anew.
+      const { state } = view;
+      const tr = state.tr;
+      view.dispatch(
+        tr
+          .setSelection(state.selection.map(tr.doc, tr.mapping))
+          .setMeta(multiSelectionKey, { held: false } satisfies MultiSelectionMeta)
+          .setMeta("addToHistory", false)
+      );
+    }
+  };
+  const onKeyUp = (event: KeyboardEvent) => {
+    if (event.key === MOD_KEY || !isModKey(event)) {
+      release();
+    }
+  };
+  // A release missed (e.g. outside the window) is seen on the next move.
+  const onMove = (event: MouseEvent) => {
+    if (!isModKey(event)) {
+      release();
+    }
+  };
+  ownerWindow.addEventListener("keyup", onKeyUp, true);
+  ownerWindow.addEventListener("mousemove", onMove, true);
+  ownerWindow.addEventListener("blur", release);
+}
+
+/** Meta of the collaboration plugin on remote changes. */
+const Y_SYNC_META = "y-sync$";
+
+/** Keys that change the text: typing them drops the other parts. */
+const EDIT_KEYS = new Set(["Backspace", "Delete", "Enter", "Tab"]);
+
+/** Keys that move the cursor: they end picking with the mouse. */
+const MOVE_KEYS = new Set([
+  "ArrowLeft",
+  "ArrowRight",
+  "ArrowUp",
+  "ArrowDown",
+  "Home",
+  "End",
+  "PageUp",
+  "PageDown",
+]);
+
+/**
+ * The parts picked before the first click of a double or triple click, by
+ * view: the later clicks of the series only grow the same selection.
+ */
+const clickSeries = new WeakMap<EditorView, SelectedRange[]>();
+
+/**
+ * Views whose current click series started on a picked part: the double or
+ * triple click then removes what it covers instead of picking it.
+ */
+const deselectSeries = new WeakSet<EditorView>();
+
+/**
+ * Sets the multi-selection state.
+ *
+ * @param view the editor view.
+ * @param meta the new state.
+ */
+function setRanges(view: EditorView, meta: MultiSelectionMeta) {
+  view.dispatch(
+    view.state.tr
+      .setMeta(multiSelectionKey, meta)
+      .setMeta("addToHistory", false)
+  );
+}
+
+/**
+ * Firefox keeps a native range for every Ctrl+drag, and ProseMirror then
+ * reads one selection from the first to the last of them, which also covers
+ * the text in between. Returns the range of the last drag: the native range
+ * that is not one of the picked parts.
+ *
+ * @param view the editor view.
+ * @param extras the picked parts.
+ * @returns the part of the last drag, or null when there is one native range.
+ */
+function newDomRange(
+  view: EditorView,
+  extras: SelectedRange[]
+): SelectedRange | null {
+  const domSelection = (view.root as Document).getSelection?.();
+  if (!domSelection || domSelection.rangeCount < 2) {
+    return null;
+  }
+  for (let i = domSelection.rangeCount - 1; i >= 0; i--) {
+    const range = domSelection.getRangeAt(i);
+    if (range.collapsed) {
+      continue;
+    }
+    try {
+      const from = view.posAtDOM(range.startContainer, range.startOffset, 1);
+      const to = view.posAtDOM(range.endContainer, range.endOffset, -1);
+      if (
+        to > from &&
+        !extras.some((r) => r.from < to && r.to > from)
+      ) {
+        return { from, to };
+      }
+    } catch (_err) {
+      // A range outside the editor is skipped.
+    }
+  }
+  return null;
+}
+
+/**
+ * Ends a Ctrl/Cmd click: the new selection is added to the parts, or a part
+ * clicked again is removed (a double or triple click that starts on a picked
+ * part removes every part in the word, line or paragraph it selects). The editor selection always holds
+ * one of the parts, so the formatting toolbar stays open.
+ *
+ * @param view the editor view.
+ * @param clicks 1 for a click, 2 or 3 for a double or triple click.
+ */
+function endGesture(view: EditorView, clicks: number) {
+  if (view.isDestroyed) {
+    return;
+  }
+  const { state } = view;
+  const { selection } = state;
+  let extras = getExtraRanges(state);
+  let main: SelectedRange | null =
+    newDomRange(view, extras) ?? rangeOfSelection(selection);
+
+  // A part picked again (or clicked inside) with a single click is removed.
+  // The later clicks of a series that started on a picked part remove all
+  // parts the selected word, line or paragraph overlaps.
+  const deselecting = clicks > 1 && deselectSeries.has(view);
+  const hit = deselecting
+    ? extras.filter((r) =>
+        main
+          ? r.from < main.to && r.to > main.from
+          : selection.from >= r.from && selection.from <= r.to
+      )
+    : (clicks > 1 ? [] : extras).filter((r) =>
+        main
+          ? main.from >= r.from && main.to <= r.to
+          : selection.from >= r.from && selection.from <= r.to
+      );
+  if (clicks === 1) {
+    if (hit.length) {
+      deselectSeries.add(view);
+    } else {
+      deselectSeries.delete(view);
+    }
+  }
+  if (hit.length || deselecting) {
+    extras = extras.filter((r) => !hit.includes(r));
+    main = null;
+  } else if (main) {
+    const m = main;
+    extras = extras.filter((r) => r.to <= m.from || r.from >= m.to);
+  }
+  if (!main && extras.length) {
+    main = extras[extras.length - 1];
+    extras = extras.slice(0, -1);
+  }
+
+  const tr = state.tr
+    .setMeta(multiSelectionKey, { ranges: extras } satisfies MultiSelectionMeta)
+    .setMeta("addToHistory", false);
+  if (main) {
+    tr.setSelection(TextSelection.create(state.doc, main.from, main.to));
+  } else if (hit.length || deselecting) {
+    tr.setSelection(TextSelection.near(state.doc.resolve(selection.from)));
+  }
+  view.dispatch(tr);
+
+  // Firefox keeps a native range for each Ctrl+drag; keep only the one of
+  // the editor selection.
+  const domSelection = (view.root as Document).getSelection?.();
+  if (domSelection && domSelection.rangeCount > 1) {
+    domSelection.removeAllRanges();
+    try {
+      const start = view.domAtPos(view.state.selection.from);
+      const end = view.domAtPos(view.state.selection.to);
+      const range = view.dom.ownerDocument.createRange();
+      range.setStart(start.node, start.offset);
+      range.setEnd(end.node, end.offset);
+      domSelection.addRange(range);
+    } catch (_err) {
+      // ProseMirror sets the native selection again on the next update.
+    }
+  }
+}
+
+/**
+ * Picks several separate parts of a document: hold Ctrl (Cmd on Mac) and
+ * select text with the mouse, or Ctrl+click a paragraph to pick all of it.
+ * Ctrl+click on a picked part removes it, Escape or a click without Ctrl
+ * drops the parts. Formatting (bold, color, font, highlight, alignment,
+ * direction, headings, lists, numbering) is then applied to all parts at once
+ * by the editor commands (see ExtensionManager and lib/multiSelection).
+ */
+export default class MultiSelection extends Extension {
+  get name() {
+    return "multi_selection";
+  }
+
+  /**
+   * Runs an editor command on all parts when other parts are picked.
+   *
+   * @param name the command name.
+   * @returns the key handler.
+   */
+  private runCommand(name: string): Command {
+    return (state) => {
+      if (!getExtraRanges(state).length) {
+        return false;
+      }
+      const command = this.editor?.commands?.[name];
+      if (!command) {
+        return false;
+      }
+      command();
+      return true;
+    };
+  }
+
+  keys(): Record<string, Command> {
+    return {
+      "Mod-b": this.runCommand("strong"),
+      "Mod-B": this.runCommand("strong"),
+      "Mod-i": this.runCommand("em"),
+      "Mod-I": this.runCommand("em"),
+      "Mod-u": this.runCommand("underline"),
+      "Mod-d": this.runCommand("strikethrough"),
+      "Mod-e": this.runCommand("code_inline"),
+      "Mod-Shift-h": this.runCommand("highlight"),
+      "Shift-Ctrl-9": this.runCommand("ordered_list"),
+      "Shift-Ctrl-8": this.runCommand("bullet_list"),
+      "Shift-Ctrl-7": this.runCommand("checkbox_list"),
+    };
+  }
+
+  get plugins() {
+    return [
+      new Plugin<MultiSelectionState>({
+        key: multiSelectionKey,
+        state: {
+          init: () => EMPTY,
+          apply: (tr, value) => {
+            const meta = tr.getMeta(multiSelectionKey) as
+              | MultiSelectionMeta
+              | undefined;
+            if (meta) {
+              return {
+                ranges: meta.ranges
+                  ? normalizeRanges(meta.ranges)
+                  : mapRanges(value.ranges, tr),
+                gesture: meta.gesture ?? value.gesture,
+                held: meta.held ?? value.held,
+              };
+            }
+            if (!value.ranges.length) {
+              return value;
+            }
+            // Remote changes, changes made by plugins and selections made
+            // with the mouse and Ctrl/Cmd (also the ones the browser reports
+            // late, e.g. after a triple click) keep the parts; any other
+            // selection change drops them. "gesture" stays on until the next
+            // click without Ctrl/Cmd or a key.
+            if (tr.getMeta(Y_SYNC_META) || value.gesture || !tr.selectionSet) {
+              return tr.docChanged
+                ? { ...value, ranges: mapRanges(value.ranges, tr) }
+                : value;
+            }
+            return { ...EMPTY, held: value.held };
+          },
+        },
+        props: {
+          decorations: (state) => {
+            const ranges = getExtraRanges(state);
+            if (!ranges.length) {
+              return null;
+            }
+            return DecorationSet.create(
+              state.doc,
+              ranges.map((r) =>
+                Decoration.inline(r.from, r.to, { class: "multi-selection" })
+              )
+            );
+          },
+          handleKeyDown: (view, event) => {
+            if (!getExtraRanges(view.state).length) {
+              return false;
+            }
+            if (event.key === "Escape") {
+              setRanges(view, { ranges: [], gesture: false });
+              return true;
+            }
+            if (MOVE_KEYS.has(event.key)) {
+              setRanges(view, { gesture: false });
+            }
+            if (
+              !event.ctrlKey &&
+              !event.metaKey &&
+              !event.altKey &&
+              (event.key.length === 1 || EDIT_KEYS.has(event.key))
+            ) {
+              setRanges(view, { ranges: [], gesture: false });
+            }
+            return false;
+          },
+          handleDOMEvents: {
+            mousedown: (view, event) => {
+              if (!view.editable || event.button !== 0) {
+                return false;
+              }
+              if (!isModKey(event)) {
+                if (multiSelectionKey.getState(view.state)?.gesture) {
+                  setRanges(view, { gesture: false });
+                }
+                return false;
+              }
+              // The 2nd and 3rd click of a double or triple click go on with
+              // the parts from before the 1st one: what the 1st click picked
+              // is the selection that is being grown.
+              const clicks = Math.min(Math.max(event.detail || 1, 1), 3);
+              const series = clickSeries.get(view);
+              let ranges: SelectedRange[];
+              if (clicks > 1 && series && !deselectSeries.has(view)) {
+                ranges = series;
+              } else {
+                const current = rangeOfSelection(view.state.selection);
+                const extras = getExtraRanges(view.state);
+                ranges = current ? [...extras, current] : extras;
+                clickSeries.set(view, ranges);
+              }
+              setRanges(view, { ranges, gesture: true, held: true });
+              holdUntilRelease(view);
+              // Firefox adds the new drag to the native selection as another
+              // range, which ProseMirror would join with the old one into a
+              // selection over all the text in between. The picked parts are
+              // kept by this plugin, so the native selection is emptied and
+              // the drag starts a selection of its own.
+              const domSelection = (view.root as Document).getSelection?.();
+              if (domSelection && domSelection.rangeCount > 0) {
+                domSelection.removeAllRanges();
+              }
+              const ownerWindow = view.dom.ownerDocument.defaultView ?? window;
+              ownerWindow.addEventListener(
+                "mouseup",
+                () => ownerWindow.setTimeout(() => endGesture(view, clicks), 0),
+                { once: true }
+              );
+              return false;
+            },
+          },
+        },
+      }),
+    ];
+  }
+}
