+++ b/shared/editor/lib/multiSelection.ts
@@ -0,0 +1,525 @@
+// VERSION: 1.1 (2026-10-15) patch 0017-multi-selection
+import type {
+  Attrs,
+  MarkType,
+  Node as ProsemirrorNode,
+  NodeType,
+} from "prosemirror-model";
+import type { Command, Selection, Transaction } from "prosemirror-state";
+import {
+  EditorState,
+  NodeSelection,
+  PluginKey,
+  TextSelection,
+} from "prosemirror-state";
+import { canJoin } from "prosemirror-transform";
+import type { EditorView } from "prosemirror-view";
+import toggleList from "../commands/toggleList";
+
+/** A part of the document picked with Ctrl (Cmd on Mac) held. */
+export type SelectedRange = { from: number; to: number };
+
+/** State of the multi-selection plugin. */
+export type MultiSelectionState = {
+  /** The other picked parts, besides the editor selection, in document order. */
+  ranges: SelectedRange[];
+  /** Whether a Ctrl/Cmd mouse gesture is in progress. */
+  gesture: boolean;
+  /** Whether Ctrl/Cmd is still held after picking with the mouse. */
+  held: boolean;
+};
+
+/** Meta set on a transaction to change the multi-selection state. */
+export type MultiSelectionMeta = Partial<MultiSelectionState>;
+
+export const multiSelectionKey = new PluginKey<MultiSelectionState>(
+  "multiSelection"
+);
+
+/** Toggled marks: applied to, or removed from, every part at once. */
+const MARK_COMMANDS = new Set([
+  "strong",
+  "em",
+  "underline",
+  "strikethrough",
+  "code_inline",
+  "highlight",
+]);
+
+/** Commands on blocks: run once per block range, in document order. */
+const BLOCK_COMMANDS = new Set([
+  "heading",
+  "blockquote",
+  "bullet_list",
+  "checkbox_list",
+  "setTextDirection",
+  "setTextAlignment",
+  "setListStyle",
+]);
+
+/** Commands on text: run once per part. */
+const RANGE_COMMANDS = new Set(["setTextStyle"]);
+
+/** Numbering commands and the number style each one sets. */
+const NUMBER_COMMANDS: Record<string, string | undefined> = {
+  ordered_list: undefined,
+  toggleLowerLetterList: "lower-alpha",
+  toggleUpperLetterList: "upper-alpha",
+};
+
+/**
+ * Whether a command is applied to every picked part.
+ *
+ * @param name the command name.
+ * @returns true when the command works on all parts.
+ */
+export function isMultiCommand(name: string): boolean {
+  return (
+    MARK_COMMANDS.has(name) ||
+    BLOCK_COMMANDS.has(name) ||
+    RANGE_COMMANDS.has(name) ||
+    name in NUMBER_COMMANDS
+  );
+}
+
+/**
+ * Returns the other picked parts of the document, besides the selection.
+ *
+ * @param state the editor state.
+ * @returns the parts, empty when nothing else is picked.
+ */
+export function getExtraRanges(state: EditorState): SelectedRange[] {
+  return multiSelectionKey.getState(state)?.ranges ?? [];
+}
+
+/**
+ * Whether parts are being picked: Ctrl/Cmd is held after a Ctrl/Cmd click.
+ * The formatting toolbar waits until it is released.
+ *
+ * @param state the editor state.
+ * @returns true while picking.
+ */
+export function isPicking(state: EditorState): boolean {
+  return multiSelectionKey.getState(state)?.held ?? false;
+}
+
+/**
+ * Sorts parts, joins the ones that overlap or touch and drops empty ones.
+ *
+ * @param ranges the parts.
+ * @returns the parts in document order.
+ */
+export function normalizeRanges(ranges: SelectedRange[]): SelectedRange[] {
+  const sorted = ranges
+    .filter((r) => r.to > r.from)
+    .map((r) => ({ from: r.from, to: r.to }))
+    .sort((a, b) => a.from - b.from);
+  const result: SelectedRange[] = [];
+  for (const range of sorted) {
+    const last = result[result.length - 1];
+    if (last && range.from <= last.to) {
+      last.to = Math.max(last.to, range.to);
+    } else {
+      result.push(range);
+    }
+  }
+  return result;
+}
+
+/**
+ * Maps parts through the changes of a transaction.
+ *
+ * @param ranges the parts.
+ * @param tr the transaction.
+ * @returns the mapped parts.
+ */
+export function mapRanges(
+  ranges: SelectedRange[],
+  tr: Transaction
+): SelectedRange[] {
+  return normalizeRanges(
+    ranges.map((r) => ({
+      from: tr.mapping.map(r.from, 1),
+      to: tr.mapping.map(r.to, -1),
+    }))
+  );
+}
+
+/**
+ * Returns the part covered by a selection: the text of a text selection, or
+ * the content of a selected text block (Ctrl+click selects the block).
+ *
+ * @param selection the selection.
+ * @returns the part, or null for an empty or other selection.
+ */
+export function rangeOfSelection(selection: Selection): SelectedRange | null {
+  if (selection instanceof TextSelection && !selection.empty) {
+    return { from: selection.from, to: selection.to };
+  }
+  if (selection instanceof NodeSelection && selection.node.isTextblock) {
+    const from = selection.from + 1;
+    const to = selection.to - 1;
+    return to > from ? { from, to } : null;
+  }
+  return null;
+}
+
+/**
+ * Builds a state that has the given part as its selection, to run a command
+ * on that part alone.
+ *
+ * @param doc the document.
+ * @param range the part.
+ * @returns the state.
+ */
+function stateFor(doc: ProsemirrorNode, range: SelectedRange): EditorState {
+  return EditorState.create({
+    doc,
+    selection: TextSelection.between(doc.resolve(range.from), doc.resolve(range.to)),
+  });
+}
+
+/**
+ * Runs a command on a state and adds its steps to a transaction.
+ *
+ * @param tr the transaction that collects the steps.
+ * @param command the command.
+ * @param range the part to select before running the command.
+ * @param view the editor view, passed on to the command.
+ * @returns whether the command changed anything.
+ */
+function runInto(
+  tr: Transaction,
+  command: Command,
+  range: SelectedRange,
+  view?: EditorView
+): boolean {
+  if (range.to < range.from) {
+    return false;
+  }
+  let changed = false;
+  command(
+    stateFor(tr.doc, range),
+    (t) => {
+      t.steps.forEach((step) => {
+        if (!tr.maybeStep(step).failed) {
+          changed = true;
+        }
+      });
+    },
+    view
+  );
+  return changed;
+}
+
+/**
+ * Runs a command on every part, one after the other, in a single transaction.
+ *
+ * @param state the editor state.
+ * @param command the command.
+ * @param ranges the parts, in document order.
+ * @param view the editor view, passed on to the command.
+ * @returns the transaction, or null when nothing changed.
+ */
+export function runOnRanges(
+  state: EditorState,
+  command: Command,
+  ranges: SelectedRange[],
+  view?: EditorView
+): Transaction | null {
+  const tr = state.tr;
+  let changed = false;
+  for (const range of ranges) {
+    const mapped = {
+      from: tr.mapping.map(range.from, 1),
+      to: tr.mapping.map(range.to, -1),
+    };
+    if (runInto(tr, command, mapped, view)) {
+      changed = true;
+    }
+  }
+  return changed ? tr : null;
+}
+
+/**
+ * Keeps one part per block range, so that a toggle is not run twice on the
+ * same block when two parts lie in it.
+ *
+ * @param doc the document.
+ * @param ranges the parts, in document order.
+ * @returns the parts, one per block range.
+ */
+export function dedupeBlocks(
+  doc: ProsemirrorNode,
+  ranges: SelectedRange[]
+): SelectedRange[] {
+  const seen = new Set<string>();
+  return ranges.filter((range) => {
+    const blockRange = doc
+      .resolve(range.from)
+      .blockRange(doc.resolve(range.to));
+    const key = blockRange
+      ? `${blockRange.start}:${blockRange.end}`
+      : `${range.from}:${range.to}`;
+    if (seen.has(key)) {
+      return false;
+    }
+    seen.add(key);
+    return true;
+  });
+}
+
+/**
+ * Whether all text of a part has a mark, with the given attributes if any.
+ *
+ * @param doc the document.
+ * @param range the part.
+ * @param type the mark type.
+ * @param attrs the attributes the mark must have.
+ * @returns true when every text node in the part has the mark.
+ */
+function rangeHasMark(
+  doc: ProsemirrorNode,
+  range: SelectedRange,
+  type: MarkType,
+  attrs?: Attrs | null
+): boolean {
+  let text = false;
+  let all = true;
+  doc.nodesBetween(range.from, range.to, (node, _pos, parent) => {
+    if (!all || !node.isText || !parent?.type.allowsMarkType(type)) {
+      return all;
+    }
+    text = true;
+    const mark = type.isInSet(node.marks);
+    if (
+      !mark ||
+      (attrs &&
+        Object.keys(attrs).some((key) => mark.attrs[key] !== attrs[key]))
+    ) {
+      all = false;
+    }
+    return all;
+  });
+  return text && all;
+}
+
+/**
+ * Toggles a mark on every part: when all parts have it, it is removed from
+ * all, otherwise it is set on all (replacing one with other attributes).
+ *
+ * @param state the editor state.
+ * @param type the mark type.
+ * @param attrs the attributes of the mark, e.g. a highlight color.
+ * @param ranges the parts.
+ * @returns the transaction.
+ */
+export function toggleMarkOnRanges(
+  state: EditorState,
+  type: MarkType,
+  attrs: Attrs | null | undefined,
+  ranges: SelectedRange[]
+): Transaction {
+  const remove = ranges.every((range) =>
+    rangeHasMark(state.doc, range, type, attrs)
+  );
+  const tr = state.tr;
+  for (const { from, to } of ranges) {
+    tr.removeMark(from, to, type);
+    if (!remove) {
+      tr.addMark(from, to, type.create(attrs ?? undefined));
+    }
+  }
+  return tr;
+}
+
+/**
+ * Finds the innermost list of a type around a position.
+ *
+ * @param doc the document.
+ * @param pos the position.
+ * @param type the list type.
+ * @returns the list and its position, or null.
+ */
+function findListAt(
+  doc: ProsemirrorNode,
+  pos: number,
+  type: NodeType
+): { pos: number; node: ProsemirrorNode } | null {
+  const $pos = doc.resolve(pos);
+  for (let depth = $pos.depth; depth > 0; depth--) {
+    const node = $pos.node(depth);
+    if (node.type === type) {
+      return { pos: $pos.before(depth), node };
+    }
+  }
+  return null;
+}
+
+/**
+ * Numbers every part as one continuous list, in document order. A part in a
+ * numbered list keeps that list, and the numbers go on after its last item;
+ * other parts are made numbered lists that start where the previous part
+ * ended (the first one at 1). So with item 3 of a list and two more
+ * paragraphs picked, the paragraphs get 4 and 5. A new list right after one
+ * that ends with the number before it is joined to it. When all parts are
+ * already numbered, the numbering is removed from them.
+ *
+ * @param state the editor state.
+ * @param ranges the parts, in document order.
+ * @param listStyle the number style, e.g. "lower-alpha", or undefined.
+ * @param view the editor view.
+ * @returns the transaction, or null when nothing changed.
+ */
+export function numberRanges(
+  state: EditorState,
+  ranges: SelectedRange[],
+  listStyle?: string,
+  view?: EditorView
+): Transaction | null {
+  const { schema } = state;
+  const listType = schema.nodes.ordered_list;
+  const itemType = schema.nodes.list_item;
+
+  type Unit =
+    | { kind: "list"; pos: number; range: SelectedRange }
+    | { kind: "blocks"; range: SelectedRange };
+  const units: Unit[] = [];
+  const lists = new Set<number>();
+  for (const range of dedupeBlocks(state.doc, ranges)) {
+    const list = findListAt(state.doc, range.from, listType);
+    if (list && range.to <= list.pos + list.node.nodeSize) {
+      if (!lists.has(list.pos)) {
+        lists.add(list.pos);
+        units.push({ kind: "list", pos: list.pos, range });
+      }
+    } else {
+      units.push({ kind: "blocks", range });
+    }
+  }
+
+  if (units.every((unit) => unit.kind === "list")) {
+    return runOnRanges(
+      state,
+      toggleList(listType, itemType, listStyle),
+      ranges,
+      view
+    );
+  }
+
+  const tr = state.tr;
+  let counter: number | null = null;
+  let style: string | null = listStyle ?? null;
+
+  for (const unit of units) {
+    let pos: number;
+    if (unit.kind === "list") {
+      pos = tr.mapping.map(unit.pos, 1);
+    } else {
+      const from = tr.mapping.map(unit.range.from, 1);
+      const to = tr.mapping.map(unit.range.to, -1);
+      runInto(
+        tr,
+        toggleList(listType, itemType, listStyle),
+        { from, to },
+        view
+      );
+      const list = findListAt(tr.doc, tr.mapping.map(unit.range.from, 1), listType);
+      if (!list) {
+        continue;
+      }
+      pos = list.pos;
+    }
+
+    const node = tr.doc.nodeAt(pos);
+    if (!node || node.type !== listType) {
+      continue;
+    }
+    const order: number = counter ?? node.attrs.order;
+    style = style ?? node.attrs.listStyle;
+    if (node.attrs.order !== order || node.attrs.listStyle !== style) {
+      tr.setNodeMarkup(pos, undefined, {
+        ...node.attrs,
+        order,
+        listStyle: style,
+      });
+    }
+    counter = order + node.childCount;
+
+    // A list right after one that ends with the number before it is joined.
+    const before = tr.doc.resolve(pos).nodeBefore;
+    if (
+      before?.type === listType &&
+      before.attrs.listStyle === style &&
+      before.attrs.order + before.childCount === order &&
+      canJoin(tr.doc, pos)
+    ) {
+      tr.join(pos);
+    }
+  }
+
+  return tr.docChanged ? tr : null;
+}
+
+/**
+ * Runs a command on the selection and on every other picked part, as one
+ * change (one undo step). The selection and the parts stay picked.
+ *
+ * @param view the editor view.
+ * @param name the command name.
+ * @param command the command for the selection.
+ * @param attrs the command attributes.
+ * @param main the selection when the command was started.
+ * @param extras the other parts when the command was started.
+ * @returns true when the command was run on the parts.
+ */
+export function runMultiCommand(
+  view: EditorView,
+  name: string,
+  command: Command | undefined,
+  attrs: Attrs | null | undefined,
+  main: Selection,
+  extras: SelectedRange[]
+): boolean {
+  const { state } = view;
+  const mainRange = rangeOfSelection(main);
+  const ranges = normalizeRanges(mainRange ? [...extras, mainRange] : extras);
+  if (!ranges.length) {
+    return false;
+  }
+
+  let tr: Transaction | null = null;
+  const markType = MARK_COMMANDS.has(name) ? state.schema.marks[name] : null;
+  if (markType) {
+    tr = toggleMarkOnRanges(state, markType, attrs, ranges);
+  } else if (name in NUMBER_COMMANDS) {
+    tr = numberRanges(state, ranges, NUMBER_COMMANDS[name], view);
+  } else if (command && BLOCK_COMMANDS.has(name)) {
+    tr = runOnRanges(state, command, dedupeBlocks(state.doc, ranges), view);
+  } else if (command && RANGE_COMMANDS.has(name)) {
+    tr = runOnRanges(state, command, ranges, view);
+  }
+  if (!tr) {
+    return true;
+  }
+
+  const result = tr;
+  const map = (r: SelectedRange) => ({
+    from: result.mapping.map(r.from, 1),
+    to: result.mapping.map(r.to, -1),
+  });
+  if (mainRange) {
+    const { from, to } = map(mainRange);
+    if (to > from) {
+      tr.setSelection(
+        TextSelection.between(tr.doc.resolve(from), tr.doc.resolve(to))
+      );
+    }
+  }
+  tr.setMeta(multiSelectionKey, {
+    ranges: normalizeRanges(extras.map(map)),
+    gesture: false,
+  } satisfies MultiSelectionMeta);
+  view.dispatch(tr);
+  return true;
+}
