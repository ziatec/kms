+function pickedBoxes(view: ReturnType<typeof useEditor>["view"]): Box[] {
+  const boxes: Box[] = [];
+  const editorBox = view.dom.getBoundingClientRect();
+  for (const range of getExtraRanges(view.state)) {
+    try {
+      const start = view.coordsAtPos(range.from);
+      const end = view.coordsAtPos(range.to, -1);
+      const oneLine = Math.abs(start.top - end.top) < 2;
+      boxes.push({
+        left: oneLine ? Math.min(start.left, end.left) : editorBox.left,
+        right: oneLine ? Math.max(start.right, end.right) : editorBox.right,
+        top: Math.min(start.top, end.top),
+        bottom: Math.max(start.bottom, end.bottom),
+      });
+    } catch (_err) {
+      // A part that is not rendered is skipped.
+    }
+  }
+  return boxes;
+}
+
+/**
+ * Whether a box overlaps any of the given boxes.
+ *
+ * @param box the box.
+ * @param boxes the other boxes.
+ * @returns true when they overlap.
+ */
+function overlapsAny(box: Box, boxes: Box[]): boolean {
+  return boxes.some(
+    (other) =>
+      box.left < other.right &&
+      box.right > other.left &&
+      box.top < other.bottom &&
+      box.bottom > other.top
+  );
+}
