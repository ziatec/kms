@@ -0,0 +1,126 @@
+// VERSION: 1.0 (2026-10-15) patch 0017-multi-selection
+import type { Node } from "prosemirror-model";
+import { EditorState } from "prosemirror-state";
+import { doc, p, schema } from "@shared/test/editor";
+import {
+  normalizeRanges,
+  numberRanges,
+  toggleMarkOnRanges,
+} from "./multiSelection";
+
+const { ordered_list, list_item } = schema.nodes;
+
+/** Creates a numbered list with one paragraph per item. */
+function ol(items: string[], order = 1) {
+  return ordered_list.create(
+    { order },
+    items.map((text) => list_item.create(null, p(text)))
+  );
+}
+
+/** Returns the part covering the first text node with the given text. */
+function rangeOf(node: Node, text: string) {
+  let from = -1;
+  node.descendants((child, pos) => {
+    if (from === -1 && child.isText && child.text === text) {
+      from = pos;
+    }
+    return from === -1;
+  });
+  if (from === -1) {
+    throw new Error(`Text "${text}" not found`);
+  }
+  return { from, to: from + text.length };
+}
+
+/** Describes the top-level blocks, e.g. "OL1[a,b] | x". */
+function describe_(node: Node) {
+  const parts: string[] = [];
+  node.forEach((child) => {
+    if (child.type === ordered_list) {
+      const items: string[] = [];
+      child.forEach((item) => items.push(item.textContent));
+      parts.push(`OL${child.attrs.order}[${items.join(",")}]`);
+    } else {
+      parts.push(child.textContent);
+    }
+  });
+  return parts.join(" | ");
+}
+
+describe("normalizeRanges", () => {
+  it("sorts, merges overlapping parts and drops empty ones", () => {
+    expect(
+      normalizeRanges([
+        { from: 10, to: 12 },
+        { from: 1, to: 4 },
+        { from: 3, to: 6 },
+        { from: 8, to: 8 },
+      ])
+    ).toEqual([
+      { from: 1, to: 6 },
+      { from: 10, to: 12 },
+    ]);
+  });
+});
+
+describe("numberRanges", () => {
+  it("continues after a picked numbered item", () => {
+    const testDoc = doc([ol(["one", "two", "three"]), p("A"), p("x"), p("B")]);
+    const state = EditorState.create({ doc: testDoc });
+    const tr = numberRanges(state, [
+      rangeOf(testDoc, "three"),
+      rangeOf(testDoc, "A"),
+      rangeOf(testDoc, "B"),
+    ]);
+    expect(describe_(tr!.doc)).toBe("OL1[one,two,three,A] | x | OL5[B]");
+  });
+
+  it("numbers separate paragraphs as one sequence", () => {
+    const testDoc = doc([p("A"), p("x"), p("B"), p("y"), p("C")]);
+    const state = EditorState.create({ doc: testDoc });
+    const tr = numberRanges(state, [
+      rangeOf(testDoc, "A"),
+      rangeOf(testDoc, "B"),
+      rangeOf(testDoc, "C"),
+    ]);
+    expect(describe_(tr!.doc)).toBe("OL1[A] | x | OL2[B] | y | OL3[C]");
+  });
+
+  it("removes the numbering when all parts are numbered", () => {
+    const testDoc = doc([ol(["A"]), p("x"), ol(["B"], 2)]);
+    const state = EditorState.create({ doc: testDoc });
+    const tr = numberRanges(state, [
+      rangeOf(testDoc, "A"),
+      rangeOf(testDoc, "B"),
+    ]);
+    expect(describe_(tr!.doc)).toBe("A | x | B");
+  });
+});
+
+describe("toggleMarkOnRanges", () => {
+  it("adds a mark to all parts, then removes it from all", () => {
+    const testDoc = doc([p("hello"), p("x"), p("world")]);
+    const ranges = [rangeOf(testDoc, "hello"), rangeOf(testDoc, "world")];
+    const strong = schema.marks.strong;
+
+    const added = toggleMarkOnRanges(
+      EditorState.create({ doc: testDoc }),
+      strong,
+      undefined,
+      ranges
+    ).doc;
+    expect(added.rangeHasMark(ranges[0].from, ranges[0].to, strong)).toBe(true);
+    expect(added.rangeHasMark(ranges[1].from, ranges[1].to, strong)).toBe(true);
+
+    const removed = toggleMarkOnRanges(
+      EditorState.create({ doc: added }),
+      strong,
+      undefined,
+      ranges
+    ).doc;
+    expect(removed.rangeHasMark(ranges[0].from, ranges[1].to, strong)).toBe(
+      false
+    );
+  });
+});
